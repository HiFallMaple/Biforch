      10	@dataclass
      11	class RuleOut:
      12	    id: int
      13	    service_id: int
      14	    action: str
      15	    ip: str
      16	
      17	@dataclass
      18	class RegistrationCallbackRequest:
      19	    """
      20	    Payload for notifying the agent of registration outcome.
      21	    """
      22	    secret: str
      23	    action: str  # "approve" or "reject"
      24	    uuid: Optional[str] = None
      25	    token: Optional[str] = None
      26	
      27	
      28	class ReverseProxyAgentClientError(Exception):
      29	    """Generic exception for ReverseProxyAgentClient errors."""
      30	    pass
      31	
      32	
      33	class ReverseProxyAgentClient:
      34	    """
      35	    Client for calling a Reverse Proxy Agent's REST API, including service rule management
      36	    and registration callback.
      37	    """
      38	    def __init__(
      39	        self,
      40	        base_url: str,
      41	        timeout: int = 10,
      42	    ):
      43	        """
      44	        :param base_url: Base URL of the Reverse Proxy Agent (e.g. http://agent:8002)
      45	        :param timeout: HTTP request timeout in seconds
      46	        """
      47	        self.base_url = base_url.rstrip('/')
      48	        self.timeout = timeout
      49	
      50	    def _build_url(self, path: str) -> str:
      51	        return f"{self.base_url}{path}"
      52	
      53	    def _request(self, method: str, path: str, json: Optional[Dict[str, Any]] = None) -> Any:
      54	        url = self._build_url(path)
      55	        try:
      56	            resp = requests.request(method, url, json=json, timeout=self.timeout)
      57	            resp.raise_for_status()
      58	        except Exception as exc:
      59	            logging.error(
      60	                f"ReverseProxyAgentClient {method} {url} failed: {exc}, response: {getattr(resp, 'text', None)}"
      61	            )
      62	            raise ReverseProxyAgentClientError(
      63	                f"{method} {url} failed: {getattr(resp, 'status_code', '')}"
      64	            )
      65	        if resp.text:
      66	            return resp.json()
      67	        return None
      68	
      69	    # -----------------------------------------------------------------
      70	    # Service rule endpoints
      71	    # -----------------------------------------------------------------
      72	    def create_rule(self, service_id: int, action: str, ip: str) -> RuleOut:
      73	        """Create a new rule for a service."""
      74	        data = self._request(
      75	            'POST',
      76	            f'/rules/{service_id}',
      77	            json={'action': action, 'ip': ip},
      78	        )
      79	        return RuleOut(**data)
      80	
      81	    def replace_rules(self, service_id: int, action: str, ip: str) -> List[RuleOut]:
      82	        """Replace all rules for a service."""
      83	        items = self._request(
      84	            'PUT',
      85	            f'/rules/{service_id}',
      86	            json={'action': action, 'ip': ip},
      87	        )
      88	        return [RuleOut(**i) for i in items]
      89	
      90	    def delete_rules(self, service_id: int) -> Dict[str, int]:
      91	        """Delete all rules for a service."""
      92	        return self._request('DELETE', f'/rules/{service_id}')
      93	
      94	    # -----------------------------------------------------------------
      95	    # Registration callback
      96	    # -----------------------------------------------------------------
      97	    def notify_registration(self, callback: RegistrationCallbackRequest) -> None:
      98	        """
      99	        Notify the agent of an approved or rejected registration by POSTing to /registrations.
     100	        """
     101	        payload: Dict[str, Any] = {
     102	            'secret': callback.secret,
     103	            'action': callback.action,
     104	        }
     105	        if callback.action == 'approve':
     106	            payload['uuid'] = callback.uuid
     107	            payload['token'] = callback.token
     108	
     109	        self._request('POST', '/registrations', json=payload)


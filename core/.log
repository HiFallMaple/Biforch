     391	
     392	
     393	def _enqueue_registration(
     394	    reg_type: PendingType,
     395	    data: BaseModel,
     396	    request: Request,
     397	    db: Session,
     398	) -> tuple[int, str]:
     399	    payload = json.dumps(data.model_dump())
     400	    secret = gen_token()
     401	    pr = PendingRegistrationDB(
     402	        type=reg_type,
     403	        data=payload,
     404	        src_ip=request.client.host or "unknown",
     405	        secret=secret,
     406	    )
     407	    db.add(pr)
     408	    db.commit()
     409	    db.refresh(pr)
     410	    return pr.id, secret

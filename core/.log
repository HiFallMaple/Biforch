      68	
      69	
      70	class ActorRole(Enum):
      71	    ADMIN = auto()
      72	    FIREWALL = auto()
      73	    REVERSE_PROXY = auto()
      74	    SERVICE_DISCOVERY = auto()
      75	
      76	
      77	def get_current_actor(
      78	    allowed_roles: List[ActorRole]
      79	) -> Callable[..., Union[None, FirewallDB, ReverseProxyDB, ServiceDiscoveryDB]]:
      80	    """
      81	    Validates an actor's token against allowed_roles.
      82	    Admin returns None, others return their DB model.
      83	    """
      84	    def dependency(
      85	        creds: HTTPAuthorizationCredentials = Depends(security_scheme),
      86	        db: Session = Depends(get_db),
      87	    ) -> Union[None, FirewallDB, ReverseProxyDB, ServiceDiscoveryDB]:
      88	        token = creds.credentials
      89	        if ActorRole.ADMIN in allowed_roles and token == ADMIN_TOKEN:
      90	            return None
      91	        if ActorRole.FIREWALL in allowed_roles:
      92	            fw = db.query(FirewallDB).filter_by(token=token).first()
      93	            if fw:
      94	                return fw
      95	        if ActorRole.REVERSE_PROXY in allowed_roles:
      96	            rp = db.query(ReverseProxyDB).filter_by(token=token).first()
      97	            if rp:
      98	                return rp
      99	        if ActorRole.SERVICE_DISCOVERY in allowed_roles:
     100	            sd = db.query(ServiceDiscoveryDB).filter_by(token=token).first()
     101	            if sd:
     102	                return sd
     103	        raise HTTPException(401, "Invalid or unauthorized token")
     104	    return dependency

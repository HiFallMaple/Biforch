       1	from typing import Dict
       2	from sqlalchemy.orm import Session
       3	from ..config import settings
       4	from .firewall_agent import FirewallAgentClient
       5	from .reverse_proxy_agent import ReverseProxyAgentClient
       6	from ..models import FirewallDB, ReverseProxyDB
       7	
       8	# module-level caches for singletons
       9	_firewall_clients: Dict[str, FirewallAgentClient] = {}
      10	_reverse_proxy_clients: Dict[str, ReverseProxyAgentClient] = {}
      11	
      12	
      13	def get_firewall_agent_client(db: Session, uuid: str) -> FirewallAgentClient:
      14	    """
      15	    Return a singleton FirewallAgentClient for the given uuid.
      16	    Raises KeyError if no FirewallDB entry exists in provided session.
      17	    """
      18	    if uuid not in _firewall_clients:
      19	        fw = db.query(FirewallDB).filter_by(uuid=uuid).first()
      20	        if not fw:
      21	            raise KeyError(f"No firewall agent found for uuid={uuid}")
      22	        client = FirewallAgentClient(fw.api_url, timeout=settings.TIMEOUT)
      23	        _firewall_clients[uuid] = client
      24	    return _firewall_clients[uuid]
      25	
      26	
      27	def get_reverse_proxy_agent_client(db: Session, uuid: str) -> ReverseProxyAgentClient:
      28	    """
      29	    Return a singleton ReverseProxyAgentClient for the given uuid.
      30	    Raises KeyError if no ReverseProxyDB entry exists in provided session.
      31	    """
      32	    if uuid not in _reverse_proxy_clients:
      33	        rp = db.query(ReverseProxyDB).filter_by(uuid=uuid).first()
      34	        if not rp:
      35	            raise KeyError(f"No reverse proxy agent found for uuid={uuid}")
      36	        client = ReverseProxyAgentClient(rp.api_url, timeout=settings.TIMEOUT)
      37	        _reverse_proxy_clients[uuid] = client
      38	    return _reverse_proxy_clients[uuid]


      41	DATABASE_URL = f"sqlite:///./{DB_PATH}"
      42	engine = create_engine(DATABASE_URL, connect_args={"check_same_thread": False})
      43	SessionLocal = sessionmaker(bind=engine, autocommit=False, autoflush=False)

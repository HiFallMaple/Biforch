      41	def approve_registration(
      42	    req_id: int,
      43	    action: str,
      44	    db: Session,
      45	):
      46	    pr = db.get(PendingRegistrationDB, req_id)
      47	    if not pr:
      48	        raise HTTPException(404, "request not found")
      49	    if action not in ("approve", "reject"):
      50	        raise HTTPException(400, "invalid action")
      51	    entity = None
      52	    status = "rejected"
      53	    if action == "approve":
      54	        # instantiate appropriate approver...
      55	        # create entity, notify callback
      56	        status = "approved"
      57	    # callback logic omitted for brevity
      58	    db.delete(pr)
      59	    db.commit()
      60	    return status


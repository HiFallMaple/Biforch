      58	class FirewallAgentClient:
      59	    """
      60	    Client for calling a Firewall Agent's REST API, including registration callback.
      61	    """
      62	    def __init__(self, base_url: str, timeout: int = 10):
      63	        self.base_url = base_url.rstrip('/')
      64	        self.timeout = timeout
      65	
      66	    def _build_url(self, path: str) -> str:
      67	        return f"{self.base_url}{path}"
      68	
      69	    def _request(self, method: str, path: str, json: Optional[Dict[str, Any]] = None) -> Any:
      70	        url = self._build_url(path)
      71	        try:
      72	            resp = requests.request(method, url, json=json, timeout=self.timeout)
      73	            resp.raise_for_status()
      74	        except Exception as exc:
      75	            logging.error(f"{method} {url} failed: {exc}, response={getattr(resp, 'text', None)}")
      76	            raise FirewallAgentClientError(f"{method} {url} failed")
      77	        return resp.json() if resp.text else None
      78	
      79	    # -----------------------------------------------------------------
      80	    # Reverse Proxy endpoints
      81	    # -----------------------------------------------------------------
      82	    def create_reverse_proxy(
      83	        self, uuid: str, name: str, ip: str, ports: List[int], allowed_ips: List[str]
      84	    ) -> ReverseProxyOut:
      85	        """Register a reverse proxy with the agent."""
      86	        data = self._request(
      87	            'POST',
      88	            '/reverse_proxies',
      89	            json={
      90	                'uuid': uuid,
      91	                'name': name,
      92	                'ip': ip,
      93	                'ports': ports,
      94	                'allowed_ips': allowed_ips,
      95	            },
      96	        )
      97	        return ReverseProxyOut(**data)
      98	
      99	    def list_reverse_proxies(self) -> List[ReverseProxyIn]:
     100	        """List all registered reverse proxies."""
     101	        items = self._request('GET', '/reverse_proxies')
     102	        return [ReverseProxyIn(**i) for i in items]
     103	
     104	    def delete_reverse_proxy(self, uuid: str) -> None:
     105	        """Delete a reverse proxy by UUID."""
     106	        self._request('DELETE', f'/reverse_proxies/{uuid}')
     107	
     108	    # -----------------------------------------------------------------
     109	    # Alias endpoints
     110	    # -----------------------------------------------------------------
     111	    def create_alias(self, service_name: str) -> AliasOut:
     112	        """Create an address alias on the firewall backend."""
     113	        data = self._request(
     114	            'POST',
     115	            '/aliases',
     116	            json={'service_name': service_name},
     117	        )
     118	        return AliasOut(**data)
     119	
     120	    def list_aliases(self) -> List[AliasOut]:
     121	        """List all aliases."""
     122	        items = self._request('GET', '/aliases')
     123	        return [AliasOut(**i) for i in items]
     124	
     125	    def delete_alias(self, alias_id: str) -> None:
     126	        """Delete an alias by ID."""
     127	        self._request('DELETE', f'/aliases/{alias_id}')
     128	
     129	    # -----------------------------------------------------------------
     130	    # Rule endpoints
     131	    # -----------------------------------------------------------------
     132	    def list_rules(self) -> List[RuleOut]:
     133	        """List all synchronized rules."""
     134	        items = self._request('GET', '/rules')
     135	        return [RuleOut(**i) for i in items]
     136	
     137	    # -----------------------------------------------------------------
     138	    # Registration callback
     139	    # -----------------------------------------------------------------
     140	    def notify_registration(self, callback: RegistrationCallbackRequest) -> None:
     141	        """
     142	        Notify the agent of an approved or rejected registration by POSTing to /registrations.
     143	        """
     144	        payload: Dict[str, Any] = {
     145	            'secret': callback.secret,
     146	            'action': callback.action,
     147	        }
     148	        if callback.action == 'approve':
     149	            payload['uuid'] = callback.uuid
     150	            payload['token'] = callback.token
     151	
     152	        self._request('POST', '/registrations', json=payload)


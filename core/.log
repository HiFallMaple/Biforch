     569	# -----------------------------------------------------------------------------
     570	# Service endpoints (Reverse Proxy or Service Discovery)
     571	# -----------------------------------------------------------------------------
     572	@app.post(
     573	    "/service",
     574	    response_model=ServiceOut,
     575	)
     576	def create_service(
     577	    body: ServiceIn,
     578	    caller: Union[ReverseProxyDB, ServiceDiscoveryDB] = Depends(get_current_actor([
     579	        ActorRole.REVERSE_PROXY,
     580	        ActorRole.SERVICE_DISCOVERY,
     581	    ])),
     582	    db: Session = Depends(get_db),
     583	) -> ServiceOut:
     584	    rp = db.query(ReverseProxyDB).filter_by(
     585	        uuid=body.reverse_proxy_uuid).first()
     586	    if not rp:
     587	        raise HTTPException(404, "reverse-proxy not found")
     588	    if db.query(ServiceDB).filter_by(name=body.service).first():
     589	        raise HTTPException(400, "service already exists")
     590	    # authorization check
     591	    if isinstance(caller, ReverseProxyDB) and caller.uuid != body.reverse_proxy_uuid:
     592	        raise HTTPException(403, "token does not match reverse-proxy")
     593	    if isinstance(caller, ServiceDiscoveryDB) and caller.reverse_proxy.uuid != body.reverse_proxy_uuid:
     594	        raise HTTPException(
     595	            403, "token does not match service-discovery's proxy")
     596	    svc = ServiceDB(name=body.service,
     597	                    reverse_proxy_uuid=body.reverse_proxy_uuid)
     598	    db.add(svc)
     599	    db.commit()
     600	    db.refresh(svc)
     601	    firewall = db.query(FirewallDB).first()
     602	    if not firewall:
     603	        db.delete(svc)
     604	        db.commit()
     605	        raise HTTPException(400, "no firewall registered yet")
     606	    try:
     607	        requests.post(
     608	            f"{firewall.api_url.rstrip('/')}/aliases",
     609	            json={"service_name": body.service},
     610	            headers={"Authorization": f"Bearer {rp.token}"},
     611	            timeout=TIMEOUT,
     612	        ).raise_for_status()
     613	    except Exception as exc:
     614	        db.delete(svc)
     615	        db.commit()
     616	        raise HTTPException(
     617	            502, f"failed to register alias on firewall: {exc}")
     618	    return ServiceOut(id=svc.id)
     619	
     620	
     621	@app.delete(
     622	    "/service/{service_id}",
     623	)
     624	def delete_service(
     625	    service_id: int,
     626	    caller: ReverseProxyDB = Depends(
     627	        get_current_actor([ActorRole.REVERSE_PROXY])),
     628	    db: Session = Depends(get_db),
     629	) -> None:
     630	    svc = db.get(ServiceDB, service_id)
     631	    if not svc:
     632	        raise HTTPException(404, "service not found")
     633	    if svc.reverse_proxy_uuid != caller.uuid:
     634	        raise HTTPException(403, "not authorized to delete this service")
     635	    db.delete(svc)
     636	    db.commit()
     637	    try:
     638	        requests.delete(
     639	            f"{caller.api_url.rstrip('/')}/aliases/{svc.name}",
     640	            headers={"Authorization": f"Bearer {caller.token}"},
     641	            timeout=TIMEOUT,
     642	        ).raise_for_status()
     643	    except Exception as exc:
     644	        logging.warning(
     645	            "failed to notify firewall-agent of alias deletion: %s", exc)
     646	
     647	# -----------------------------------------------------------------------------
     648	# Rule endpoints (Firewall only)
     649	# -----------------------------------------------------------------------------
     650	
     651	
     652	@app.post(
     653	    "/rules",
     654	    response_model=RuleOut,
     655	)
     656	def create_rule(
     657	    body: RuleIn,
     658	    firewall: FirewallDB = Depends(get_current_actor([ActorRole.FIREWALL])),
     659	    db: Session = Depends(get_db),
     660	) -> RuleOut:
     661	    svc = db.query(ServiceDB).filter_by(name=body.service).first()
     662	    if not svc:
     663	        raise HTTPException(404, "service not registered")
     664	    rule = RuleDB(
     665	        firewall_rule_uuid=body.firewall_rule_uuid,
     666	        action=body.action,
     667	        ip=body.ip,
     668	        service_id=svc.id,
     669	        firewall_id=firewall.id,
     670	    )
     671	    db.add(rule)
     672	    db.commit()
     673	    db.refresh(rule)
     674	    rp = svc.reverse_proxy
     675	    try:
     676	        requests.post(
     677	            f"{rp.api_url.rstrip('/')}/rules/{svc.id}",
     678	            json={"action": body.action, "ip": body.ip},
     679	            headers={"Authorization": f"Bearer {rp.token}"},
     680	            timeout=TIMEOUT,
     681	        ).raise_for_status()
     682	    except Exception as exc:
     683	        logging.warning("forward to proxy failed: %s", exc)
     684	    return RuleOut(firewall_rule_uuid=body.firewall_rule_uuid)
     685	
     686	
     687	@app.delete(
     688	    "/rules/{firewall_rule_uuid}",
     689	)
     690	def delete_rule(
     691	    firewall_rule_uuid: str,
     692	    firewall: FirewallDB = Depends(get_current_actor([ActorRole.FIREWALL])),
     693	    db: Session = Depends(get_db),
     694	) -> None:
     695	    rule = db.query(RuleDB).filter_by(
     696	        firewall_rule_uuid=firewall_rule_uuid, firewall_id=firewall.id
     697	    ).first()
     698	    if not rule:
     699	        raise HTTPException(404, "rule not found or not yours")
     700	    svc = rule.service
     701	    db.delete(rule)
     702	    db.commit()
     703	    try:
     704	        requests.delete(
     705	            f"{svc.reverse_proxy.api_url.rstrip('/')}/rules/{svc.id}",
     706	            headers={"Authorization": f"Bearer {svc.reverse_proxy.token}"},
     707	            timeout=TIMEOUT,
     708	        ).raise_for_status()
     709	    except Exception as exc:
     710	        logging.warning("forward delete failed: %s", exc)
     711	
     712	
     713	# ----------------------------------------------------------------------------
     714	# Application entrypoint (development)
     715	# ----------------------------------------------------------------------------
     716	if __name__ == "__main__":
     717	    logging.basicConfig(level=logging.INFO)
     718	    import uvicorn
     719	    uvicorn.run("core:app", host="0.0.0.0", port=8001, reload=True)


       1	#!/usr/bin/env python3
       2	# core/cli.py
       3	
       4	"""
       5	Command-line interface for Biforch Reverse Proxy Agent.
       6	Provides commands to enqueue registration with Biforch Core
       7	and to start the API server.
       8	After registration, stores received UUID and token in local database.
       9	"""
      10	import typer
      11	import uvicorn
      12	
      13	from .config import settings
      14	
      15	app = typer.Typer(help="Biforch Reverse Proxy Agent CLI")
      16	
      17	@app.command()
      18	def serve():
      19	    """
      20	    Start the Biforch Reverse Proxy Agent API server
      21	    (which runs background syncs, etc.).
      22	    """
      23	    uvicorn.run(
      24	        f"{__package__}.api:app",
      25	        host=settings.INTERNAL_HOST,
      26	        port=settings.INTERNAL_PORT,
      27	        reload=settings.RELOAD,
      28	    )
      29	
      30	
      31	if __name__ == "__main__":
      32	    app()


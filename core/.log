------------------------------ core/dependencies.py ------------------------------
       1	from fastapi import Depends, HTTPException
       2	from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
       3	from sqlalchemy.orm import Session
       4	from .config import settings
       5	from .database import SessionLocal
       6	from .models import FirewallDB, ReverseProxyDB, ServiceDiscoveryDB
       7	from typing import Callable, Generator, Union, List
       8	from enum import Enum, auto
       9	
      10	security_scheme = HTTPBearer()
      11	
      12	class ActorRole(Enum):
      13	    ADMIN = auto()
      14	    FIREWALL = auto()
      15	    REVERSE_PROXY = auto()
      16	    SERVICE_DISCOVERY = auto()
      17	
      18	
      19	# ---------------------------------------------------------------------------
      20	# Database session dependency
      21	# ---------------------------------------------------------------------------
      22	
      23	
      24	def get_db() -> Generator[Session, None, None]:
      25	    """Yield a *request-scoped* SQLAlchemy session.
      26	
      27	    The explicit ``Generator`` return annotation keeps type-checkers such as
      28	    *pylance* & *mypy* happy, and is what FastAPI expects
      29	    for yield-based dependencies.
      30	    """
      31	    db = SessionLocal()
      32	    try:
      33	        yield db
      34	    finally:
      35	        db.close()
      36	
      37	
      38	def get_current_actor(
      39	    allowed_roles: List[ActorRole]
      40	) -> Callable[..., Union[None, FirewallDB, ReverseProxyDB, ServiceDiscoveryDB]]:
      41	    def dependency(
      42	        creds: HTTPAuthorizationCredentials = Depends(security_scheme),
      43	        db: Session = Depends(get_db),
      44	    ):
      45	        token = str(creds.credentials)
      46	        if ActorRole.ADMIN in allowed_roles and token == settings.ADMIN_TOKEN.get_secret_value():
      47	            return None
      48	        if ActorRole.FIREWALL in allowed_roles:
      49	            fw = db.query(FirewallDB).filter_by(token=token).first()
      50	            if fw:
      51	                return fw
      52	        if ActorRole.REVERSE_PROXY in allowed_roles:
      53	            rp = db.query(ReverseProxyDB).filter_by(token=token).first()
      54	            if rp:
      55	                return rp
      56	        if ActorRole.SERVICE_DISCOVERY in allowed_roles:
      57	            sd = db.query(ServiceDiscoveryDB).filter_by(token=token).first()
      58	            if sd:
      59	                return sd
      60	        raise HTTPException(401, "Invalid or unauthorized token")
      61	    return dependency


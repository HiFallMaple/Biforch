       8	
       9	from pydantic import BaseModel
      10	from sqlalchemy.orm import Session
      11	from fastapi import HTTPException, Request
      12	
      13	
      14	from .config import logging
      15	from .models import (
      16	    PendingRegistrationDB,
      17	    PendingType,
      18	    FirewallDB,
      19	    ReverseProxyDB,
      20	    ServiceDiscoveryDB,
      21	)
      22	from .clients.factory import (
      23	    get_firewall_agent_client,
      24	    get_reverse_proxy_agent_client,
      25	)
      26	from .clients.firewall_agent import (
      27	    RegistrationCallbackRequest as FWCallback,
      28	)
      29	from .clients.reverse_proxy_agent import (
      30	    RegistrationCallbackRequest as RPCallback,
      31	)
      32	
      33	
      34	# ---------------------------------------------------------------------------
      35	# helpers
      36	# ---------------------------------------------------------------------------
      37	
      38	def gen_secret() -> str:
      39	    """Generate a cryptographically‑secure secret string."""
      40	    return secrets.token_hex(16)
      41	
      42	# ---------------------------------------------------------------------------
      43	# Registration spec – maps a PendingType to its handling details
      44	# ---------------------------------------------------------------------------
      45	
      46	class RegistrationSpec(Dict):
      47	    """Lightweight container describing how to handle a registration type."""
      48	
      49	    def __init__(
      50	        self,
      51	        factory: Callable[[dict, str, str], BaseModel],
      52	        client_getter: Callable[[Session, str], object],
      53	        callback_cls: type,
      54	        post_hooks: Optional[List[Callable[[Session, BaseModel], None]]] = None,
      55	    ) -> None:
      56	        self.factory = factory
      57	        self.client_getter = client_getter
      58	        self.callback_cls = callback_cls
      59	        self.post_hooks = post_hooks or []
      60	
      61	# ---------------------------------------------------------------------------
      62	# post‑hooks
      63	# ---------------------------------------------------------------------------
      64	
      65	def _push_reverse_proxy_to_firewalls(db: Session, entity: ReverseProxyDB) -> None:
      66	    """Synchronise a newly approved reverse‑proxy with *all* firewalls.
      67	
      68	    If any firewall fails to accept the registration, the raised exception
      69	    will be caught by the caller and trigger a rollback.
      70	    """
      71	    logging.debug("Registering reverse‑proxy %s with all firewalls", entity.uuid)
      72	    fws: List[FirewallDB] = db.query(FirewallDB).all()
      73	
      74	    for fw in fws:
      75	        logging.debug(" → pushing to firewall uuid=%s api=%s", fw.uuid, fw.api_url)
      76	        client = get_firewall_agent_client(db, fw.uuid)
      77	        try:
      78	            client.create_reverse_proxy(
      79	                uuid=entity.uuid,
      80	                name=entity.name,
      81	                ip=entity.ip,
      82	                ports=list(map(int, entity.ports.split(','))),
      83	                allowed_ips=["0.0.0.0/0"]
      84	            )
      85	            logging.debug("   ✔ pushed successfully")
      86	        except Exception as exc:
      87	            logging.debug("   ✖ push failed: %s", exc, exc_info=True)
      88	            raise  # propagate to outer logic for rollback
      89	
      90	# ---------------------------------------------------------------------------
      91	# spec map
      92	# ---------------------------------------------------------------------------
      93	
      94	_registry_factories = {
      95	    PendingType.FIREWALL: lambda p, u, t: FirewallDB(
      96	        uuid=u, token=t, name=p["name"], api_url=p["api_url"]
      97	    ),
      98	    PendingType.REVERSE_PROXY: lambda p, u, t: ReverseProxyDB(
      99	        uuid=u,
     100	        token=t,
     101	        name=p["name"],
     102	        ip=p["ip"],
     103	        ports=",".join(map(str, p["ports"])),
     104	        api_url=p["api_url"],
     105	    ),
     106	    PendingType.SERVICE_DISCOVERY: lambda p, u, t: ServiceDiscoveryDB(
     107	        uuid=u,
     108	        token=t,
     109	        name=p["name"],
     110	        bind_reverse_proxy_id=p["bind_reverse_proxy_id"],
     111	        api_url=p["api_url"],
     112	    ),
     113	}
     114	
     115	_spec_map: Dict[PendingType, RegistrationSpec] = {
     116	    PendingType.FIREWALL: RegistrationSpec(
     117	        factory=_registry_factories[PendingType.FIREWALL],
     118	        client_getter=get_firewall_agent_client,
     119	        callback_cls=FWCallback,
     120	    ),
     121	    PendingType.REVERSE_PROXY: RegistrationSpec(
     122	        factory=_registry_factories[PendingType.REVERSE_PROXY],
     123	        client_getter=get_reverse_proxy_agent_client,
     124	        callback_cls=RPCallback,
     125	        post_hooks=[_push_reverse_proxy_to_firewalls],
     126	    ),
     127	    PendingType.SERVICE_DISCOVERY: RegistrationSpec(
     128	        factory=_registry_factories[PendingType.SERVICE_DISCOVERY],
     129	        client_getter=get_reverse_proxy_agent_client,
     130	        callback_cls=RPCallback,
     131	    ),
     132	}
     133	
     134	# ---------------------------------------------------------------------------
     135	# Core helper functions
     136	# ---------------------------------------------------------------------------
     137	
     138	def enqueue_registration(
     139	    reg_type: PendingType,
     140	    data: BaseModel,
     141	    request: Request,
     142	    db: Session,
     143	) -> Tuple[int, str]:
     144	    """Insert a new pending registration and return `(id, secret)`."""
     145	    logging.debug("Enqueuing registration type=%s ip=%s", reg_type, request.client.host)
     146	    payload = json.dumps(data.model_dump())
     147	    secret = gen_secret()
     148	
     149	    pr = PendingRegistrationDB(
     150	        type=reg_type,
     151	        data=payload,
     152	        src_ip=request.client.host or "unknown",
     153	        secret=secret,
     154	    )
     155	    db.add(pr)
     156	    db.commit()
     157	    db.refresh(pr)
     158	    logging.debug(" → queued with id=%s secret=%s", pr.id, secret)
     159	    return pr.id, secret
     160	
     161	
     162	def _notify(
     163	    db: Session,
     164	    client_getter: Callable[[Session, str], object],
     165	    callback_cls: type,
     166	    secret: str,
     167	    action: str,
     168	    **kwargs,
     169	) -> None:
     170	    """Send registration callback to the agent via its client."""
     171	    logging.debug("Notifying agent action=%s secret=%s kwargs=%s", action, secret, kwargs)
     172	    client = client_getter(db, kwargs.get("uuid", ""))
     173	    client.notify_registration(callback_cls(secret=secret, action=action, **kwargs))
     174	
     175	
     176	def _approve(pr: PendingRegistrationDB, payload: dict, db: Session) -> Tuple[str, int]:
     177	    """Approve a pending registration and execute related side‑effects."""
     178	    spec = _spec_map[pr.type]
     179	
     180	    # 1. Persist entity
     181	    token = secrets.token_hex(16)
     182	    entity_uuid = str(uuid.uuid4())
     183	    entity = spec.factory(payload, entity_uuid, token)
     184	
     185	    logging.debug("Persisting new entity uuid=%s for type=%s", entity_uuid, pr.type)
     186	    db.add(entity)
     187	    try:
     188	        db.commit()
     189	    except IntegrityError as e:
     190	        logging.debug("DB integrity error: %s", e, exc_info=True)
     191	        db.rollback()
     192	        raise HTTPException(400, f"Entity creation failed: {e.orig}")
     193	    db.refresh(entity)
     194	
     195	    # 2. Notify the requesting agent
     196	    try:
     197	        _notify(
     198	            db,
     199	            spec.client_getter,
     200	            spec.callback_cls,
     201	            secret=pr.secret,
     202	            action="approve",
     203	            uuid=entity.uuid,
     204	            token=entity.token,
     205	        )
     206	    except Exception as exc:
     207	        logging.debug("Callback failed, rolling back entity: %s", exc, exc_info=True)
     208	        db.delete(entity)
     209	        db.commit()
     210	        raise HTTPException(502, f"Callback to agent failed: {exc}")
     211	
     212	    # 3. Execute any post‑hooks (e.g., push RP to all firewalls)
     213	    for hook in spec.post_hooks:
     214	        logging.debug("Running post‑hook %s for entity uuid=%s", hook.__name__, entity.uuid)
     215	        try:
     216	            hook(db, entity)
     217	        except Exception as exc:
     218	            logging.debug("Post‑hook failed, rolling back: %s", exc, exc_info=True)
     219	            db.delete(entity)
     220	            db.commit()
     221	            raise HTTPException(502, f"Post‑hook failed: {exc}")
     222	
     223	    # 4. Clear pending row
     224	    logging.debug("Approval succeeded, deleting pending id=%s", pr.id)
     225	    db.delete(pr)
     226	    db.commit()
     227	    return "approved", entity.id
     228	
     229	
     230	def _reject(pr: PendingRegistrationDB, db: Session) -> Tuple[str, None]:
     231	    """Reject a pending registration and inform the agent."""
     232	    spec = _spec_map[pr.type]
     233	    logging.debug("Rejecting pending id=%s type=%s", pr.id, pr.type)
     234	    try:
     235	        _notify(db, spec.client_getter, spec.callback_cls, secret=pr.secret, action="reject")
     236	    except Exception as exc:
     237	        logging.debug("Reject callback failed: %s", exc, exc_info=True)
     238	        raise HTTPException(502, f"Callback to agent failed: {exc}")
     239	
     240	    db.delete(pr)
     241	    db.commit()
     242	    return "rejected", None
     243	
     244	# ---------------------------------------------------------------------------
     245	# Public API
     246	# ---------------------------------------------------------------------------
     247	
     248	def approve_registration(
     249	    req_id: int,
     250	    action: str,
     251	    db: Session,
     252	) -> Tuple[str, Optional[int]]:
     253	    """Main entry to approve/reject a pending registration."""
     254	    logging.debug("approve_registration called id=%s action=%s", req_id, action)
     255	    pr = db.get(PendingRegistrationDB, req_id)
     256	    if not pr:
     257	        logging.debug("Pending request not found: id=%s", req_id)
     258	        raise HTTPException(404, "request not found")
     259	
     260	    if action not in ("approve", "reject"):
     261	        raise HTTPException(400, "invalid action")
     262	
     263	    payload = json.loads(pr.data) if action == "approve" else None
     264	    if action == "approve":
     265	        return _approve(pr, payload, db)
     266	    return _reject(pr, db)


      52	def gen_token() -> str:
      53	    """Generate a 32-character secure random hex token."""
      54	    return secrets.token_hex(16)
      55	
      56	
      57	def get_db() -> Generator[Session, None, None]:
      58	    """Provide a DB session, closing it after the request."""
      59	    db = SessionLocal()
      60	    try:
      61	        yield db
      62	    finally:
      63	        db.close()

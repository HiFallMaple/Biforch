     158	)
     159	def delete_service(
     160	    service_id: int,
     161	    caller=Depends(get_current_actor([ActorRole.REVERSE_PROXY])),
     162	    db=Depends(get_db),
     163	):
     164	    svc = db.get(ServiceDB, service_id)

      21	def enqueue_registration(
      22	    reg_type: PendingType,
      23	    data: BaseModel,
      24	    request: Request,
      25	    db: Session,
      26	) -> tuple[int, str]:
      27	    payload = json.dumps(data.model_dump())
      28	    secret = gen_secret()
      29	    pr = PendingRegistrationDB(
      30	        type=reg_type,
      31	        data=payload,
      32	        src_ip=request.client.host or "unknown",
      33	        secret=secret,
      34	    )
      35	    db.add(pr)
      36	    db.commit()
      37	    db.refresh(pr)
      38	    return pr.id, secret

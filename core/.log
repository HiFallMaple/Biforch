     100	# ------------------------- Service endpoints -------------------------
     101	
     102	
     103	@app.post("/service", response_model=ServiceOut)
     104	def create_service(
     105	    body: ServiceIn,
     106	    caller=Depends(get_current_actor([ActorRole.REVERSE_PROXY, ActorRole.SERVICE_DISCOVERY])),
     107	    db=Depends(get_db),
     108	) -> ServiceOut:
     109	    # 1) Verify reverse proxy exists
     110	    proxy = db.query(ReverseProxyDB).filter_by(uuid=body.reverse_proxy_uuid).first()
     111	    if not proxy:
     112	        raise HTTPException(status_code=404, detail="Reverse proxy not found")
     113	
     114	    # 2) Authorization
     115	    if hasattr(caller, "uuid") and caller.uuid != body.reverse_proxy_uuid:
     116	        raise HTTPException(status_code=403, detail="Token does not match reverse proxy")
     117	
     118	    # 3) Ensure service name not duplicated
     119	    if db.query(ServiceDB).filter_by(name=body.service).first():
     120	        raise HTTPException(status_code=400, detail="Service already exists")
     121	
     122	    try:
     123	        # 4) Create Service record but DO NOT commit yet
     124	        service = ServiceDB(
     125	            name=body.service,
     126	            reverse_proxy_uuid=body.reverse_proxy_uuid,
     127	        )
     128	        db.add(service)
     129	        db.flush()  # assign service.id within the current transaction
     130	
     131	        # 5) Push to all Firewall Agents
     132	        firewalls = db.query(FirewallDB).all()
     133	        for fw in firewalls:
     134	            client = get_firewall_agent_client(db, fw.uuid)
     135	            client.create_alias(
     136	                service_name=service.name,
     137	            )
     138	            logging.debug(f"Pushed service '{service.name}' to firewall {fw.uuid}")
     139	
     140	        # 6) All pushes succeeded → commit transaction
     141	        db.commit()
     142	
     143	    except Exception as exc:
     144	        # 7) Any failure → rollback entire transaction (including ServiceDB insert)
     145	        db.rollback()
     146	        logging.error(f"Failed to register service on firewall: {exc}", exc_info=True)
     147	        raise HTTPException(
     148	            status_code=502,
     149	            detail=f"Registration to firewall failed: {exc}"
     150	        )
     151	
     152	    # 8) Return newly created Service ID
     153	    return ServiceOut(id=service.id)
     154	

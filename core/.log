     288	# -----------------------------------------------------------------------------
     289	# Approver protocol & implementations (承接原 create_* 邏輯)
     290	# -----------------------------------------------------------------------------
     291	
     292	
     293	class Approver(Protocol):
     294	    model: type[BaseModel]
     295	    def run(self, db: Session, data: BaseModel) -> Union[FirewallDB,
     296	                                                         ReverseProxyDB, ServiceDiscoveryDB]: ...
     297	
     298	
     299	class FirewallApprover:
     300	    model = FirewallIn
     301	
     302	    def run(self, db: Session, data: FirewallIn) -> FirewallDB:
     303	        if db.scalar(select(func.count()).select_from(FirewallDB)):
     304	            raise HTTPException(400, "Firewall already registered")
     305	        fw = FirewallDB(
     306	            uuid=str(uuid.uuid4()),
     307	            token=gen_token(),
     308	            name=data.name,
     309	            api_url=data.api_url,
     310	        )
     311	        db.add(fw)
     312	        db.commit()
     313	        db.refresh(fw)
     314	        return fw
     315	
     316	
     317	class ReverseProxyApprover:
     318	    model = ReverseProxyIn
     319	
     320	    def run(self, db: Session, data: ReverseProxyIn) -> ReverseProxyDB:
     321	        if db.query(ReverseProxyDB).filter_by(name=data.name).first():
     322	            raise HTTPException(400, "duplicate reverse-proxy name")
     323	        firewall = db.query(FirewallDB).first()
     324	        if not firewall:
     325	            raise HTTPException(400, "no firewall registered yet")
     326	        rp = ReverseProxyDB(
     327	            uuid=str(uuid.uuid4()),
     328	            token=gen_token(),
     329	            name=data.name,
     330	            ip=data.ip,
     331	            ports=",".join(map(str, data.ports)),
     332	            api_url=data.api_url,
     333	        )
     334	        # notify firewall-agent
     335	        try:
     336	            requests.post(
     337	                f"{firewall.api_url.rstrip('/')}/reverse_proxies",
     338	                json={
     339	                    "uuid": rp.uuid,
     340	                    "name": rp.name,
     341	                    "ip": rp.ip,
     342	                    "ports": data.ports,
     343	                    "allowed_ips": ["0.0.0.0/0"],
     344	                },
     345	                timeout=TIMEOUT,
     346	            ).raise_for_status()
     347	        except Exception as exc:
     348	            raise HTTPException(
     349	                502, f"Failed to register reverse proxy: {exc}")
     350	        db.add(rp)
     351	        db.commit()
     352	        db.refresh(rp)
     353	        return rp
     354	
     355	
     356	class ServiceDiscoveryApprover:
     357	    model = ServiceDiscoveryIn
     358	
     359	    def run(self, db: Session, data: ServiceDiscoveryIn) -> ServiceDiscoveryDB:
     360	        if db.query(ServiceDiscoveryDB).filter_by(name=data.name).first():
     361	            raise HTTPException(400, "duplicate service-discovery name")
     362	        if not db.get(ReverseProxyDB, data.bind_reverse_proxy_id):
     363	            raise HTTPException(404, "reverse-proxy not found")
     364	        sd = ServiceDiscoveryDB(
     365	            uuid=str(uuid.uuid4()),
     366	            token=gen_token(),
     367	            name=data.name,
     368	            bind_reverse_proxy_id=data.bind_reverse_proxy_id,
     369	            api_url=data.api_url,
     370	        )
     371	        db.add(sd)
     372	        db.commit()
     373	        db.refresh(sd)
     374	        return sd
     375	
     376	
     377	APPROVER_REGISTRY: Dict[PendingType, Approver] = {
     378	    PendingType.FIREWALL: FirewallApprover(),
     379	    PendingType.REVERSE_PROXY: ReverseProxyApprover(),
     380	    PendingType.SERVICE_DISCOVERY: ServiceDiscoveryApprover(),
     381	}

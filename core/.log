      95	
      96	
      97	@app.post(
      98	    "/service", response_model=ServiceOut
      99	)
     100	def create_service(
     101	    body: ServiceIn,
     102	    caller=Depends(get_current_actor([
     103	        ActorRole.REVERSE_PROXY, ActorRole.SERVICE_DISCOVERY
     104	    ])),
     105	    db=Depends(get_db),
     106	) -> ServiceOut:
     107	    # verify reverse-proxy exists
     108	    rp = db.query(ReverseProxyDB).filter_by(
     109	        uuid=body.reverse_proxy_uuid
     110	    ).first()
     111	    if not rp:
     112	        raise HTTPException(404, "reverse-proxy not found")
     113	    # authorization
     114	    if hasattr(caller, 'uuid') and caller.uuid != body.reverse_proxy_uuid:
     115	        raise HTTPException(403, "token does not match reverse-proxy")
     116	    # create service
     117	    if db.query(ServiceDB).filter_by(name=body.service).first():
     118	        raise HTTPException(400, "service already exists")
     119	    svc = ServiceDB(
     120	        name=body.service,
     121	        reverse_proxy_uuid=body.reverse_proxy_uuid,
     122	    )
     123	    db.add(svc)
     124	    db.commit()
     125	    db.refresh(svc)
     126	    return ServiceOut(id=svc.id)
     127	
     128	
     129	@app.delete(
     130	    "/service/{service_id}"
     131	)
     132	def delete_service(
     133	    service_id: int,
     134	    caller=Depends(get_current_actor([ActorRole.REVERSE_PROXY])),
     135	    db=Depends(get_db),
     136	):
     137	    svc = db.get(ServiceDB, service_id)
     138	    if not svc:
     139	        raise HTTPException(404, "service not found")
     140	    if svc.reverse_proxy_uuid != getattr(caller, 'uuid', None):
     141	        raise HTTPException(403, "not authorized to delete this service")
     142	    db.delete(svc)
     143	    db.commit()

     503	# Admin endpoints – list & approve/reject pending
     504	# -----------------------------------------------------------------------------
     505	
     506	
     507	@app.get(
     508	    "/pending_registrations",
     509	    response_model=List[PendingOut],
     510	    dependencies=[Depends(get_current_actor([ActorRole.ADMIN]))],
     511	)
     512	def list_pending(db: Session = Depends(get_db)):
     513	    return db.query(PendingRegistrationDB).order_by(PendingRegistrationDB.created_at).all()
     514	
     515	
     516	
     517	@app.patch(
     518	    "/pending_registrations/{req_id}",
     519	    response_model=PendingApproveOut,
     520	    dependencies=[Depends(get_current_actor([ActorRole.ADMIN]))],
     521	)
     522	def patch_pending_registration(
     523	    req_id: int,
     524	    action: Literal["approve", "reject"] = Body(..., embed=True),
     525	    db: Session = Depends(get_db),
     526	):
     527	    pr = db.get(PendingRegistrationDB, req_id)
     528	    if not pr:
     529	        raise HTTPException(404, "request not found")
     530	
     531	    status: Literal["approved", "rejected"]
     532	    entity = None
     533	
     534	    if action == "reject":
     535	        status = "rejected"
     536	    else:
     537	        approver = APPROVER_REGISTRY[pr.type]
     538	        data_model = approver.model.model_validate_json(pr.data)
     539	        entity = approver.run(db, data_model)
     540	        status = "approved"
     541	
     542	    try:
     543	        callback_url = data_model.api_url.rstrip("/") + "/registrations"
     544	        payload = {
     545	            "secret": pr.secret,
     546	            "action": action,
     547	        }
     548	        # if we approved, include the new entity's uuid (and token)
     549	        if action == "approve" and entity is not None:
     550	            payload["uuid"] = entity.uuid
     551	            payload["token"] = entity.token
     552	        requests.post(
     553	            callback_url,
     554	            json=payload,
     555	            timeout=TIMEOUT,
     556	        ).raise_for_status()
     557	    except Exception as exc:
     558	        logging.warning("Callback to agent failed: %s", exc)
     559	
     560	    db.delete(pr)
     561	    db.commit()
     562	    return PendingApproveOut(
     563	        id=req_id,
     564	        status=status,
     565	        entity_id=(entity.id if entity else None)
     566	    )

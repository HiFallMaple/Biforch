      34	
      35	    # ---------------------- Validators ----------------------
      36	    @field_validator("DB_PATH", mode="before")
      37	    @classmethod
      38	    def _validate_db_path(cls, v: str | Path) -> Path:
      39	        path = Path(v)
      40	        parent = path.parent
      41	        if not parent.exists():
      42	            raise ValueError(f"DB_PATH directory does not exist: {parent}")
      43	        return path
      44	
      45	    @field_validator("TIMEOUT", mode="before")
      46	    @classmethod
      47	    def _validate_timeout(cls, v: int | str) -> int:
      48	        try:
      49	            n = int(v)
      50	        except Exception:
      51	            raise ValueError("TIMEOUT must be an integer")
      52	        if n <= 0:
      53	            raise ValueError("TIMEOUT must be positive")
      54	        return n
      55	
      56	    @field_validator("INTERNAL_HOST", mode="before")
      57	    @classmethod
      58	    def _validate_host(cls, v: str) -> str:
      59	        import ipaddress
      60	        try:
      61	            ipaddress.ip_address(v)
      62	        except ValueError:
      63	            raise ValueError(f"INTERNAL_HOST must be a valid IP address: {v}")
      64	        return v
      65	
      66	    @field_validator("INTERNAL_PORT", mode="before")
      67	    @classmethod
      68	    def _validate_port(cls, v: int | str) -> int:
      69	        try:
      70	            port = int(v)
      71	        except Exception:
      72	            raise ValueError("INTERNAL_PORT must be an integer")
      73	        if not (1 <= port <= 65535):
      74	            raise ValueError("INTERNAL_PORT must be between 1 and 65535")
      75	        return port
      76	
      77	    @field_validator("RELOAD", mode="before")
      78	    @classmethod
      79	    def _validate_reload(cls, v: bool | str) -> bool:
      80	        if isinstance(v, str):
      81	            val = v.lower()
      82	            if val in ("true", "1", "yes"):
      83	                return True
      84	            if val in ("false", "0", "no"):
      85	                return False
      86	            raise ValueError("RELOAD must be a boolean (true/false)")
      87	        return bool(v)
      88	

      13	
      14	@app.command()
      15	def serve():
      16	    """
      17	    Start the Biforch Core API server
      18	    (which runs background syncs, etc.).
      19	    """
      20	    logging.info("🔄 Starting API server …")
      21	    uvicorn.run(
      22	        f"{__package__}.api:app",
      23	        host=settings.INTERNAL_HOST,
      24	        port=settings.INTERNAL_PORT,
      25	        reload=settings.RELOAD,
      26	    )
      27	
      28	
      29	if __name__ == "__main__":
      30	    app()


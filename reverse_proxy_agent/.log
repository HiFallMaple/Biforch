       8	def test_lifespan_discovery_triggers_announce(monkeypatch, tmp_path):
       9	    """Startup lifespan should announce services for existing .conf files."""
      10	    calls = []
      11	    # Patch announce function so we don't actually hit Core
      12	    monkeypatch.setattr(
      13	        'reverse_proxy_agent.api.announce_new_service',
      14	        lambda svc: calls.append(svc)
      15	    )
      16	
      17	    # Prepare a temp CONFIG_DIR with a dummy .conf
      18	    config_dir = tmp_path / 'cfg'
      19	    config_dir.mkdir()
      20	
      21	    # Override the already-loaded settings.CONFIG_DIR to our temp dir
      22	    monkeypatch.setattr(settings, "CONFIG_DIR", config_dir)
      23	
      24	    # Create a test snippet
      25	    (config_dir / 'demo_service.conf').write_text('')
      26	
      27	    # Trigger app startup (invokes lifespan)
      28	    with TestClient(app):
      29	        pass
      30	
      31	    assert 'demo_service' in calls

------------------------------ tests/test_nginx_backend.py ------------------------------
       1	import subprocess
       2	import tempfile
       3	
       4	import pytest
       5	from reverse_proxy_agent.backends.nginx import NginxBackend
       6	
       7	
       8	def test_apply_and_reload_with_sudo(monkeypatch, tmp_path):
       9	    # Prepare a temp config dir
      10	    config_dir = tmp_path / "conf"
      11	    config_dir.mkdir()
      12	    backend = NginxBackend(config_dir)
      13	    rules = {"svc1": ["allow 1.2.3.4;", "deny 5.6.7.8;"]}
      14	
      15	    # Stub subprocess.run to capture sudo command
      16	    calls = {}
      17	    def fake_run(cmd, check=True):
      18	        calls['cmd'] = cmd
      19	        return None
      20	    monkeypatch.setattr(subprocess, "run", fake_run)
      21	
      22	    # Apply rules should write file and call sudo nginx reload
      23	    backend.apply_rules(rules)
      24	
      25	    # Verify conf file content
      26	    conf_file = config_dir / "svc1.conf"
      27	    content = conf_file.read_text()
      28	    assert "allow 1.2.3.4;" in content
      29	    assert "deny 5.6.7.8;" in content
      30	
      31	    # Verify that reload was invoked via sudo
      32	    assert calls['cmd'][0] == 'sudo'
      33	    assert 'nginx' in calls['cmd']
      34	    assert '-s' in calls['cmd'] and 'reload' in calls['cmd']


       5	
       6	def test_full_rule_lifecycle(client, db_session):
       7	    """Black‑box test: create, replace, and delete rules via HTTP endpoints."""
       8	    # Register service
       9	    svc = ServiceDB(id=5, name="my_svc", core_service_id=50)
      10	    db_session.add(svc)
      11	    db_session.commit()
      12	
      13	    # 1) Create a rule
      14	    resp1 = client.post("/rules/5", json={"action": "deny", "ip": "8.8.8.8"})
      15	    assert resp1.status_code == 200
      16	    data1 = resp1.json()
      17	    assert data1["action"] == "deny"
      18	    assert data1["service_id"] == 5
      19	    assert data1["ip"] == "8.8.8.8/32"  # Pydantic normalization
      20	
      21	    # 2) Replace rules
      22	    resp2 = client.put("/rules/5", json={"action": "pass", "ip": "1.2.3.0/24"})
      23	    assert resp2.status_code == 200
      24	    data2 = resp2.json()
      25	    assert isinstance(data2, list) and len(data2) == 1
      26	    assert data2[0]["action"] == "pass"
      27	    assert data2[0]["ip"] == "1.2.3.0/24"
      28	
      29	    # 3) Delete rules
      30	    resp3 = client.delete("/rules/5")
      31	    assert resp3.status_code == 200
      32	    assert resp3.json() == {"deleted": 1}


------------------------------ reverse_proxy_agent/api.py ------------------------------
       1	"""FastAPI entry‑point – **only** routing / HTTP concerns live here."""
       2	from __future__ import annotations
       3	
       4	from contextlib import asynccontextmanager
       5	from pathlib import Path
       6	from typing import List
       7	
       8	from fastapi import Depends, FastAPI, HTTPException
       9	from sqlalchemy.orm import Session
      10	
      11	from .config import settings
      12	from .models import RuleDB, ServiceDB
      13	from .schemas import RuleIn, RuleOut
      14	from .dependencies import get_db
      15	from .services.sync import sync_to_backend, announce_new_service
      16	
      17	# ------------------------------------------------------------------------
      18	# Lifespan – at startup discover *.conf & register missing services
      19	# ------------------------------------------------------------------------
      20	
      21	
      22	@asynccontextmanager
      23	async def lifespan(_: FastAPI):
      24	    Path(settings.CONFIG_DIR).mkdir(parents=True, exist_ok=True)
      25	    db: Session = next(get_db())  
      26	    try:
      27	        for cfg in Path(settings.CONFIG_DIR).glob("*.conf"):
      28	            svc = cfg.stem
      29	            if not db.query(ServiceDB).filter_by(name=svc).first():
      30	                announce_new_service(svc, db)
      31	        db.commit()
      32	    finally:
      33	        db.close()
      34	    yield
      35	
      36	# ------------------------------------------------------------------------
      37	# FastAPI app
      38	# ------------------------------------------------------------------------
      39	
      40	app = FastAPI(title="Reverse‑Proxy Agent", lifespan=lifespan)
      41	
      42	
      43	# ------------------------------- routes ----------------------------------
      44	
      45	@app.post("/rules/{service_id}", response_model=RuleOut)
      46	def create_rule(service_id: int, body: RuleIn, db: Session = Depends(get_db)) -> RuleOut:
      47	    svc = db.get(ServiceDB, service_id)
      48	    if svc is None:
      49	        raise HTTPException(404, "service not registered")
      50	    rule = RuleDB(service_name=svc.name, action=body.action, ip=str(body.ip))
      51	    db.add(rule)
      52	    db.commit()
      53	    db.refresh(rule)
      54	    sync_to_backend(db)
      55	    return RuleOut(id=rule.id, service_id=service_id, action=rule.action, ip=rule.ip)
      56	
      57	
      58	@app.put("/rules/{service_id}", response_model=List[RuleOut])
      59	def replace_rules(service_id: int, body: RuleIn, db: Session = Depends(get_db)) -> List[RuleOut]:
      60	    """Replace all rules for the given service."""
      61	    svc = db.get(ServiceDB, service_id)
      62	    if svc is None:
      63	        raise HTTPException(status_code=404, detail="Service not registered")
      64	
      65	    db.query(RuleDB).filter_by(service_name=svc.name).delete()
      66	    rule = RuleDB(service_name=svc.name, action=body.action, ip=str(body.ip))
      67	    db.add(rule)
      68	    db.commit()
      69	    db.refresh(rule)
      70	
      71	    sync_to_backend(db)
      72	
      73	    return [RuleOut(id=rule.id, service_id=service_id, action=rule.action, ip=rule.ip)]
      74	
      75	
      76	@app.delete("/rules/{service_id}")
      77	def delete_rules(service_id: int, db: Session = Depends(get_db)) -> dict[str, int]:
      78	    """Delete all rules for the given service."""
      79	    svc = db.get(ServiceDB, service_id)
      80	    if svc is None:
      81	        raise HTTPException(status_code=404, detail="Service not found")
      82	
      83	    deleted = db.query(RuleDB).filter_by(service_name=svc.name).delete()
      84	    if deleted == 0:
      85	        raise HTTPException(status_code=404, detail="No rules to delete")
      86	
      87	    db.commit()
      88	    sync_to_backend(db)
      89	    return {"deleted": deleted}


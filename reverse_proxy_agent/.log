------------------------------ reverse_proxy_agent/dependencies.py ------------------------------
       1	"""Reusable FastAPI dependency utilities.
       2	
       3	This module centralises *injection* helpers so that other parts of the
       4	application only need `Depends(get_db)` / `Depends(get_backend)` /
       5	`Depends(get_core_client)`.
       6	"""
       7	from __future__ import annotations
       8	
       9	from typing import Generator
      10	
      11	from fastapi import Depends  # exported for convenience elsewhere
      12	from sqlalchemy.orm import Session
      13	
      14	from .database import SessionLocal
      15	from .backends import backend as _backend
      16	from .backends.base import ProxyBackend
      17	from .clients.core import CoreClient
      18	
      19	# ---------------------------------------------------------------------------
      20	# Database session dependency
      21	# ---------------------------------------------------------------------------
      22	
      23	def get_db() -> Generator[Session, None, None]:
      24	    """Yield a *request-scoped* SQLAlchemy session.
      25	
      26	    The explicit ``Generator`` return annotation keeps type-checkers such as
      27	    *pylance* & *mypy* happy, and is what FastAPI expects
      28	    for yield-based dependencies.
      29	    """
      30	    db = SessionLocal()
      31	    try:
      32	        yield db
      33	    finally:
      34	        db.close()
      35	
      36	
      37	# ---------------------------------------------------------------------------
      38	# Reverse-proxy backend dependency
      39	# ---------------------------------------------------------------------------
      40	
      41	def get_backend() -> ProxyBackend:  # pragma: no cover – trivial wrapper
      42	    """Return the singleton *backend* selected in settings (Nginx, Caddy …)."""
      43	    return _backend
      44	
      45	
      46	# ---------------------------------------------------------------------------
      47	# Core service client dependency
      48	# ---------------------------------------------------------------------------
      49	
      50	def get_core_client() -> CoreClient:  # pragma: no cover
      51	    """Create a *stateless* CoreClient for the requesting context."""
      52	    return CoreClient()


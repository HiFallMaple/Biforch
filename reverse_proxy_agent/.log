       5	
       6	# ---------------------------------------------------------------------
       7	# Data models
       8	# ---------------------------------------------------------------------
       9	@dataclass
      10	class PendingRequest:
      11	    request_id: int
      12	    secret: str
      13	
      14	
      15	@dataclass
      16	class PendingItem:
      17	    id: int
      18	    type: str
      19	    data: str
      20	    src_ip: str
      21	    secret: str
      22	    created_at: str
      23	
      24	
      25	@dataclass
      26	class PendingApprove:
      27	    id: int
      28	    status: str
      29	    entity_id: Optional[int]
      30	
      31	
      32	@dataclass
      33	class Service:
      34	    id: int
      35	
      36	
      37	@dataclass
      38	class Rule:
      39	    firewall_rule_uuid: str
      40	
      41	# ---------------------------------------------------------------------
      42	# Client implementation
      43	# ---------------------------------------------------------------------
      44	
      45	
      46	class CoreClientError(Exception):
      47	    """Generic exception for CoreClient errors."""
      48	    pass
      49	
      50	
      51	class CoreClient:
      52	    def __init__(
      53	        self,
      54	        base_url: str,
      55	        admin_token: Optional[str] = None,
      56	        actor_token: Optional[str] = None,
      57	        timeout: int = 10,
      58	    ):
      59	        """
      60	        :param base_url: URL of Core service (e.g. http://localhost:8001)
      61	        :param admin_token: Bearer token for admin operations
      62	        :param actor_token: Bearer token for actor operations (firewall/proxy/discovery)
      63	        :param timeout: HTTP request timeout in seconds
      64	        """
      65	        self.base_url = base_url.rstrip('/')
      66	        self._admin_token = admin_token
      67	        self._actor_token = actor_token
      68	        self.timeout = timeout
      69	
      70	    def set_actor_token(self, token: str) -> None:
      71	        """Set token for actor (firewall/proxy/discovery) calls."""
      72	        self._actor_token = token
      73	
      74	    def _build_headers(self, admin: bool = False) -> Dict[str, str]:
      75	        headers: Dict[str, str] = {}
      76	        if admin:
      77	            if not self._admin_token:
      78	                raise CoreClientError(
      79	                    "Admin token is required for this operation")
      80	            headers['Authorization'] = f"Bearer {self._admin_token}"
      81	        else:
      82	            if not self._actor_token:
      83	                raise CoreClientError(
      84	                    "Actor token is required for this operation")
      85	            headers['Authorization'] = f"Bearer {self._actor_token}"
      86	        return headers
      87	
      88	    def _request(
      89	        self,
      90	        method: str,
      91	        path: str,
      92	        json: Optional[Dict[str, Any]] = None,
      93	        admin: bool = False,
      94	        auth: bool = True,
      95	    ) -> Any:
      96	        """
      97	        Internal helper to send HTTP requests to Core.
      98	
      99	        :param method: HTTP method
     100	        :param path: API path (prefixed with base_url)
     101	        :param json: JSON body
     102	        :param admin: whether to use admin token
     103	        :param auth: whether to include Authorization header
     104	        """
     105	        url = f"{self.base_url}{path}"
     106	        headers = self._build_headers(admin=admin) if auth else {}
     107	        resp = requests.request(
     108	            method, url, json=json, headers=headers, timeout=self.timeout
     109	        )
     110	        try:
     111	            resp.raise_for_status()
     112	        except Exception as exc:
     113	            logging.error(f"HTTP {method} {url} failed: {exc}, {resp.text}")
     114	            raise CoreClientError(f"{method} {url} failed: {resp.text}")
     115	        if resp.text:
     116	            return resp.json()
     117	        return None
     118	
     119	    # -----------------------------------------------------------------
     120	    # Registration (pending queue) – public endpoints, no auth required
     121	    # -----------------------------------------------------------------
     122	    def register_firewall(self, name: str, api_url: str) -> PendingRequest:
     123	        """Enqueue a firewall registration (returns request_id and secret). No token needed."""
     124	        data = self._request(
     125	            'POST',
     126	            '/firewall',
     127	            json={'name': name, 'api_url': api_url},
     128	            admin=False,
     129	            auth=False,
     130	        )
     131	        return PendingRequest(**data)
     132	
     133	    def register_reverse_proxy(
     134	        self, name: str, ip: str, ports: List[int], api_url: str
     135	    ) -> PendingRequest:
     136	        """Enqueue a reverse-proxy registration. No token needed."""
     137	        data = self._request(
     138	            'POST',
     139	            '/reverse_proxy',
     140	            json={'name': name, 'ip': ip, 'ports': ports, 'api_url': api_url},
     141	            admin=False,
     142	            auth=False,
     143	        )
     144	        return PendingRequest(**data)
     145	
     146	    def register_service_discovery(
     147	        self, name: str, bind_reverse_proxy_id: int, api_url: str
     148	    ) -> PendingRequest:
     149	        """Enqueue a service-discovery registration. No token needed."""
     150	        data = self._request(
     151	            'POST',
     152	            '/service_discovery',
     153	            json={
     154	                'name': name,
     155	                'bind_reverse_proxy_id': bind_reverse_proxy_id,
     156	                'api_url': api_url,
     157	            },
     158	            admin=False,
     159	            auth=False,
     160	        )
     161	        return PendingRequest(**data)
     162	
     163	    # -----------------------------------------------------------------
     164	    # Admin: pending operations
     165	    # -----------------------------------------------------------------
     166	    def list_pending(self) -> List[PendingItem]:
     167	        """List all pending registration requests (admin only)."""
     168	        items = self._request('GET', '/pending_registrations', admin=True)
     169	        return [PendingItem(**i) for i in items]
     170	
     171	    def approve_pending(self, request_id: int) -> PendingApprove:
     172	        """Approve a pending request by ID (admin only)."""
     173	        data = self._request(
     174	            'PATCH',
     175	            f'/pending_registrations/{request_id}',
     176	            json={'action': 'approve'},
     177	            admin=True,
     178	        )
     179	        return PendingApprove(**data)
     180	
     181	    def reject_pending(self, request_id: int) -> PendingApprove:
     182	        """Reject a pending request by ID (admin only)."""
     183	        data = self._request(
     184	            'PATCH',
     185	            f'/pending_registrations/{request_id}',
     186	            json={'action': 'reject'},
     187	            admin=True,
     188	        )
     189	        return PendingApprove(**data)
     190	
     191	    # -----------------------------------------------------------------
     192	    # Admin: delete approved entities
     193	    # -----------------------------------------------------------------
     194	    def delete_firewall(self, fw_id: int) -> None:
     195	        """Delete a registered firewall (admin only)."""
     196	        self._request('DELETE', f'/firewall/{fw_id}', admin=True)
     197	
     198	    def delete_reverse_proxy(self, rp_id: int) -> None:
     199	        """Delete a registered reverse proxy (admin only)."""
     200	        self._request('DELETE', f'/reverse_proxy/{rp_id}', admin=True)
     201	
     202	    def delete_service_discovery(self, sd_id: int) -> None:
     203	        """Delete a registered service discovery (admin only)."""
     204	        self._request('DELETE', f'/service_discovery/{sd_id}', admin=True)
     205	
     206	    # -----------------------------------------------------------------
     207	    # Actor: manage services
     208	    # -----------------------------------------------------------------
     209	    def create_service(self, service: str, reverse_proxy_uuid: str) -> Service:
     210	        """Create a new service (actor token required)."""
     211	        data = self._request(
     212	            'POST',
     213	            '/service',
     214	            json={'service': service, 'reverse_proxy_uuid': reverse_proxy_uuid},
     215	            admin=False,
     216	        )
     217	        return Service(**data)
     218	
     219	    def delete_service(self, service_id: int) -> None:
     220	        """Delete an existing service (actor token required)."""
     221	        self._request('DELETE', f'/service/{service_id}', admin=False)
     222	
     223	    # -----------------------------------------------------------------
     224	    # Actor: manage rules (firewall actor)
     225	    # -----------------------------------------------------------------
     226	    def create_rule(
     227	        self, firewall_rule_uuid: str, action: str, ip: str, service: str
     228	    ) -> Rule:
     229	        """Create a new firewall rule (firewall actor token required)."""
     230	        data = self._request(
     231	            'POST',
     232	            '/rules',
     233	            json={
     234	                'firewall_rule_uuid': firewall_rule_uuid,
     235	                'action': action,
     236	                'ip': ip,
     237	                'service': service,
     238	            },
     239	            admin=False,
     240	        )
     241	        return Rule(**data)
     242	
     243	    def delete_rule(self, firewall_rule_uuid: str) -> None:
     244	        """Delete a firewall rule (firewall actor token required)."""
     245	        self._request('DELETE', f'/rules/{firewall_rule_uuid}', admin=False)

------------------------------ reverse_proxy_agent/cli.py ------------------------------
       1	#!/usr/bin/env python3
       2	# reverse_proxy_agent/cli.py
       3	
       4	"""
       5	Command-line interface for Biforch Reverse Proxy Agent.
       6	Provides commands to enqueue registration with Biforch Core
       7	and to start the API server.
       8	After registration, stores received UUID and token in local database.
       9	"""
      10	import logging
      11	import threading
      12	
      13	import typer
      14	import uvicorn
      15	from fastapi import FastAPI, HTTPException
      16	from pydantic import BaseModel
      17	from typing import Dict, Literal, Optional
      18	
      19	from .config import settings
      20	from .clients.core import CoreClient
      21	from .database import SessionLocal  # This is where the session is created
      22	from .models import AgentCredentials
      23	
      24	app = typer.Typer(help="Biforch Reverse Proxy Agent CLI")
      25	
      26	
      27	class RegistrationCallback(BaseModel):
      28	    """
      29	    Model for Core's callback payload.
      30	    Core will POST {"secret": "...", "action": "approve|reject", "uuid": "...", "token": "..."}.
      31	    """
      32	    secret: str
      33	    action: Literal["approve", "reject"]
      34	    uuid: Optional[str]
      35	    token: Optional[str]
      36	
      37	
      38	@app.command()
      39	def init():
      40	    """
      41	    1) If already registered, report existing credentials and exit.
      42	    2) Launch temporary FastAPI server to receive Core's callback.
      43	    3) Enqueue a reverse proxy registration request to Core (using settings.CORE_URL).
      44	    4) Block until Core calls back, then store credentials & exit.
      45	    """
      46	    db = SessionLocal()  # This is where we manually create the session
      47	    try:
      48	        # Check for existing credentials
      49	        existing = db.query(AgentCredentials).first()
      50	        if existing:
      51	            logging.info(f"🔒 Already registered:")
      52	            logging.info(f"\tUUID: {existing.uuid}")
      53	            logging.info(f"\tToken: {existing.token}")
      54	            return
      55	
      56	        callback_data: Dict[str, str] = {}
      57	        event = threading.Event()
      58	
      59	        # Build temporary FastAPI app for callback
      60	        server_app = FastAPI()
      61	
      62	        @server_app.post(settings.CALLBACK_PATH)
      63	        async def receive_callback(body: RegistrationCallback):
      64	            # Validate secret
      65	            if body.secret != callback_data.get("secret"):
      66	                raise HTTPException(400, "Invalid secret")
      67	            callback_data["action"] = body.action
      68	            # On approval, capture uuid and token
      69	            if body.action == "approve":
      70	                callback_data["uuid"] = body.uuid or ""
      71	                callback_data["token"] = body.token or ""
      72	            # Signal shutdown and notifying main thread
      73	            server.should_exit = True
      74	            event.set()
      75	            return {"status": "received"}
      76	
      77	        # Start Uvicorn server in background
      78	        config = uvicorn.Config(
      79	            server_app,
      80	            host=settings.INTERNAL_HOST,
      81	            port=settings.INTERNAL_PORT,
      82	            log_level="info",
      83	            lifespan="on"
      84	        )
      85	        server = uvicorn.Server(config)
      86	        thread = threading.Thread(target=server.run, daemon=True)
      87	        thread.start()
      88	        logging.info(
      89	            f"🔄 Waiting for Core callback at http://{settings.INTERNAL_HOST}:{settings.INTERNAL_PORT}{settings.CALLBACK_PATH} …"
      90	        )
      91	
      92	        # Enqueue registration with Core
      93	        client = CoreClient(base_url=str(settings.CORE_URL))
      94	        pending = client.register_reverse_proxy(
      95	            name=settings.AGENT_NAME,
      96	            api_url=str(settings.AGENT_URL),
      97	            ip=settings.REVERSE_PROXY_IP,
      98	            ports=settings.REVERSE_PROXY_PORTS,
      99	        )
     100	        callback_data["secret"] = pending.secret
     101	        logging.info(
     102	            f"📨 Sent registration → request_id={pending.request_id}, secret={pending.secret}"
     103	        )
     104	
     105	        # Block until callback arrives
     106	        event.wait()
     107	
     108	        # Shutdown server thread
     109	        thread.join(timeout=1)
     110	
     111	        # Report and store result
     112	        action = callback_data.get("action")
     113	        if action == "approve":
     114	            uuid_str = callback_data.get("uuid", "")
     115	            token_str = callback_data.get("token", "")
     116	            # Persist credentials in DB
     117	            db.add(AgentCredentials(uuid=uuid_str, token=token_str))
     118	            db.commit()
     119	            logging.info(f"✅ Registration approved!")
     120	            logging.info(f"\tUUID: {uuid_str}")
     121	            logging.info(f"\tToken: {token_str}")
     122	        else:
     123	            logging.error("❌ Registration was rejected by Core")
     124	    finally:
     125	        db.close()  # Close the session after usage
     126	
     127	
     128	@app.command()
     129	def serve():
     130	    """
     131	    Start the Biforch Reverse Proxy Agent API server
     132	    (which runs background syncs, etc.).
     133	    """
     134	    uvicorn.run(
     135	        f"{__package__}.api:app",
     136	        host=settings.INTERNAL_HOST,
     137	        port=settings.INTERNAL_PORT,
     138	        reload=settings.RELOAD,
     139	    )
     140	
     141	
     142	if __name__ == "__main__":
     143	    app()


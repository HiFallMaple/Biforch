      22	from .models import AgentCredentials
      23	
      24	app = typer.Typer(help="Biforch Reverse Proxy Agent CLI")
      25	
      26	
      27	class RegistrationCallback(BaseModel):
      28	    """
      29	    Model for Core's callback payload.
      30	    Core will POST {"secret": "...", "action": "approve|reject", "uuid": "...", "token": "..."}
      31	    """
      32	    secret: str
      33	    action: Literal["approve", "reject"]
      34	    uuid: Optional[str]
      35	    token: Optional[str]
      36	
      37	
      38	@app.command()
      39	def init():
      40	    """
      41	    1) If already registered, report existing credentials and exit.
      42	    2) Launch temporary FastAPI server to receive Core's callback.
      43	    3) Enqueue a reverse proxy registration request to Core (using settings.CORE_URL).
      44	    4) Block until Core calls back, then store credentials & exit.
      45	    """
      46	    # Check for existing credentials
      47	    db = SessionLocal()
      48	    existing = db.query(AgentCredentials).first()
      49	    if existing:
      50	        typer.secho(
      51	            f"🔒 Already registered:\n  UUID: {existing.uuid}\n  Token: {existing.token}",
      52	            fg=typer.colors.YELLOW
      53	        )
      54	        db.close()
      55	        return
      56	
      57	    callback_data: Dict[str, str] = {}
      58	    event = threading.Event()
      59	
      60	    # Build temporary FastAPI app for callback
      61	    server_app = FastAPI()
      62	
      63	    @server_app.post(settings.CALLBACK_PATH)
      64	    async def receive_callback(body: RegistrationCallback):
      65	        # Validate secret
      66	        if body.secret != callback_data.get("secret"):
      67	            raise HTTPException(400, "Invalid secret")
      68	        callback_data["action"] = body.action
      69	        # On approval, capture uuid and token
      70	        if body.action == "approve":
      71	            callback_data["uuid"] = body.uuid or ""
      72	            callback_data["token"] = body.token or ""
      73	        # Signal shutdown and notifying main thread
      74	        server.should_exit = True
      75	        event.set()
      76	        return {"status": "received"}
      77	
      78	    # Start Uvicorn server in background
      79	    config = uvicorn.Config(
      80	        server_app,
      81	        host=settings.INTERNAL_HOST,
      82	        port=settings.INTERNAL_PORT,
      83	        log_level="info",
      84	        lifespan="on"
      85	    )
      86	    server = uvicorn.Server(config)
      87	    thread = threading.Thread(target=server.run, daemon=True)
      88	    thread.start()
      89	    typer.echo(
      90	        f"🔄 Waiting for Core callback at http://{settings.INTERNAL_HOST}:{settings.INTERNAL_PORT}{settings.CALLBACK_PATH} …"
      91	    )
      92	
      93	    # Enqueue registration with Core
      94	    client = CoreClient(base_url=str(settings.CORE_URL))
      95	    pending = client.register_reverse_proxy(
      96	        name=settings.AGENT_NAME,
      97	        api_url=str(settings.AGENT_URL),
      98	        ip,
      99	        ports=[80, 443]
     100	    )
     101	    callback_data["secret"] = pending.secret
     102	    typer.echo(
     103	        f"📨 Sent registration → request_id={pending.request_id}, secret={pending.secret}"
     104	    )
     105	
     106	    # Block until callback arrives
     107	    event.wait()
     108	
     109	    # Shutdown server thread
     110	    thread.join(timeout=1)
     111	
     112	    # Report and store result
     113	    action = callback_data.get("action")
     114	    if action == "approve":
     115	        uuid_str = callback_data.get("uuid", "")
     116	        token_str = callback_data.get("token", "")
     117	        # Persist credentials in DB
     118	        db.add(AgentCredentials(uuid=uuid_str, token=token_str))
     119	        db.commit()
     120	        db.close()
     121	        typer.secho(
     122	            f"✅ Registration approved!\n  UUID: {uuid_str}\n  Token: {token_str}",
     123	            fg=typer.colors.GREEN
     124	        )
     125	    else:
     126	        typer.secho("❌ Registration was rejected by Core", fg=typer.colors.RED)
     127	
     128	
     129	@app.command()
     130	def serve():
     131	    """
     132	    Start the Biforch Reverse Proxy Agent API server
     133	    (which runs background syncs, etc.).
     134	    """
     135	    import uvicorn
     136	
     137	    logging.basicConfig(
     138	        level=logging.INFO,
     139	        format="%(levelname)s: %(message)s"
     140	    )
     141	    uvicorn.run(
     142	        f"{__package__}.api:app",
     143	        host=settings.INTERNAL_HOST,
     144	        port=settings.INTERNAL_PORT,
     145	        reload=settings.RELOAD,
     146	    )
     147	
     148	
     149	if __name__ == "__main__":
     150	    app()

------------------------------ reverse_proxy_agent/config.py ------------------------------
       1	# reverse_proxy_agent/config.py
       2	"""
       3	Centralised runtime configuration for Reverse Proxy Agent.
       4	
       5	- Loads settings from environment variables via pydantic-settings
       6	- Validates values on import (fails fast)
       7	- Defines database paths, service URLs, and server behaviour
       8	"""
       9	from __future__ import annotations
      10	
      11	import sys
      12	from pathlib import Path
      13	from typing import Literal, List
      14	
      15	from pydantic import AnyHttpUrl, Field, ValidationError, field_validator
      16	from pydantic_settings import BaseSettings
      17	
      18	
      19	class Settings(BaseSettings):
      20	    """
      21	    Application settings loaded from environment.
      22	
      23	    Attributes:
      24	        DB_PATH: Path to SQLite database file for reverse proxy state
      25	        CONFIG_DIR: Directory where proxy configuration snippets are written
      26	        CORE_URL: URL of Biforch Core service
      27	        AGENT_URL: Callback/API URL of this agent
      28	        REVERSE_PROXY_IP: IP address used by the reverse proxy
      29	        REVERSE_PROXY_PORTS: List of ports exposed by the reverse proxy
      30	
      31	        AGENT_NAME: Logical name of this agent
      32	        CALLBACK_PATH: Endpoint path for Core callbacks
      33	
      34	        PROXY_BACKEND: Proxy engine type (nginx, caddy, traefik, haproxy)
      35	        TIMEOUT: HTTP request timeout (seconds)
      36	
      37	        INTERNAL_HOST: Uvicorn bind host
      38	        INTERNAL_PORT: Uvicorn bind port
      39	        RELOAD: Enable Uvicorn auto-reload in development
      40	    """
      41	    # Data storage
      42	    DB_PATH: Path = Field(..., description="SQLite DB file path")
      43	    CONFIG_DIR: Path = Field(..., description="Directory for proxy config snippets")
      44	
      45	    # External service URLs
      46	    CORE_URL: AnyHttpUrl = Field(..., description="Biforch Core service URL")
      47	    AGENT_URL: AnyHttpUrl = Field(..., description="This agent's callback/API URL")
      48	
      49	    # Reverse proxy network settings
      50	    REVERSE_PROXY_IP: str = Field(..., description="IP address for reverse proxy to bind")
      51	    REVERSE_PROXY_PORTS: List[int] = Field(
      52	        default_factory=list,
      53	        description="Ports exposed by reverse proxy, as a list or comma-separated string"
      54	    )
      55	
      56	    # Identification
      57	    AGENT_NAME: str = Field(..., description="Logical name of the reverse proxy agent")
      58	    CALLBACK_PATH: str = Field(
      59	        "/registrations", description="Endpoint path for Core callback"
      60	    )
      61	
      62	    # Proxy backend selection
      63	    PROXY_BACKEND: Literal["nginx", "caddy", "traefik", "haproxy"] = Field(
      64	        ..., description="Proxy engine type"
      65	    )
      66	
      67	    # Runtime behavior
      68	    TIMEOUT: int = Field(..., description="HTTP request timeout in seconds")
      69	
      70	    # Server settings
      71	    INTERNAL_HOST: str = Field(
      72	        "0.0.0.0", description="Uvicorn bind host"
      73	    )
      74	    INTERNAL_PORT: int = Field(
      75	        8000, description="Uvicorn bind port"
      76	    )
      77	    RELOAD: bool = Field(
      78	        False, description="Enable Uvicorn auto-reload in development"
      79	    )
      80	
      81	    # Pydantic model configuration
      82	    model_config = {
      83	        "extra": "ignore",
      84	        "env_file": ".env",
      85	        "case_sensitive": True,
      86	    }
      87	
      88	    # ---------------------- Validators ----------------------
      89	    @field_validator("DB_PATH", mode="before")
      90	    @classmethod
      91	    def _validate_db_path(cls, v: str | Path) -> Path:
      92	        path = Path(v)
      93	        parent = path.parent
      94	        if not parent.exists():
      95	            raise ValueError(f"DB_PATH directory does not exist: {parent}")
      96	        return path
      97	
      98	    @field_validator("CONFIG_DIR", mode="before")
      99	    @classmethod
     100	    def _validate_config_dir(cls, v: str | Path) -> Path:
     101	        path = Path(v)
     102	        if not path.exists():
     103	            raise ValueError(f"CONFIG_DIR does not exist: {path}")
     104	        if not path.is_dir():
     105	            raise ValueError(f"CONFIG_DIR is not a directory: {path}")
     106	        return path
     107	
     108	    @field_validator("REVERSE_PROXY_IP", mode="before")
     109	    @classmethod
     110	    def _validate_reverse_proxy_ip(cls, v: str) -> str:
     111	        import ipaddress
     112	        try:
     113	            ipaddress.ip_address(v)
     114	        except ValueError:
     115	            raise ValueError(f"REVERSE_PROXY_IP must be a valid IP address: {v}")
     116	        return v
     117	
     118	    @field_validator("REVERSE_PROXY_PORTS", mode="before")
     119	    @classmethod
     120	    def _validate_reverse_proxy_ports(cls, v: List[int] | str) -> List[int]:
     121	        # Accept comma-separated string or list
     122	        ports: List[int] = []
     123	        if isinstance(v, str):
     124	            parts = [p.strip() for p in v.split(",") if p.strip()]
     125	            for p in parts:
     126	                try:
     127	                    num = int(p)
     128	                except ValueError:
     129	                    raise ValueError(f"Invalid port value: {p}")
     130	                ports.append(num)
     131	        else:
     132	            ports = v
     133	        for p in ports:
     134	            if not (1 <= p <= 65535):
     135	                raise ValueError(f"Port must be between 1 and 65535: {p}")
     136	        return ports
     137	
     138	    @field_validator("TIMEOUT", mode="before")
     139	    @classmethod
     140	    def _validate_timeout(cls, v: int | str) -> int:
     141	        try:
     142	            n = int(v)
     143	        except Exception:
     144	            raise ValueError("TIMEOUT must be an integer")
     145	        if n <= 0:
     146	            raise ValueError("TIMEOUT must be positive")
     147	        return n
     148	
     149	    @field_validator("INTERNAL_HOST", mode="before")
     150	    @classmethod
     151	    def _validate_host(cls, v: str) -> str:
     152	        import ipaddress
     153	        try:
     154	            ipaddress.ip_address(v)
     155	        except ValueError:
     156	            raise ValueError(f"INTERNAL_HOST must be a valid IP address: {v}")
     157	        return v
     158	
     159	    @field_validator("INTERNAL_PORT", mode="before")
     160	    @classmethod
     161	    def _validate_port(cls, v: int | str) -> int:
     162	        try:
     163	            port = int(v)
     164	        except Exception:
     165	            raise ValueError("INTERNAL_PORT must be an integer")
     166	        if not (1 <= port <= 65535):
     167	            raise ValueError("INTERNAL_PORT must be between 1 and 65535")
     168	        return port
     169	
     170	    @field_validator("RELOAD", mode="before")
     171	    @classmethod
     172	    def _validate_reload(cls, v: bool | str) -> bool:
     173	        if isinstance(v, str):
     174	            val = v.lower()
     175	            if val in ("true", "1", "yes"):
     176	                return True
     177	            if val in ("false", "0", "no"):
     178	                return False
     179	            raise ValueError("RELOAD must be a boolean (true/false)")
     180	        return bool(v)
     181	
     182	
     183	# Instantiate settings (fails on validation error)
     184	try:
     185	    settings = Settings()
     186	except ValidationError as exc:
     187	    print("🚨 Configuration error:\n", exc, file=sys.stderr)
     188	    sys.exit(1)


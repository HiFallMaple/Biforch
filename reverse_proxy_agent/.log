       1	"""Backend factory + singleton instance."""
       2	from pathlib import Path
       3	
       4	from ..config import settings
       5	from .base import ProxyBackend
       6	from .nginx import NginxBackend
       7	
       8	__all__ = ["get_backend", "backend"]
       9	
      10	
      11	def get_backend() -> ProxyBackend:
      12	    """Create backend according to settings.PROXY_BACKEND."""
      13	    match settings.PROXY_BACKEND:
      14	        case "nginx":
      15	            return NginxBackend(Path(settings.CONFIG_DIR))
      16	        # case "caddy":
      17	        #     from .caddy import CaddyBackend
      18	        #     return CaddyBackend(settings.CADDY_API_URL, settings.CADDY_TOKEN)
      19	        case _:
      20	            raise RuntimeError(
      21	                f"Unknown proxy backend: {settings.PROXY_BACKEND}")
      22	
      23	
      24	# Single backend instance reused across the app
      25	backend: ProxyBackend = get_backend()

------------------------------ reverse_proxy_agent/backends/nginx.py ------------------------------
       1	"""Nginx backend – write per‑service allow/deny snippets then reload."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	import os
       6	import subprocess
       7	from pathlib import Path
       8	from typing import Dict, List
       9	
      10	from .base import ProxyBackend
      11	
      12	class NginxBackend(ProxyBackend):
      13	    def __init__(self, config_dir: Path) -> None:
      14	        self.config_dir = config_dir
      15	
      16	    # ------------------------------------------------------------------ sync
      17	    def apply_rules(self, rules: Dict[str, List[str]]) -> None:
      18	        os.makedirs(self.config_dir, exist_ok=True)
      19	        for svc, lines in rules.items():
      20	            path = self.config_dir / f"{svc}.conf"
      21	            content = "\n".join(lines) + "\n"
      22	            if not path.exists() or path.read_text() != content:
      23	                path.write_text(content)
      24	        self.reload()
      25	
      26	    # ---------------------------------------------------------------- reload
      27	    def reload(self) -> None:  # pragma: no cover – depends on system Nginx
      28	        try:
      29	            subprocess.run(["sudo", "nginx", "-s", "reload"], check=True)
      30	            logging.info("🔄 Nginx reloaded")
      31	        except Exception as exc:  # noqa: BLE001
      32	            logging.error("❌ Failed to reload Nginx: %s", exc)
      33	            raise


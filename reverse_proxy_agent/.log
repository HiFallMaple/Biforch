     220	
     221	    def delete_service(self, service_id: int) -> None:
     222	        """Delete an existing service (actor token required)."""
     223	        self._request('DELETE', f'/service/{service_id}', admin=False)
     224	
     225	    # -----------------------------------------------------------------
     226	    # Actor: manage rules (firewall actor)
     227	    # -----------------------------------------------------------------

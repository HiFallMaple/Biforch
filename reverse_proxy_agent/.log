       1	import pytest
       2	import requests
       3	from reverse_proxy_agent.clients.core import CoreClient
       4	
       5	class DummyResponse:
       6	    def __init__(self, status_code, json_data=None, text=''):
       7	        self.status_code = status_code
       8	        self._json = json_data or {}
       9	        self.text = text
      10	    def raise_for_status(self):
      11	        if self.status_code >= 400:
      12	            raise requests.HTTPError(self.text)
      13	    def json(self):
      14	        return self._json
      15	
      16	@pytest.fixture(autouse=True)
      17	def patch_requests(monkeypatch):
      18	    class FakeSession:
      19	        def post(self, *args, **kwargs):
      20	            return DummyResponse(200, json_data={"id": 123})
      21	        def delete(self, *args, **kwargs):
      22	            return DummyResponse(204)
      23	    monkeypatch.setattr("requests.post", FakeSession().post)
      24	    monkeypatch.setattr("requests.delete", FakeSession().delete)
      25	
      26	def test_create_and_delete_service():
      27	    client = CoreClient()
      28	    resp = client.create_service("svc", "uuid")
      29	    assert resp["id"] == 123
      30	    # delete
      31	    client.delete_service(123)


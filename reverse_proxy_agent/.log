      20	class DummyCoreClient:
      21	    """
      22	    Dummy CoreClient to capture create_service calls without making real HTTP requests.
      23	    """
      24	    def __init__(self):
      25	        self.calls = []
      26	
      27	    def create_service(self, service: str, reverse_proxy_uuid: str):
      28	        """
      29	        Record the call arguments and return a fixed id.
      30	        """
      31	        self.calls.append((service, reverse_proxy_uuid))
      32	        return {"id": 42}
      33	
      34	def test_announce_new_service_registers_and_saves(monkeypatch):
      35	    """
      36	    announce_new_service on first call should invoke CoreClient.create_service
      37	    and insert a new ServiceDB record with the returned id.
      38	    """
      39	    dummy_client = DummyCoreClient()
      40	    # Patch get_core_client in the sync module to return our dummy_client
      41	    monkeypatch.setattr(
      42	        'reverse_proxy_agent.services.sync.get_core_client',
      43	        lambda: dummy_client
      44	    )
      45	
      46	    # Call the function under test
      47	    announce_new_service('foo_service')
      48	
      49	    # 1) CoreClient.create_service should have been called once
      50	    assert dummy_client.calls == [
      51	        ('foo_service', str(settings.BIFORCH_UUID))
      52	    ]
      53	
      54	    # 2) A new ServiceDB entry should exist in the local database
      55	    db: Session = next(get_db())
      56	    service_entry = db.query(ServiceDB).filter_by(name='foo_service').one_or_none()
      57	    assert service_entry is not None
      58	    assert service_entry.id == 42
      59	    assert service_entry.core_service_id == 42
      60	    db.close()
      61	
      62	def test_announce_new_service_does_nothing_if_already_registered(monkeypatch):
      63	    """
      64	    If a ServiceDB entry with the same name already exists,
      65	    announce_new_service should not call CoreClient.create_service again.
      66	    """
      67	    # Pre-insert a ServiceDB record with name 'bar_service'
      68	    db: Session = next(get_db())
      69	    db.add(ServiceDB(id=99, name='bar_service', core_service_id=99))
      70	    db.commit()
      71	    db.close()
      72	
      73	    dummy_client = DummyCoreClient()
      74	    monkeypatch.setattr(
      75	        'reverse_proxy_agent.services.sync.get_core_client',
      76	        lambda: dummy_client
      77	    )
      78	
      79	    # Call announce_new_service again with the same service name
      80	    announce_new_service('bar_service')
      81	
      82	    # Since the service was already registered, create_service should not be called
      83	    assert dummy_client.calls == []


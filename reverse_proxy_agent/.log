      10	
      11	def get_backend() -> ProxyBackend:
      12	    """Create backend according to settings.PROXY_BACKEND."""
      13	    match settings.PROXY_BACKEND:
      14	        case "nginx":
      15	            return NginxBackend(Path(settings.CONFIG_DIR))
      16	        # case "caddy":
      17	        #     from .caddy import CaddyBackend
      18	        #     return CaddyBackend(settings.CADDY_API_URL, settings.CADDY_TOKEN)
      19	        case _:
      20	            raise RuntimeError(
      21	                f"Unknown proxy backend: {settings.PROXY_BACKEND}")
      22	
      23	
      24	# Single backend instance reused across the app
      25	backend: ProxyBackend = get_backend()

------------------------------ reverse_proxy_agent/backends/nginx.py ------------------------------
       1	"""Nginx backend – write per‑service allow/deny snippets then reload."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	import os
       6	import subprocess
       7	from pathlib import Path
       8	from typing import Dict, List
       9	
      10	from .base import ProxyBackend
      11	
      12	
      13	class NginxBackend(ProxyBackend):
      14	    def __init__(self, config_dir: Path) -> None:
      15	        self.config_dir = config_dir
      16	
      17	    # ------------------------------------------------------------------ sync
      18	    def apply_rules(self, rules: Dict[str, List[str]]) -> None:
      19	        os.makedirs(self.config_dir, exist_ok=True)
      20	        for svc, lines in rules.items():
      21	            path = self.config_dir / f"{svc}.conf"
      22	            content = "\n".join(lines) + "\n"
      23	            if not path.exists() or path.read_text() != content:
      24	                path.write_text(content)
      25	        self.reload()
      26	
      27	    # ---------------------------------------------------------------- reload
      28	    def reload(self) -> None:  # pragma: no cover – depends on system Nginx
      29	        try:
      30	            subprocess.run(["sudo", "nginx", "-s", "reload"], check=True)
      31	            logging.info("🔄 Nginx reloaded")
      32	        except Exception as exc:  # noqa: BLE001
      33	            logging.error("❌ Failed to reload Nginx: %s", exc)
      34	            raise


------------------------------ reverse_proxy_agent/dependencies.py ------------------------------
       1	"""Reusable FastAPI dependency utilities.
       2	
       3	This module centralises *injection* helpers so that other parts of the
       4	application only need `Depends(get_db)` / `Depends(get_backend)` /
       5	`Depends(get_core_client)`.
       6	"""
       7	from __future__ import annotations
       8	
       9	from typing import Generator
      10	
      11	from sqlalchemy.orm import Session
      12	
      13	from .database import SessionLocal
      14	from .backends import backend as _backend
      15	from .backends.base import ProxyBackend
      16	from .clients.core import CoreClient
      17	from .config import settings
      18	from .models import AgentCredentials
      19	
      20	# ---------------------------------------------------------------------------
      21	# Database session dependency
      22	# ---------------------------------------------------------------------------
      23	
      24	
      25	def get_db() -> Generator[Session, None, None]:
      26	    """Yield a *request-scoped* SQLAlchemy session.
      27	
      28	    The explicit ``Generator`` return annotation keeps type-checkers such as
      29	    *pylance* & *mypy* happy, and is what FastAPI expects
      30	    for yield-based dependencies.
      31	    """
      32	    db = SessionLocal()
      33	    try:
      34	        yield db
      35	    finally:
      36	        db.close()
      37	
      38	
      39	# ---------------------------------------------------------------------------
      40	# Reverse-proxy backend dependency
      41	# ---------------------------------------------------------------------------
      42	
      43	def get_backend() -> ProxyBackend:  # pragma: no cover – trivial wrapper
      44	    """Return the singleton *backend* selected in settings (Nginx, Caddy …)."""
      45	    return _backend
      46	
      47	
      48	# ---------------------------------------------------------------------------
      49	# Core service client dependency
      50	# ---------------------------------------------------------------------------
      51	
      52	def get_core_client(db: Session) -> CoreClient:
      53	    """
      54	    Create a CoreClient using the stored actor token from the database.
      55	    Raises HTTPException if no token is available.
      56	    """
      57	    from fastapi import HTTPException
      58	
      59	    # Retrieve the agent's credentials from the local database
      60	    cred = db.query(AgentCredentials).first()
      61	    token = cred.token if cred else None
      62	
      63	    if not token:
      64	        raise HTTPException(
      65	            status_code=500, detail="Missing actor token: please register the agent first.")
      66	
      67	    # Initialize CoreClient with actor_token
      68	    return CoreClient(str(settings.CORE_URL), actor_token=token)


------------------------------ reverse_proxy_agent/services/sync.py ------------------------------
       1	"""Business logic – sync DB rules 👉 backend snippets & Core registration."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	from typing import Dict, List
       6	
       7	from sqlalchemy.orm import Session
       8	
       9	from ..models import RuleDB, ServiceDB
      10	from ..backends import backend
      11	from ..dependencies import get_db, get_core_client
      12	
      13	
      14	# ------------------------- helper: collect rules --------------------------
      15	
      16	def _collect_rules(db: Session) -> Dict[str, List[str]]:
      17	    grouped: Dict[str, List[str]] = {}
      18	    rows = db.query(RuleDB).all()
      19	    for r in rows:
      20	        action = "allow" if r.action == "pass" else "deny"
      21	        grouped.setdefault(r.service_name, []).append(f"{action} {r.ip};")
      22	    return grouped
      23	
      24	
      25	# ------------------------------- public API -------------------------------
      26	
      27	def sync_to_backend() -> None:
      28	    """Full sync: write Nginx snippets then reload."""
      29	    db: Session = next(get_db())  # type: ignore[arg-type]
      30	    try:
      31	        backend.apply_rules(_collect_rules(db))
      32	    finally:
      33	        db.close()
      34	
      35	
      36	def announce_new_service(svc_name: str) -> None:
      37	    """Let Core know we host a previously unseen *.conf service."""
      38	    from ..config import settings
      39	    db: Session = next(get_db())  # type: ignore[arg-type]
      40	    core = get_core_client()
      41	    try:
      42	        svc = db.query(ServiceDB).filter_by(name=svc_name).first()
      43	        if svc:
      44	            return  # already known
      45	        resp = core.create_service(svc_name, reverse_proxy_uuid=str(settings.BIFORCH_UUID))
      46	        db.add(ServiceDB(id=resp["id"], name=svc_name, core_service_id=resp["id"]))
      47	        db.commit()
      48	        logging.info("📣 Registered service '%s' with Core (id=%s)", svc_name, resp["id"])
      49	    except Exception as exc:  # noqa: BLE001
      50	        logging.warning("Failed to register service %s: %s", svc_name, exc)
      51	    finally:
      52	        db.close()

------------------------------ reverse_proxy_agent/utils.py ------------------------------
       1	"""Shared helpers – rule sync & Core registration."""
       2	from __future__ import annotations
       3	import logging
       4	from typing import Dict, List
       5	
       6	import requests
       7	from sqlalchemy.orm import Session
       8	
       9	from .config import settings
      10	from .database import SessionLocal
      11	from .models import RuleDB
      12	from .backends import backend  # singleton backend instance
      13	
      14	# ------------------------------------------------------------------ rules --
      15	def _collect_rules() -> Dict[str, List[str]]:
      16	    """Pull all rules from DB and group by service."""
      17	    db: Session = SessionLocal()
      18	    try:
      19	        rows = db.query(RuleDB).all()
      20	    finally:
      21	        db.close()
      22	
      23	    grouped: Dict[str, List[str]] = {}
      24	    for r in rows:
      25	        # Core 的 action 用 pass/deny，但 Nginx 需要 allow/deny
      26	        nginx_action = "allow" if r.action == "pass" else "deny"
      27	        grouped.setdefault(r.service_name, []).append(f"{nginx_action} {r.ip};")
      28	    return grouped
      29	
      30	def sync_all_rules() -> None:
      31	    """Full synchronisation of the whole rule set."""
      32	    backend.apply_rules(_collect_rules())


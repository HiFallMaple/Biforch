       1	# reverse_proxy_agent/config.py
       2	"""
       3	Centralised runtime configuration for Reverse Proxy Agent.
       4	
       5	- Loads settings from environment variables via pydantic-settings
       6	- Validates values on import (fails fast)
       7	- Defines database paths, service URLs, and server behaviour
       8	"""
       9	from __future__ import annotations
      10	
      11	import logging
      12	import logging.config
      13	import sys
      14	from pathlib import Path
      15	from typing import Literal, List
      16	
      17	from pydantic import AnyHttpUrl, Field, ValidationError, field_validator
      18	from pydantic_settings import BaseSettings
      19	
      20	
      21	class Settings(BaseSettings):
      22	    """
      23	    Application settings loaded from environment.
      24	
      25	    Attributes:
      26	        DB_PATH: Path to SQLite database file for reverse proxy state
      27	        CONFIG_DIR: Directory where proxy configuration snippets are written
      28	        CORE_URL: URL of Biforch Core service
      29	        AGENT_URL: Callback/API URL of this agent
      30	        REVERSE_PROXY_IP: IP address used by the reverse proxy
      31	        REVERSE_PROXY_PORTS: List of ports exposed by the reverse proxy
      32	
      33	        AGENT_NAME: Logical name of this agent
      34	        CALLBACK_PATH: Endpoint path for Core callbacks
      35	
      36	        PROXY_BACKEND: Proxy engine type (nginx, caddy, traefik, haproxy)
      37	        TIMEOUT: HTTP request timeout (seconds)
      38	
      39	        INTERNAL_HOST: Uvicorn bind host
      40	        INTERNAL_PORT: Uvicorn bind port
      41	        RELOAD: Enable Uvicorn auto-reload in development
      42	    """
      43	    # default put db in data dir
      44	    DB_PATH: Path = Field(
      45	        "./data/db.sqlite",
      46	        description="Path to SQLite database file",
      47	    )
      48	    CONFIG_DIR: Path = Field(...,
      49	                             description="Directory for proxy config snippets")
      50	
      51	    # External service URLs
      52	    CORE_URL: AnyHttpUrl = Field(..., description="Biforch Core service URL")
      53	    AGENT_URL: AnyHttpUrl = Field(...,
      54	                                  description="This agent's callback/API URL")
      55	
      56	    # Reverse proxy network settings
      57	    REVERSE_PROXY_IP: str = Field(...,
      58	                                  description="IP address for reverse proxy to bind")
      59	    REVERSE_PROXY_PORTS: List[int] = Field(
      60	        default_factory=list,
      61	        description="Ports exposed by reverse proxy, as a list or comma-separated string"
      62	    )
      63	
      64	    # Identification
      65	    AGENT_NAME: str = Field(...,
      66	                            description="Logical name of the reverse proxy agent")
      67	    CALLBACK_PATH: str = Field(
      68	        "/registrations", description="Endpoint path for Core callback"
      69	    )
      70	
      71	    # Proxy backend selection
      72	    PROXY_BACKEND: Literal["nginx", "caddy", "traefik", "haproxy"] = Field(
      73	        ..., description="Proxy engine type"
      74	    )
      75	
      76	    # Runtime behavior
      77	    TIMEOUT: int = Field(..., description="HTTP request timeout in seconds")
      78	
      79	    # Server settings
      80	    INTERNAL_HOST: str = Field(
      81	        "0.0.0.0", description="Uvicorn bind host"
      82	    )
      83	    INTERNAL_PORT: int = Field(
      84	        8000, description="Uvicorn bind port"
      85	    )
      86	    RELOAD: bool = Field(
      87	        False, description="Enable Uvicorn auto-reload in development"
      88	    )
      89	
      90	    # Logging
      91	    LOG_FILE_PATH: Path = Field("./data/.log", description="Path to log file")
      92	
      93	    # Pydantic model configuration
      94	    model_config = {
      95	        "extra": "ignore",
      96	        "env_file": ".env",
      97	        "case_sensitive": True,
      98	    }
      99	
     100	    # ---------------------- Validators ----------------------
     101	    @field_validator("DB_PATH", mode="before")
     102	    @classmethod
     103	    def _validate_db_path(cls, v: str | Path) -> Path:
     104	        path = Path(v)
     105	        parent = path.parent
     106	        if not parent.exists():
     107	            raise ValueError(f"DB_PATH directory does not exist: {parent}")
     108	        return path
     109	
     110	    @field_validator("CONFIG_DIR", mode="before")
     111	    @classmethod
     112	    def _validate_config_dir(cls, v: str | Path) -> Path:
     113	        path = Path(v)
     114	        if not path.exists():
     115	            raise ValueError(f"CONFIG_DIR does not exist: {path}")
     116	        if not path.is_dir():
     117	            raise ValueError(f"CONFIG_DIR is not a directory: {path}")
     118	        return path
     119	
     120	    @field_validator("REVERSE_PROXY_IP", mode="before")
     121	    @classmethod
     122	    def _validate_reverse_proxy_ip(cls, v: str) -> str:
     123	        import ipaddress
     124	        try:
     125	            ipaddress.ip_address(v)
     126	        except ValueError:
     127	            raise ValueError(
     128	                f"REVERSE_PROXY_IP must be a valid IP address: {v}")
     129	        return v
     130	
     131	    @field_validator("REVERSE_PROXY_PORTS", mode="before")
     132	    @classmethod
     133	    def _validate_reverse_proxy_ports(cls, v: List[int] | str) -> List[int]:
     134	        # Accept comma-separated string or list
     135	        ports: List[int] = []
     136	        if isinstance(v, str):
     137	            parts = [p.strip() for p in v.split(",") if p.strip()]
     138	            for p in parts:
     139	                try:
     140	                    num = int(p)
     141	                except ValueError:
     142	                    raise ValueError(f"Invalid port value: {p}")
     143	                ports.append(num)
     144	        else:
     145	            ports = v
     146	        for p in ports:
     147	            if not (1 <= p <= 65535):
     148	                raise ValueError(f"Port must be between 1 and 65535: {p}")
     149	        return ports
     150	
     151	    @field_validator("TIMEOUT", mode="before")
     152	    @classmethod
     153	    def _validate_timeout(cls, v: int | str) -> int:
     154	        try:
     155	            n = int(v)
     156	        except Exception:
     157	            raise ValueError("TIMEOUT must be an integer")
     158	        if n <= 0:
     159	            raise ValueError("TIMEOUT must be positive")
     160	        return n
     161	
     162	    @field_validator("INTERNAL_HOST", mode="before")
     163	    @classmethod
     164	    def _validate_host(cls, v: str) -> str:
     165	        import ipaddress
     166	        try:
     167	            ipaddress.ip_address(v)
     168	        except ValueError:
     169	            raise ValueError(f"INTERNAL_HOST must be a valid IP address: {v}")
     170	        return v
     171	
     172	    @field_validator("INTERNAL_PORT", mode="before")
     173	    @classmethod
     174	    def _validate_port(cls, v: int | str) -> int:
     175	        try:
     176	            port = int(v)
     177	        except Exception:
     178	            raise ValueError("INTERNAL_PORT must be an integer")
     179	        if not (1 <= port <= 65535):
     180	            raise ValueError("INTERNAL_PORT must be between 1 and 65535")
     181	        return port
     182	
     183	    @field_validator("RELOAD", mode="before")
     184	    @classmethod
     185	    def _validate_reload(cls, v: bool | str) -> bool:
     186	        if isinstance(v, str):
     187	            val = v.lower()
     188	            if val in ("true", "1", "yes"):
     189	                return True
     190	            if val in ("false", "0", "no"):
     191	                return False
     192	            raise ValueError("RELOAD must be a boolean (true/false)")
     193	        return bool(v)
     194	
     195	
     196	LOGGING_CONFIG: dict = {
     197	    "version": 1,
     198	    "disable_existing_loggers": False,
     199	
     200	    "formatters": {
     201	        "standard": {
     202	            "format": "%(asctime)s,%(msecs)03d [%(levelname)s] %(filename)s: %(message)s",
     203	            "datefmt": "%Y-%m-%d %H:%M:%S",
     204	        },
     205	        "colored": {
     206	            "()": "uvicorn.logging.DefaultFormatter",
     207	            "fmt": "%(levelprefix)s [%(filename)s:%(lineno)d] [%(asctime)s] %(message)s",
     208	            "datefmt": "%H:%M:%S",
     209	            "use_colors": True,
     210	        },
     211	    },
     212	
     213	    "handlers": {
     214	        "file": {
     215	            "class": "logging.FileHandler",
     216	            "level": "INFO",
     217	            "formatter": "standard",
     218	            "filename": ".log",
     219	            "mode": "a",
     220	        },
     221	        "console": {
     222	            "class": "logging.StreamHandler",
     223	            "level": "DEBUG",
     224	            "formatter": "colored",
     225	            "stream": "ext://sys.stdout",
     226	        },
     227	    },
     228	
     229	    "loggers": {
     230	        "": {
     231	            "handlers": ["console", "file"],
     232	            "level": "INFO",
     233	            "propagate": False,
     234	        },
     235	    },
     236	}
     237	
     238	
     239	# Instantiate settings (fails on validation error)
     240	try:
     241	    settings = Settings()
     242	    LOGGING_CONFIG["handlers"]["file"]["filename"] = settings.LOG_FILE_PATH
     243	    logging.config.dictConfig(LOGGING_CONFIG)
     244	    logging.info("Settings loaded successfully")
     245	except ValidationError as exc:
     246	    logging.error("🚨 Configuration error:\n", exc, file=sys.stderr)
     247	    sys.exit(1)
     248	
     249	
     250	if __name__ == "__main__":
     251	    settings_json = settings.model_dump_json(indent=2)
     252	    logging.info(f"{settings_json}")


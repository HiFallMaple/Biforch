------------------------------ reverse_proxy_agent/services/sync.py ------------------------------
       1	from __future__ import annotations
       2	
       3	import logging
       4	from typing import Dict, List
       5	
       6	from sqlalchemy.orm import Session
       7	
       8	from ..clients import core
       9	from ..models import AgentCredentials, RuleDB, ServiceDB
      10	from ..backends import backend
      11	from ..dependencies import get_core_client
      12	
      13	
      14	# ------------------------- helper: collect rules --------------------------
      15	
      16	def _collect_rules(db: Session) -> Dict[str, List[str]]:
      17	    """
      18	    Collects rules from the database and groups them by service name.
      19	
      20	    Args:
      21	        db (Session): The SQLAlchemy session.
      22	
      23	    Returns:
      24	        Dict[str, List[str]]: A dictionary where the key is the service name
      25	                              and the value is a list of rule strings.
      26	    """
      27	    grouped: Dict[str, List[str]] = {}
      28	    rows: List[RuleDB] = db.query(RuleDB).all()
      29	    for r in rows:
      30	        action: str = "allow" if r.action == "pass" else "deny"
      31	        grouped.setdefault(r.service_name, []).append(f"{action} {r.ip};")
      32	    return grouped
      33	
      34	
      35	# ------------------------------- public API -------------------------------
      36	
      37	def sync_to_backend(db: Session) -> None:
      38	    """
      39	    Synchronizes rules from the database to the backend.
      40	
      41	    Args:
      42	        db (Session): The SQLAlchemy session.
      43	    """
      44	    backend.apply_rules(_collect_rules(db))
      45	
      46	
      47	def announce_new_service(svc_name: str, db: Session) -> None:
      48	    """
      49	    Registers a new service with the Core if it is not already registered.
      50	
      51	    Args:
      52	        svc_name (str): The name of the service to register.
      53	        db (Session): The SQLAlchemy session.
      54	    """
      55	    core: core.CoreClient = get_core_client(db)
      56	    try:
      57	        svc: ServiceDB | None = db.query(ServiceDB).filter_by(name=svc_name).first()
      58	        if svc:
      59	            return  # already known
      60	        agent: AgentCredentials | None = db.query(AgentCredentials).first()
      61	        if not agent:
      62	            logging.warning("No agent credentials found!")
      63	            return
      64	
      65	        resp: core.Service = core.create_service(
      66	            svc_name, reverse_proxy_uuid=str(agent.uuid))
      67	        
      68	        # Register the service in the local database
      69	        new_service = ServiceDB(id=resp.id, name=svc_name, core_service_id=resp.id)
      70	        db.add(new_service)
      71	        db.commit()
      72	
      73	        logging.info("📣 Registered service '%s' with Core (id=%s)",
      74	                     svc_name, resp.id)
      75	    except Exception as exc:  # noqa: BLE001
      76	        logging.warning("Failed to register service %s: %s", svc_name, exc)
      77	    finally:
      78	        db.close()


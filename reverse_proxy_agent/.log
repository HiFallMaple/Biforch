       1	import subprocess
       2	import tempfile
       3	
       4	import pytest
       5	from reverse_proxy_agent.backends.nginx import NginxBackend
       6	
       7	
       8	def test_apply_and_reload_with_sudo(monkeypatch, tmp_path):
       9	    # Prepare a temp config dir
      10	    config_dir = tmp_path / "conf"
      11	    config_dir.mkdir()
      12	    backend = NginxBackend(config_dir)
      13	    rules = {"svc1": ["allow 1.2.3.4;", "deny 5.6.7.8;"]}
      14	
      15	    # Stub subprocess.run to capture sudo command
      16	    calls = {}
      17	    def fake_run(cmd, check=True):
      18	        calls['cmd'] = cmd
      19	        return None
      20	    monkeypatch.setattr(subprocess, "run", fake_run)
      21	
      22	    # Apply rules should write file and call sudo nginx reload
      23	    backend.apply_rules(rules)
      24	
      25	    # Verify conf file content
      26	    conf_file = config_dir / "svc1.conf"
      27	    content = conf_file.read_text()
      28	    assert "allow 1.2.3.4;" in content
      29	    assert "deny 5.6.7.8;" in content
      30	
      31	    # Verify that reload was invoked via sudo
      32	    assert calls['cmd'][0] == 'sudo'
      33	    assert 'nginx' in calls['cmd']
      34	    assert '-s' in calls['cmd'] and 'reload' in calls['cmd']


       1	"""FastAPI entry‑point – **only** routing / HTTP concerns live here."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	from contextlib import asynccontextmanager
       6	from pathlib import Path
       7	from typing import List
       8	
       9	from fastapi import Depends, FastAPI, HTTPException
      10	from sqlalchemy.orm import Session
      11	
      12	from .config import settings
      13	from .models import RuleDB, ServiceDB
      14	from .schemas import RuleIn, RuleOut
      15	from .dependencies import get_db, get_backend, get_core_client
      16	from .services.sync import sync_to_backend, announce_new_service
      17	
      18	# ------------------------------------------------------------------------
      19	# Lifespan – at startup discover *.conf & register missing services
      20	# ------------------------------------------------------------------------
      21	
      22	@asynccontextmanager
      23	async def lifespan(_: FastAPI):
      24	    Path(settings.CONFIG_DIR).mkdir(parents=True, exist_ok=True)
      25	    db: Session = next(get_db())  # type: ignore[arg-type]
      26	    try:
      27	        for cfg in Path(settings.CONFIG_DIR).glob("*.conf"):
      28	            svc = cfg.stem
      29	            if not db.query(ServiceDB).filter_by(name=svc).first():
      30	                announce_new_service(svc)
      31	        db.commit()
      32	    finally:
      33	        db.close()
      34	    yield
      35	
      36	# ------------------------------------------------------------------------
      37	# FastAPI app
      38	# ------------------------------------------------------------------------
      39	
      40	app = FastAPI(title="Reverse‑Proxy Agent", lifespan=lifespan)
      41	
      42	
      43	# ------------------------------- routes ----------------------------------
      44	
      45	@app.post("/rules/{service_id}", response_model=RuleOut)
      46	def create_rule(service_id: int, body: RuleIn, db: Session = Depends(get_db)) -> RuleOut:
      47	    svc = db.get(ServiceDB, service_id)
      48	    if svc is None:
      49	        raise HTTPException(404, "service not registered")
      50	
      51	    rule = RuleDB(service_name=svc.name, action=body.action, ip=str(body.ip))
      52	    db.add(rule)
      53	    db.commit(); db.refresh(rule)
      54	
      55	    sync_to_backend()
      56	    return RuleOut(id=rule.id, service_id=service_id, action=rule.action, ip=rule.ip)
      57	
      58	
      59	@app.put("/rules/{service_id}", response_model=List[RuleOut])
      60	def replace_rules(service_id: int, body: RuleIn, db: Session = Depends(get_db)) -> List[RuleOut]:
      61	    svc = db.get(ServiceDB, service_id)
      62	    if svc is None:
      63	        raise HTTPException(404, "service not registered")
      64	
      65	    db.query(RuleDB).filter_by(service_name=svc.name).delete()
      66	    rule = RuleDB(service_name=svc.name, action=body.action, ip=str(body.ip))
      67	    db.add(rule); db.commit(); db.refresh(rule)
      68	
      69	    sync_to_backend()
      70	    return [RuleOut(id=rule.id, service_id=service_id, action=rule.action, ip=rule.ip)]
      71	
      72	
      73	@app.delete("/rules/{service_id}")
      74	def delete_rules(service_id: int, db: Session = Depends(get_db)) -> dict[str, int]:
      75	    svc = db.get(ServiceDB, service_id)
      76	    if svc is None:
      77	        raise HTTPException(404, "service not found")
      78	
      79	    deleted = db.query(RuleDB).filter_by(service_name=svc.name).delete()
      80	    if deleted == 0:
      81	        raise HTTPException(404, "no rules to delete")
      82	
      83	    db.commit()
      84	    sync_to_backend()
      85	    return {"deleted": deleted}


      26	# Predictable UUID generator for deterministic tests
      27	_uuid_counter = itertools.count(1)
      28	def fake_uuid(name: str) -> str:
      29	    return f"uuid-{next(_uuid_counter)}-{name}"
      30	
      31	# Minimal fake HTTP Response
      32	class FakeResp:
      33	    def __init__(self, data: Dict[str, Any], status: int = 200):
      34	        self._data = data
      35	        self.status_code = status
      36	        self.text = json.dumps(data)
      37	
      38	    def json(self):
      39	        return self._data
      40	
      41	    def raise_for_status(self):
      42	        if not (200 <= self.status_code < 300):
      43	            raise Exception(f"HTTP {self.status_code}")
      44	
      45	# Test fixture: isolated DB and stub for alias creation
      46	@pytest.fixture(autouse=True)
      47	def client(tmp_path, monkeypatch):
      48	    db_file = tmp_path / "test.db"
      49	    engine = create_engine(f"sqlite:///{db_file}", connect_args={"check_same_thread": False})
      50	    TestingSession = sessionmaker(bind=engine, autoflush=False, autocommit=False)
      51	    Base.metadata.create_all(bind=engine)
      52	    monkeypatch.setattr(firewall_agent, "engine", engine)
      53	    monkeypatch.setattr(firewall_agent, "SessionLocal", TestingSession)
      54	    monkeypatch.setattr(firewall_agent, "create_opnsense_alias", lambda svc: fake_uuid(svc))
      55	    return TestClient(app)

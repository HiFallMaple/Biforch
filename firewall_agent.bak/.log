      36	REMOTE_URI = get_env_str("REMOTE_URI")
      37	CORE_URI = get_env_str("CORE_URI")
      38	TIMEOUT = get_env_int("TIMEOUT")
      39	DB_PATH = get_env_str("DB_PATH")  # local SQLite path constant

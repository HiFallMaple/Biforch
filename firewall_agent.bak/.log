     142	def test_alias_crud(client):
     143	    r = client.post("/aliases", json={"service_name": "foo"})
     144	    aid = r.json()["id"]
     145	    assert any(a["id"] == aid for a in client.get("/aliases").json())
     146	    r = client.put(f"/aliases/{aid}", json={"service_name": "bar"})
     147	    assert r.status_code == 200
     148	    assert any(a["service_name"] == "bar" for a in client.get("/aliases").json())
     149	    r = client.delete(f"/aliases/{aid}")
     150	    assert r.status_code == 200
     151	    assert all(a["id"] != aid for a in client.get("/aliases").json())

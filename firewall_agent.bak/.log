     125	def create_opnsense_alias(name: str) -> str:
     126	    payload = {"alias": {"enabled": "1", "name": f"{PREFIX}{name}", "type": "host"}}
     127	    resp = requests.post(
     128	        f"{REMOTE_URI}/api/firewall/alias/add_item",
     129	        auth=(API_KEY, API_SECRET),
     130	        json=payload,
     131	        timeout=TIMEOUT,
     132	    )
     133	    if resp.status_code != 200:
     134	        raise HTTPException(502, f"OPNsense error: {resp.text}")
     135	    data: Dict[str, str] = resp.json()
     136	    if data.get("result") != "saved" or not data.get("uuid"):
     137	        raise HTTPException(502, "Failed to create alias on OPNsense")
     138	    return data["uuid"]

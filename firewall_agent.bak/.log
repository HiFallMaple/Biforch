       9	def get_env_str(name: str) -> str:
      10	    """
      11	    Retrieve an environment variable or raise an error if missing.
      12	    """
      13	    value = os.getenv(name)
      14	    if not value:
      15	        raise RuntimeError(f"Environment variable '{name}' must be set")
      16	    return value
      17	
      18	
      19	def get_env_int(name: str) -> int:
      20	    """
      21	    Retrieve an environment variable as int or raise error if missing/invalid.
      22	    """
      23	    val_str = get_env_str(name)
      24	    try:
      25	        return int(val_str)
      26	    except ValueError:
      27	        raise RuntimeError(
      28	            f"Environment variable '{name}' must be an integer, got '{val_str}'")
      29	

      57	# create_opnsense_alias helper
      58	def test_create_opnsense_alias_success(monkeypatch):
      59	    called = {}
      60	    def fake_post(url, auth=None, json=None, timeout=None):
      61	        called['url'] = url
      62	        called['json'] = json
      63	        return FakeResp({"result": "saved", "uuid": "my-uuid"})
      64	    monkeypatch.setattr(firewall_agent.requests, "post", fake_post)
      65	    uid = create_opnsense_alias("svc")
      66	    assert uid == "my-uuid"
      67	    assert PREFIX in called['json']['alias']['name']

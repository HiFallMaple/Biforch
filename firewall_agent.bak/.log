     297	# ---------------------------------------------------------------------------
     298	# Firewall sync logic
     299	# ---------------------------------------------------------------------------
     300	def fetch_firewall_data() -> list[dict]:
     301	    resp = requests.get(
     302	        f"{REMOTE_URI}/api/firewall/filter/search_rule",
     303	        auth=(API_KEY, API_SECRET),
     304	        timeout=TIMEOUT,
     305	    )
     306	    resp.raise_for_status()
     307	    with open("firewall_rules.json", "w", encoding="utf-8") as fp:
     308	        fp.write(resp.text)
     309	    return resp.json().get("rows", [])
     310	
     311	
     312	def process_rules(rows: list[dict], db) -> tuple[list[dict], list[dict]]:
     313	    new_rules: list[dict] = []
     314	    removed_rules: list[dict] = []
     315	
     316	    for row in rows:
     317	        uuid_fw = row["uuid"]
     318	        detail = requests.get(
     319	            f"{REMOTE_URI}/api/firewall/filter/get_rule/{uuid_fw}",
     320	            auth=(API_KEY, API_SECRET),
     321	            timeout=TIMEOUT,
     322	        ).json()["rule"]
     323	
     324	        raw_action = next(a for a, v in detail["action"].items() if v["selected"] == 1)
     325	        action = ACTION_MAP.get(raw_action, "block")
     326	
     327	        src_ip = detail["source_net"]
     328	        dest = detail["destination_net"]
     329	        if not dest.startswith(PREFIX):
     330	            continue
     331	        svc = dest[len(PREFIX):]
     332	
     333	        alias_obj = db.query(AliasDB).filter_by(service_name=svc).first()
     334	        if not alias_obj:
     335	            continue
     336	
     337	        existing = db.query(RuleDB).filter_by(firewall_rule_uuid=uuid_fw).first()
     338	
     339	        if row["enabled"] == "1" and not existing:
     340	            db_rule = RuleDB(
     341	                firewall_rule_uuid=uuid_fw,
     342	                action=action,
     343	                src_ip=src_ip,
     344	                dest_alias_id=alias_obj.id,
     345	            )
     346	            db.add(db_rule)
     347	            new_rules.append({
     348	                "firewall_uuid": uuid_fw,
     349	                "action": action,
     350	                "ip": src_ip,
     351	                "service": svc,
     352	            })
     353	        elif row["enabled"] != "1" and existing:
     354	            removed_rules.append({"firewall_uuid": uuid_fw})
     355	            db.delete(existing)
     356	
     357	    return new_rules, removed_rules
     358	
     359	
     360	def notify_core(new_rules: list[dict], removed_rules: list[dict]) -> None:
     361	    for rule in new_rules:
     362	        try:
     363	            requests.post(f"{CORE_URI}/rules", json=rule, timeout=TIMEOUT)
     364	        except Exception as exc:
     365	            logging.warning("Failed to notify core of rule creation: %s", exc)
     366	
     367	    for rule in removed_rules:
     368	        try:
     369	            requests.delete(f"{CORE_URI}/rules/firewall/{rule['firewall_uuid']}", timeout=TIMEOUT)
     370	        except Exception as exc:
     371	            logging.warning("Failed to notify core of rule deletion: %s", exc)
     372	
     373	
     374	def sync_firewall_rules():
     375	    try:
     376	        rows = fetch_firewall_data()
     377	        db = SessionLocal()
     378	        new_rules, removed_rules = process_rules(rows, db)
     379	
     380	        if new_rules or removed_rules:
     381	            db.commit()
     382	            logging.info("Sync completed: +%s / -%s", len(new_rules), len(removed_rules))
     383	            notify_core(new_rules, removed_rules)
     384	
     385	        db.close()
     386	    except Exception as exc:
     387	        logging.error("Sync error: %s", exc)
     388	
     389	
     390	def monitor_firewall(interval: int = 10, stop_event: Optional[threading.Event] = None):
     391	    while not (stop_event and stop_event.is_set()):
     392	        sync_firewall_rules()
     393	        time.sleep(interval)
     394	
     395	
     396	if __name__ == "__main__":  # pragma: no cover
     397	    logging.basicConfig(level=logging.INFO)
     398	    stop_event = threading.Event()
     399	    threading.Thread(target=monitor_firewall, args=(10, stop_event), daemon=True).start()
     400	    import uvicorn
     401	    uvicorn.run("firewall_agent:app", host="0.0.0.0", port=8000, reload=True)


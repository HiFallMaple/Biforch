------------------------------ test.py ------------------------------
       1	#!/usr/bin/env python3
       2	"""
       3	fetch_firewall_rules.py
       4	
       5	Standalone script to retrieve firewall rules from the OPNsense API
       6	and save the response to firewall_rules.json.
       7	"""
       8	
       9	import json
      10	import logging
      11	import sys
      12	
      13	import requests
      14	
      15	# Import your configuration values
      16	from config import REMOTE_URI, API_KEY, API_SECRET, TIMEOUT
      17	
      18	def fetch_and_save_rules(output_path: str = "firewall_rules.json") -> None:
      19	    """
      20	    Fetch the list of firewall rules via the OPNsense API and save to a JSON file.
      21	    """
      22	    url = f"{REMOTE_URI}/api/firewall/filter/search_rule"
      23	    try:
      24	        resp = requests.get(
      25	            url,
      26	            auth=(API_KEY, API_SECRET),
      27	            timeout=TIMEOUT,
      28	        )
      29	        resp.raise_for_status()
      30	    except Exception as exc:
      31	        logging.error("Failed to fetch firewall rules: %s", exc)
      32	        sys.exit(1)
      33	
      34	    try:
      35	        data = resp.json()
      36	    except ValueError as exc:
      37	        logging.error("Response is not valid JSON: %s", exc)
      38	        sys.exit(1)
      39	
      40	    with open(output_path, "w", encoding="utf-8") as fp:
      41	        json.dump(data, fp, ensure_ascii=False, indent=2)
      42	    print(f"Firewall rules written to {output_path}")
      43	
      44	if __name__ == "__main__":
      45	    logging.basicConfig(level=logging.INFO)
      46	    fetch_and_save_rules()


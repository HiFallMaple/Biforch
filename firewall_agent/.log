      10	from pydantic_settings import BaseSettings
      11	
      12	
      13	class Settings(BaseSettings):
      14	    """
      15	    Application settings for Biforch Firewall Agent.
      16	
      17	    - Loads settings from environment variables via pydantic-settings
      18	    - Validates values on startup (fails fast)
      19	    """
      20	
      21	    # ---------- External service URLs ----------
      22	    CORE_URL: AnyHttpUrl = Field(..., description="URL of Biforch Core service")
      23	    REMOTE_URL: AnyHttpUrl = Field(..., description="Base URL of firewall backend")
      24	    AGENT_URL: AnyHttpUrl = Field(..., description="Callback/API URL of this agent")
      25	
      26	    # ---------- OPNsense ----------
      27	    OPNSENSE_API_KEY: str = Field(..., description="OPNsense API key")
      28	    OPNSENSE_API_SECRET: str = Field(..., description="OPNsense API secret")
      29	
      30	    # ---------- FortiGate ----------
      31	    FORTIGATE_API_TOKEN: str = Field(..., description="FortiGate REST API token (Bearer)")
      32	    FORTIGATE_VDOM: str = Field(..., min_length=1, description="FortiGate VDOM name")
      33	
      34	    # ---------- Backend plug-in ----------
      35	    FIREWALL_BACKEND: str = Field(
      36	        "opnsense",
      37	        description="Backend engine module name under firewall_agent.backends.*",
      38	        min_length=1,
      39	    )
      40	
      41	    # ---------- Alias configuration ----------
      42	    PREFIX: str = Field("Biforch_", min_length=1, description="Prefix for OPNsense aliases")
      43	    AGENT_NAME: str = Field(..., description="Logical name of this agent")
      44	
      45	    # ---------- Runtime behavior ----------
      46	    TIMEOUT: int = Field(10, description="Outbound HTTP timeout in seconds", gt=0)
      47	    DB_PATH: Path = Field("./data/db.sqlite", description="Path to SQLite database file")
      48	
      49	    # ---------- API server ----------
      50	    INTERNAL_HOST: str = Field("0.0.0.0", description="Uvicorn server host")
      51	    INTERNAL_PORT: int = Field(8000, description="Uvicorn server port", ge=1, le=65535)
      52	    RELOAD: bool = Field(False, description="Enable Uvicorn auto-reload in development")
      53	
      54	    # ---------- Misc ----------
      55	    ACTION_MAP: dict[str, str] = Field(
      56	        default_factory=lambda: {"pass": "pass", "block": "block", "reject": "block"},
      57	        description="Map OPNsense actions to Core contract",
      58	    )
      59	
      60	    LOG_FILE_PATH: Path = Field("./data/.log", description="Path to log file")
      61	
      62	    # ---------- Pydantic settings ----------
      63	    model_config = {
      64	        "extra": "ignore",
      65	        "case_sensitive": True,
      66	        "env_file": ".env",
      67	    }
      68	
      69	    # ----------------------------- Validators -----------------------------
      70	    @field_validator("FIREWALL_BACKEND", mode="before")
      71	    @classmethod
      72	    def _validate_backend_exists(cls, value: str) -> str:
      73	        """
      74	        Fail fast if the requested backend does not exist **without importing it**.
      75	
      76	        Importing would execute `firewall_agent.backends.__init__` and pull `settings`
      77	        a second time, leading to a circular-import error while `Settings()` is still
      78	        being constructed.  Instead, simply check that the file
      79	        `<package_root>/backends/<backend>.py` is present.
      80	        """
      81	        backend = value.lower()
      82	
      83	        # `config.py` itself lives directly in `firewall_agent`, so this is the package root
      84	        package_root = Path(__file__).resolve().parent
      85	        backend_file = package_root / "backends" / f"{backend}.py"
      86	
      87	        if not backend_file.is_file():
      88	            raise ValueError(
      89	                f"Backend '{backend}' was not found under '{backend_file.parent}'."
      90	            )
      91	
      92	        return backend
      93	
      94	    @field_validator("DB_PATH", mode="before")
      95	    @classmethod
      96	    def _validate_db_path(cls, v: str | Path) -> Path:
      97	        path = Path(v)
      98	        parent = path.parent
      99	        if not parent.exists():
     100	            raise ValueError(f"DB_PATH directory does not exist: {parent}")
     101	        return path
     102	
     103	    @field_validator("LOG_FILE_PATH", mode="before")
     104	    @classmethod
     105	    def _validate_log_file_path(cls, v: str | Path) -> Path:
     106	        path = Path(v)
     107	        parent = path.parent
     108	        if not parent.exists():
     109	            raise ValueError(f"LOG_FILE_PATH directory does not exist: {parent}")
     110	        return path
     111	
     112	    @field_validator("INTERNAL_HOST", mode="before")
     113	    @classmethod
     114	    def _validate_internal_host(cls, v: str) -> str:
     115	        try:
     116	            ipaddress.ip_address(v)
     117	        except ValueError:
     118	            raise ValueError(f"INTERNAL_HOST must be a valid IP address: {v}")
     119	        return v
     120	
     121	    @field_validator("PREFIX", mode="before")
     122	    @classmethod
     123	    def _validate_prefix(cls, v: str) -> str:
     124	        if not v or v.strip() == "":
     125	            raise ValueError("PREFIX cannot be empty")
     126	        return v
     127	
     128	    @field_validator("ACTION_MAP", mode="before")
     129	    @classmethod
     130	    def _validate_action_map(cls, v: dict[str, str]) -> dict[str, str]:
     131	        if not isinstance(v, dict) or not v:
     132	            raise ValueError("ACTION_MAP must be a non-empty dict")
     133	        return v
     134	
     135	    @field_validator("RELOAD", mode="before")
     136	    @classmethod
     137	    def _parse_reload_flag(cls, v: bool | str) -> bool:
     138	        if isinstance(v, str):
     139	            val = v.lower()
     140	            if val in ("true", "1", "yes"):
     141	                return True
     142	            if val in ("false", "0", "no"):
     143	                return False
     144	            raise ValueError("RELOAD must be a boolean value")
     145	        return bool(v)
     146	
     147	

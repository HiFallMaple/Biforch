      10	from fastapi import Depends, FastAPI, HTTPException
      11	from sqlalchemy.orm import Session
      12	
      13	from .schemas import (
      14	    ReverseProxyIn,
      15	    ReverseProxyOut,
      16	    AliasIn,
      17	    AliasOut,
      18	    RuleOut,
      19	)
      20	from .models import ReverseProxyDB, AliasDB, RuleDB
      21	from .config import settings
      22	from .dependencies import get_db, get_backend
      23	from .services.sync import sync_firewall
      24	
      25	# ------------------------------------------------------------------ Lifespan
      26	
      27	
      28	@asynccontextmanager
      29	async def lifespan(_: FastAPI):
      30	    """Background thread monitors firewall every 10 s."""
      31	    stop = threading.Event()
      32	    db: Session = next(get_db())  # type: ignore[arg-type]
      33	    def _worker():
      34	        while not stop.is_set():
      35	            sync_firewall(db)
      36	            time.sleep(10)
      37	
      38	    thread = threading.Thread(target=_worker, daemon=True)
      39	    thread.start()
      40	    try:
      41	        yield
      42	    finally:
      43	        stop.set()
      44	        thread.join(timeout=1)
      45	
      46	
      47	app = FastAPI(title="Firewall Agent", lifespan=lifespan)
      48	
      49	# ---------------------------------------------------------------- Proxies
      50	
      51	
      52	@app.post("/reverse_proxies", response_model=ReverseProxyOut)
      53	def create_reverse_proxy(body: ReverseProxyIn, db: Session = Depends(get_db)) -> ReverseProxyOut:
      54	    if db.get(ReverseProxyDB, body.uuid):
      55	        raise HTTPException(400, "uuid already registered")
      56	    obj = ReverseProxyDB(
      57	        id=body.uuid,
      58	        name=body.name,
      59	        ip=str(body.ip),
      60	        ports=",".join(map(str, body.ports)),
      61	        allowed_ips=",".join(body.allowed_ips),
      62	    )
      63	    db.add(obj)
      64	    db.commit()
      65	    db.refresh(obj)
      66	    return ReverseProxyOut(id=obj.id)
      67	

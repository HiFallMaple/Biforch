      22	def ensure_interface_exists():
      23	    url  = f"{REMOTE_URL}/api/v2/cmdb/system/interface/{INTERFACE}"
      24	    if requests.get(url, headers=headers, verify=False).status_code != 200:
      25	        sys.exit(f"❌ 介面 {INTERFACE} 不存在")
      26	
      27	
      28	def ensure_schedule_exists():
      29	    url  = f"{REMOTE_URL}/api/v2/cmdb/firewall.schedule/recurring/always"
      30	    if requests.get(url, headers=headers, verify=False).status_code == 404:
      31	        print("📌 建立 schedule 'always'")
      32	        payload = {
      33	            "name":  "always",
      34	            "start": "00:00",
      35	            "end":   "23:59",
      36	            "day":   ["sun","mon","tue","wed","thu","fri","sat"]
      37	        }
      38	        requests.post(
      39	            f"{REMOTE_URL}/api/v2/cmdb/firewall.schedule/recurring",
      40	            headers=headers, json=payload, verify=False
      41	        ).raise_for_status()
      42	
      43	
      44	def ensure_service_exists():
      45	    for ep in ("firewall.service", "firewall.service/custom"):
      46	        if requests.get(f"{REMOTE_URL}/api/v2/cmdb/{ep}/ALL",
      47	                        headers=headers, verify=False).status_code == 200:
      48	            print(f"✅ 服務 'ALL' 存在於 {ep}")
      49	            return
      50	    print("⚠️ 找不到服務 'ALL'，假設為內建服務並繼續")
      51	
      52	
      53	def ensure_address_exists():
      54	    if requests.get(f"{REMOTE_URL}/api/v2/cmdb/firewall/address/{SRC_ADDR_NAME}",
      55	                    headers=headers, verify=False).status_code == 404:
      56	        print(f"📌 建立來源 address: {SRC_ADDR_NAME}")
      57	        payload = {"name": SRC_ADDR_NAME, "subnet": f"{SRC_IP}/32"}
      58	        requests.post(
      59	            f"{REMOTE_URL}/api/v2/cmdb/firewall/address",
      60	            headers=headers, json=payload, verify=False
      61	        ).raise_for_status()
      62	
      63	
      64	def ensure_addrgrp_exists():
      65	    if requests.get(f"{REMOTE_URL}/api/v2/cmdb/firewall/addrgrp/{DST_GROUP_NAME}",
      66	                    headers=headers, verify=False).status_code == 404:
      67	        print(f"📌 建立 address group: {DST_GROUP_NAME}")
      68	        payload = {"name": DST_GROUP_NAME, "member": []}
      69	        requests.post(
      70	            f"{REMOTE_URL}/api/v2/cmdb/firewall/addrgrp",

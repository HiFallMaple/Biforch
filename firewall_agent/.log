       1	from __future__ import annotations
       2	
       3	from typing import Generator
       4	
       5	from fastapi import Depends  # re‑export for use in other modules
       6	from sqlalchemy.orm import Session
       7	
       8	from .database import SessionLocal
       9	from .backends import backend as _backend  # singleton
      10	from .backends.base import FirewallBackend
      11	from .clients.core import CoreClient
      12	from .config import settings
      13	from .models import AgentCredentials
      14	
      15	# ----------------------------- Database ---------------------------
      16	
      17	def get_db() -> Generator[Session, None, None]:
      18	    """
      19	    Returns a SQLAlchemy session for dependency injection.
      20	
      21	    Yields:
      22	        Session: A SQLAlchemy session instance.
      23	    """
      24	    db: Session = SessionLocal()
      25	    try:
      26	        yield db
      27	    finally:
      28	        db.close()
      29	
      30	
      31	# ----------------------------- Backend ---------------------------
      32	
      33	def get_backend() -> FirewallBackend:  # pragma: no cover
      34	    """
      35	    Returns the singleton instance of the backend.
      36	
      37	    Returns:
      38	        FirewallBackend: The backend instance (e.g., Nginx).
      39	    """
      40	    return _backend
      41	
      42	
      43	# ------------------------------ Core -----------------------------
      44	
      45	
      46	def get_core_client(db: Session) -> CoreClient:
      47	    """
      48	    Create a CoreClient using the stored actor token from the database.
      49	    Raises HTTPException if no token is available.
      50	
      51	    Args:
      52	        db (Session): The SQLAlchemy session to retrieve credentials.
      53	
      54	    Returns:
      55	        CoreClient: The CoreClient instance initialized with the actor token.
      56	
      57	    Raises:
      58	        HTTPException: If no token is found for the agent in the database.
      59	    """
      60	    from fastapi import HTTPException
      61	
      62	    # Retrieve the agent's credentials from the local database
      63	    cred: AgentCredentials | None = db.query(AgentCredentials).first()
      64	    token: str | None = cred.token if cred else None
      65	
      66	    if not token:
      67	        raise HTTPException(
      68	            status_code=500, detail="Missing actor token: please register the agent first.")
      69	
      70	    # Initialize CoreClient with actor_token
      71	    return CoreClient(str(settings.CORE_URL), actor_token=token)


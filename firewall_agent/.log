     183	            "level": "INFO",
     184	            "propagate": False,
     185	        },
     186	    },
     187	}
     188	
     189	# Instantiate settings (fails on validation error)
     190	try:
     191	    settings = Settings()
     192	    LOGGING_CONFIG["handlers"]["file"]["filename"] = settings.LOG_FILE_PATH
     193	    logging.config.dictConfig(LOGGING_CONFIG)
     194	    logging.info("Settings loaded successfully")
     195	except ValidationError as exc:

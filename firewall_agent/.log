       9	# ---------------------------------------------------------------------
      10	# Data models
      11	# ---------------------------------------------------------------------
      12	@dataclass
      13	class PendingRequest:
      14	    request_id: int
      15	    secret: str
      16	
      17	
      18	@dataclass

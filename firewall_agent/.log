       1	"""Backend factory – returns a singleton *firewall backend* according to settings.
       2	Currently only OPNsense is implemented, but the design allows additional engines."""
       3	from __future__ import annotations
       4	
       5	import importlib
       6	import inspect
       7	from types import ModuleType
       8	
       9	from ..config import settings
      10	from .base import FirewallBackend  # type: ignore
      11	from .types import RuleInfo  # type: ignore
      12	
      13	
      14	def _load_backend(name: str) -> FirewallBackend:
      15	    """Return an instance of the requested backend."""
      16	    mod: ModuleType = importlib.import_module(f".{name}", package=__name__)
      17	
      18	    if hasattr(mod, "Backend"):
      19	        cls = getattr(mod, "Backend")
      20	    else:
      21	        candidates = [
      22	            obj for _, obj in inspect.getmembers(mod, inspect.isclass)
      23	            if issubclass(obj, FirewallBackend) and obj is not FirewallBackend
      24	        ]
      25	        if not candidates:
      26	            raise ImportError(
      27	                f"Module '{mod.__name__}' has no subclass of FirewallBackend"
      28	            )
      29	        cls = candidates[0]
      30	
      31	    return cls()  # type: ignore[return-value]
      32	
      33	
      34	backend: FirewallBackend = _load_backend(settings.FIREWALL_BACKEND)
      35	
      36	__all__ = ["backend"]


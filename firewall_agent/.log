       1	# firewall_agent/backends/fortigate.py
       2	"""
       3	FortiGate backend – implements alias / policy CRUD via FortiOS REST API
       4	Tested on FortiOS 7.4 (token auth).
       5	
       6	Env vars required (see config.py):
       7	    REMOTE_URL      – https://<FG_IP>
       8	    FORTIGATE_API_TOKEN
       9	    FORTIGATE_VDOM     – default “root”
      10	"""
      11	from __future__ import annotations
      12	
      13	import ipaddress
      14	import json
      15	from typing import Any
      16	
      17	import requests
      18	from requests import Response
      19	from sqlalchemy.orm import Session
      20	
      21	
      22	from ..config import logging, settings
      23	from ..models import AliasDB, RuleDB
      24	from .base import FirewallBackend
      25	from .types import RuleInfo
      26	
      27	
      28	class FortiGateBackend(FirewallBackend):
      29	    """Concrete implementation of :class:`FirewallBackend` for FortiOS >= 7.x."""
      30	
      31	    def __init__(self) -> None:
      32	        self.base = str(settings.REMOTE_URL).rstrip("/")
      33	        self.vdom = settings.FORTIGATE_VDOM
      34	        self.hdrs = {
      35	            "Authorization": f"Bearer {settings.FORTIGATE_API_TOKEN}",
      36	            "Content-Type": "application/json",
      37	        }
      38	        self.params = {"vdom": self.vdom}
      39	
      40	    # ---------------------------------------------------------------- helpers
      41	    def _req(self, method: str, path: str, **kw) -> Response:  # pragma: no cover
      42	        url = f"{self.base}{path}"
      43	        kw.setdefault("headers", self.hdrs)
      44	        kw.setdefault("params", self.params)
      45	        kw.setdefault("verify", False)  # skip self‑signed certs in labs
      46	        resp = requests.request(method, url, **kw, timeout=settings.TIMEOUT)
      47	        if resp.status_code not in (200, 201):
      48	            logging.error("FortiGate API error %s: %s", resp.status_code, resp.text)
      49	            resp.raise_for_status()
      50	        return resp
      51	    
      52	    def _get_address_ip(self, address_name: str) -> ipaddress.IPv4Network | ipaddress.IPv6Network:
      53	        """
      54	        Fetch a firewall address object by name and return its subnet in CIDR format.
      55	        
      56	        :param address_name: Name of the address object on FortiGate (e.g. 'src_192.168.87.51')
      57	        :return: Subnet in CIDR notation (e.g. '192.168.87.51/32')
      58	        :raises RuntimeError: if no address object is found or response is malformed
      59	        """
      60	        resp = self._req(
      61	            "get",
      62	            f"/api/v2/cmdb/firewall/address/{address_name}"
      63	        )
      64	        data: dict[str, Any] = resp.json()
      65	        results = data.get("results", [])
      66	        if not results:
      67	            raise RuntimeError(f"No address object found for '{address_name}'")
      68	
      69	        # "subnet" comes as "IP MASK", e.g. "192.168.1.0 255.255.255.0"
      70	        subnet_str = results[0].get("subnet", "")
      71	        try:
      72	            ip_str, mask_str = subnet_str.split()
      73	        except ValueError:
      74	            raise RuntimeError(f"Unexpected subnet format for '{address_name}': '{subnet_str}'")
      75	
      76	        return ipaddress.ip_network((ip_str, mask_str), strict=False)
      77	
      78	    def _to_ruleinfo(self, item: dict) -> RuleInfo | None:
      79	        """
      80	        Convert a FortiGate policy item into RuleInfo.
      81	        - skip if disabled or destination not using our PREFIX
      82	        - resolve srcaddr object to its subnet and convert to CIDR
      83	        """
      84	        # only process enabled rules
      85	        if item.get("status") != "enable":
      86	            return None
      87	
      88	        # destination address must start with our alias PREFIX
      89	        dst_name = item["dstaddr"][0]["name"]
      90	        if not dst_name.startswith(settings.PREFIX):
      91	            return None
      92	
      93	        # extract service name from dstaddr
      94	        service_name = dst_name[len(settings.PREFIX):]
      95	
      96	        src_name = item["srcaddr"][0]["name"]
      97	        src_ip_cidr = str(self._get_address_ip(src_name))
      98	
      99	        # map FortiGate action to our RuleInfo action
     100	        action = "pass" if item["action"] == "accept" else "block"
     101	
     102	        return RuleInfo(
     103	            firewall_rule_id=str(item["policyid"]),
     104	            action=action,
     105	            src_ip=src_ip_cidr,
     106	            service_name=service_name,
     107	        )
     108	
     109	    @staticmethod
     110	    def _assert_success(data: dict[str, Any], *, action: str) -> None:  # pragma: no cover
     111	        """Raise ``RuntimeError`` if the FortiOS payload does not indicate success."""
     112	        if data.get("status") != "success":
     113	            raise RuntimeError(f"FortiGate API {action} failed: {data}")
     114	
     115	    # ------------------------------------------------------- address‑group CRUD
     116	    def create_alias(self, name: str) -> str:
     117	        """Create an *empty* address‑group and return ``name`` as its identifier."""
     118	        payload = {"name": name, "member": []}
     119	        resp = self._req("post", "/api/v2/cmdb/firewall/addrgrp", json=payload)
     120	        data = resp.json()
     121	        logging.info("FortiGate addrgrp/create response: %s", data)
     122	        self._assert_success(data, action="create_alias")
     123	        return name  # use address‑group name as alias_id
     124	
     125	    def delete_alias(self, alias_id: str) -> None:
     126	        """Delete an existing address‑group by its *name* (alias_id)."""
     127	        resp = self._req("delete", f"/api/v2/cmdb/firewall/addrgrp/{alias_id}")
     128	        data = resp.json()
     129	        logging.info("FortiGate addrgrp/delete response: %s", data)
     130	        self._assert_success(data, action="delete_alias")
     131	
     132	    # ------------------------------------------------------------------ policy
     133	    def create_rule(
     134	        self,
     135	        rule_name: str,
     136	        src_ip: str,
     137	        dst_group: str,
     138	        in_if: str = "port2",
     139	        out_if: str = "port2",
     140	    ) -> dict[str, Any]:
     141	        """Create an IPv4 firewall policy that NATs *src_ip → dst_group*.
     142	
     143	        Returns the FortiOS JSON payload (validated).
     144	        """
     145	        payload = {
     146	            "name": rule_name,
     147	            "srcintf": [{"name": in_if}],
     148	            "dstintf": [{"name": out_if}],
     149	            "srcaddr": [{"name": src_ip}],
     150	            "dstaddr": [{"name": dst_group}],
     151	            "service": [{"name": "ALL"}],
     152	            "action": "accept",
     153	            "schedule": "always",
     154	            "nat": "enable",
     155	        }
     156	        resp = self._req("post", "/api/v2/cmdb/firewall/policy", json=payload)
     157	        data = resp.json()
     158	        logging.info("FortiGate policy/create response: %s", data)
     159	        self._assert_success(data, action="create_rule")
     160	        return data
     161	
     162	    def delete_rule(self, policy_id: int) -> None:
     163	        """Remove a firewall policy (by numeric policy id)."""
     164	        resp = self._req("delete", f"/api/v2/cmdb/firewall/policy/{policy_id}")
     165	        data = resp.json()
     166	        logging.info("FortiGate policy/delete response: %s", data)
     167	        self._assert_success(data, action="delete_rule")
     168	
     169	    # ------------------------------------------------ rules list/details (stub)
     170	    # These are *not* required by the current agent logic for FortiGate, but we
     171	    # keep the signature for future parity and raise *clear* runtime errors so
     172	    # developers notice when they are called.
     173	    def list_rules(self) -> dict[str, RuleInfo]:
     174	        """List all rule_id that are currently active."""
     175	        resp = self._req("get", "/api/v2/cmdb/firewall/policy")
     176	        resp.raise_for_status()
     177	        items = resp.json()["results"]
     178	        rules: dict[str, RuleInfo] = {}
     179	        logging.debug(f"FortiGate list_rules response: {items}")
     180	        for item in items:
     181	            rule = self._to_ruleinfo(item)
     182	            if rule is None:
     183	                continue
     184	            rules[rule["firewall_rule_id"]] = rule
     185	        logging.debug(f"FortiGate list_rules → {len(rules)} rules")
     186	        return rules
     187	                
     188	
     189	    def rule_details(self, rule_id: str) -> RuleInfo | None:
     190	        """
     191	        Get details of a specific rule by its rule_id.
     192	
     193	        Args:
     194	            rule_id: The unique identifier of the rule.
     195	        Returns:
     196	            RuleInfo: A dictionary containing rule details with keys:
     197	                - 'rule_id': The unique identifier of the rule.
     198	                - 'action': The action taken by the rule (e.g., "pass", "reject").
     199	                - 'src_ip': The source IP address for the rule.
     200	                - 'service_name': The name of the service associated with the rule.
     201	        Raises:
     202	            KeyError: If the rule_id does not exist.
     203	        """
     204	        resp = self._req("get", f"/api/v2/cmdb/firewall/policy/{rule_id}")
     205	        resp.raise_for_status()
     206	        item = resp.json()["results"][0]
     207	        logging.debug(f"FortiGate rule_details response: {item}")
     208	
     209	        return self._to_ruleinfo(item)
     210	
     211	    # ------------------ Webhook processing ------------------
     212	    def webhooks_rules(
     213	        self,
     214	        db: Session,
     215	        payload: dict,
     216	    ) -> tuple[list[RuleInfo], list[str]]:
     217	        """
     218	        Process a FortiGate webhook payload and return rule change diffs.
     219	
     220	        Detects additions, removals, and edits (field changes on existing rules).
     221	        """
     222	        if payload.get("cfgpath") != "firewall.policy":
     223	            return [], []
     224	
     225	        rule_uuid = payload.get("cfgobj")
     226	        if not rule_uuid:
     227	            return [], []
     228	
     229	        new_rules: list[RuleInfo] = []
     230	        removed_rules: list[str] = []
     231	
     232	        # current state
     233	        try:
     234	            info = self.rule_details(rule_uuid)
     235	        except Exception as exc:
     236	            logging.error("Failed to fetch rule details for %s: %s", rule_uuid, exc)
     237	            return [], []
     238	
     239	        # previous state in local DB
     240	        prev = db.query(RuleDB).filter_by(firewall_rule_id=rule_uuid).first()
     241	
     242	        if not info:
     243	            # rule disabled or removed
     244	            if prev:
     245	                removed_rules.append(rule_uuid)
     246	                return new_rules, removed_rules
     247	            
     248	        # rule enabled or added
     249	        new_rules.append(info)
     250	        if prev:
     251	            # existing rule: check for edits
     252	            alias = db.query(AliasDB).get(prev.dest_alias_id)
     253	            prev_service = alias.service_name if alias else None
     254	            if (
     255	                prev.action != info["action"] or
     256	                prev.src_ip != info["src_ip"] or
     257	                prev_service != info["service_name"]
     258	            ):
     259	                # treat as update: remove old then add new
     260	                removed_rules.append(rule_uuid)
     261	
     262	        return new_rules, removed_rules


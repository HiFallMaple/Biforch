      92	@app.post("/aliases", response_model=AliasOut)
      93	def create_alias(body: AliasIn, backend=Depends(get_backend), db: Session = Depends(get_db)) -> AliasOut:  # noqa: E501
      94	    alias_uuid = backend.create_alias(body.service_name)
      95	    obj = AliasDB(id=alias_uuid, service_name=body.service_name)
      96	    db.add(obj)
      97	    db.commit()
      98	    return AliasOut(id=obj.id, service_name=obj.service_name)

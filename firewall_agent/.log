------------------------------ firewall_agent/services/sync.py ------------------------------
       1	"""Business logic – reconcile remote firewall rules with local database and Core."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	from typing import Dict, List, Tuple
       6	
       7	from sqlalchemy.orm import Session
       8	
       9	from ..backends import backend
      10	from ..clients.core import CoreClient
      11	from ..config import settings
      12	from ..dependencies import get_core_client
      13	from ..models import AliasDB, RuleDB
      14	
      15	
      16	def _translate_action(raw_action: str) -> str:
      17	    """Map raw OPNsense value → Core contract (pass/block)."""
      18	    return settings.ACTION_MAP.get(raw_action, "block")
      19	
      20	
      21	def _collect_remote(db: Session) -> Tuple[List[Dict], List[Dict]]:
      22	    """Fetch remote rules and decide which ones to add/remove locally."""
      23	    new_rules: List[Dict] = []
      24	    removed_rules: List[Dict] = []
      25	
      26	    rows = backend.list_rules()
      27	
      28	    for row in rows:
      29	        uuid_fw = row["uuid"]
      30	        enabled = row["enabled"] == "1"
      31	        details = backend.rule_details(uuid_fw)
      32	
      33	        raw_action = next(k for k, v in details["action"].items() if v["selected"] == 1)
      34	        action = _translate_action(raw_action)
      35	
      36	        src_ip = details["source_net"]
      37	        dest = details["destination_net"]
      38	        if not dest.startswith(settings.PREFIX):
      39	            continue  # not managed by Biforch
      40	        service_name = dest[len(settings.PREFIX):]
      41	
      42	        alias = db.query(AliasDB).filter_by(service_name=service_name).first()
      43	        if not alias:
      44	            continue  # we do not know this service (yet)
      45	
      46	        existing = db.query(RuleDB).filter_by(firewall_rule_uuid=uuid_fw).first()
      47	
      48	        if enabled and not existing:
      49	            db.add(
      50	                RuleDB(
      51	                    firewall_rule_uuid=uuid_fw,
      52	                    action=action,
      53	                    src_ip=src_ip,
      54	                    dest_alias_id=alias.id,
      55	                )
      56	            )
      57	            new_rules.append({
      58	                "firewall_rule_uuid": uuid_fw,
      59	                "action": action,
      60	                "ip": src_ip,
      61	                "service": service_name,
      62	            })
      63	        elif not enabled and existing:
      64	            db.delete(existing)
      65	            removed_rules.append({"firewall_rule_uuid": uuid_fw})
      66	
      67	    return new_rules, removed_rules
      68	
      69	
      70	def sync_firewall(db: Session) -> None:
      71	    """High‑level sync: fetch → diff → commit → notify Core."""
      72	    core: CoreClient = get_core_client(db)
      73	    try:
      74	        new_rules, removed_rules = _collect_remote(db)
      75	        if new_rules or removed_rules:
      76	            db.commit()
      77	            logging.info("Firewall sync: +%s  -%s", len(new_rules), len(removed_rules))
      78	            _notify_core(core, new_rules, removed_rules)
      79	    except Exception as exc:  # noqa: BLE001
      80	        logging.error("Firewall sync failed: %s", exc)
      81	    finally:
      82	        db.close()
      83	
      84	
      85	def _notify_core(core: CoreClient, new_rules: List[Dict], removed_rules: List[Dict]) -> None:
      86	    for rule in new_rules:
      87	        try:
      88	            core.create_rule(**rule)
      89	        except Exception as exc:  # noqa: BLE001
      90	            logging.warning("Failed to notify Core (create): %s", exc)
      91	    for rule in removed_rules:
      92	        try:
      93	            core.delete_rule(rule["firewall_rule_uuid"])
      94	        except Exception as exc:  # noqa: BLE001
      95	            logging.warning("Failed to notify Core (delete): %s", exc)


      20	    id: int
      21	    type: str
      22	    data: str
      23	    src_ip: str
      24	    secret: str
      25	    created_at: str
      26	
      27	
      28	@dataclass
      29	class PendingApprove:
      30	    id: int
      31	    status: str
      32	    entity_id: int | None
      33	
      34	
      35	@dataclass
      36	class Service:
      37	    id: int

       1	"""OPNsense backend – wraps REST API calls used by the agent."""
       2	from __future__ import annotations
       3	
       4	import logging
       5	from typing import Any, Dict, List
       6	
       7	import requests
       8	
       9	from ..config import settings
      10	
      11	
      12	class OPNsenseBackend:
      13	    """Concrete implementation of :class:`FirewallBackend`."""
      14	
      15	    base_url: str = str(settings.REMOTE_URL).rstrip("/")
      16	    auth: tuple[str, str] = (settings.API_KEY, settings.API_SECRET)
      17	
      18	    # ----------------------------------------------------------- Aliases
      19	    def create_alias(self, name: str) -> str:
      20	        payload = {
      21	            "alias": {
      22	                "enabled": "1",
      23	                "name": f"{settings.PREFIX}{name}",
      24	                "type": "host"
      25	            }
      26	        }
      27	        resp = requests.post(
      28	            f"{self.base_url}/api/firewall/alias/add_item",
      29	            auth=self.auth,
      30	            json=payload,
      31	            timeout=settings.TIMEOUT,
      32	        )
      33	        try:
      34	            data = resp.json()
      35	            logging.debug(f"OPNsense alias/add_item response JSON: {data}")
      36	            resp.raise_for_status()
      37	        except Exception as exc:  # noqa: BLE001
      38	            logging.error("OPNsense alias create failed: %s", exc)
      39	            logging.error(f"Error during alias creation: status={resp.status_code}, text={resp.text}")
      40	            raise
      41	
      42	        # Use INFO level so it's visible under default settings
      43	        logging.info("OPNsense alias response: %s", data)
      44	
      45	        # Adjust conditions based on actual API return structure
      46	        uuid = data.get("uuid") or data.get("alias", {}).get("uuid")
      47	        if data.get("result") != "saved" or not uuid:
      48	            msg = f"Unexpected response from OPNsense alias/add_item: {data}"
      49	            logging.error(msg)
      50	            raise RuntimeError(msg)
      51	        return uuid
      52	
      53	    def delete_alias(self, uuid: str) -> None:
      54	        """
      55	        Delete an existing alias by UUID.
      56	        Raises an exception if the operation fails.
      57	        """
      58	        resp = requests.post(
      59	            f"{self.base_url}/api/firewall/alias/del_item/{uuid}",
      60	            auth=self.auth,
      61	            timeout=settings.TIMEOUT,
      62	        )
      63	        resp.raise_for_status()
      64	
      65	    # ------------------------------------------------------------ Rules
      66	    def list_rules(self) -> List[Dict[str, Any]]:
      67	        resp = requests.get(
      68	            f"{self.base_url}/api/firewall/filter/search_rule",
      69	            auth=self.auth,
      70	            timeout=settings.TIMEOUT,
      71	        )
      72	        resp.raise_for_status()
      73	        return resp.json().get("rows", [])
      74	
      75	    def rule_details(self, uuid: str) -> Dict[str, Any]:
      76	        resp = requests.get(
      77	            f"{self.base_url}/api/firewall/filter/get_rule/{uuid}",
      78	            auth=self.auth,
      79	            timeout=settings.TIMEOUT,
      80	        )
      81	        resp.raise_for_status()
      82	        return resp.json().get("rule", {})


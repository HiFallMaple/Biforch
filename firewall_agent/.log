       9	
      10	from pydantic import AnyHttpUrl, Field, ValidationError, field_validator
      11	from pydantic_settings import BaseSettings
      12	
      13	
      14	class Settings(BaseSettings):
      15	    """
      16	    Application settings for Biforch Firewall Agent.
      17	
      18	    - Loads settings from environment variables via pydantic-settings
      19	    - Validates values on startup (fails fast)
      20	    """
      21	    # External service URLs
      22	    CORE_URL: AnyHttpUrl = Field(..., description="URL of Biforch Core service")
      23	    REMOTE_URL: AnyHttpUrl = Field(..., description="Base URL of OPNsense firewall")
      24	    AGENT_URL: AnyHttpUrl = Field(..., description="Callback/API URL of this agent")
      25	
      26	    # Firewall authentication
      27	    API_KEY: str = Field(..., description="OPNsense API key")
      28	    API_SECRET: str = Field(..., description="OPNsense API secret")
      29	
      30	    # Alias configuration
      31	    PREFIX: str = Field(
      32	        "Biforch_",
      33	        min_length=1,
      34	        description="Prefix for OPNsense aliases"
      35	    )
      36	    AGENT_NAME: str = Field(..., description="Logical name of this agent")
      37	    CALLBACK_PATH: str = Field(
      38	        "/registrations",
      39	        description="Core callback endpoint path"
      40	    )
      41	
      42	    # Runtime behavior
      43	    TIMEOUT: int = Field(
      44	        10,
      45	        description="Outbound HTTP timeout in seconds",
      46	        gt=0
      47	    )
      48	    DB_PATH: Path = Field(
      49	        "./data/db.sqlite",
      50	        description="Path to SQLite database file"
      51	    )
      52	
      53	    # Server settings
      54	    INTERNAL_HOST: str = Field(
      55	        "0.0.0.0",
      56	        description="Uvicorn server host"
      57	    )
      58	    INTERNAL_PORT: int = Field(
      59	        8000,
      60	        description="Uvicorn server port",
      61	        ge=1,
      62	        le=65535
      63	    )
      64	    RELOAD: bool = Field(
      65	        False,
      66	        description="Enable Uvicorn auto-reload in development"
      67	    )
      68	
      69	    # Internal mappings
      70	    ACTION_MAP: Dict[str, str] = Field(
      71	        default_factory=lambda: {"pass": "pass", "block": "block", "reject": "block"},
      72	        description="Map OPNsense actions to Core contract"
      73	    )
      74	
      75	    # Logging
      76	    LOG_FILE_PATH: Path = Field(
      77	        "./data/.log",
      78	        description="Path to log file"
      79	    )
      80	
      81	    # Pydantic settings
      82	    model_config = {
      83	        "extra": "ignore",
      84	        "case_sensitive": True,
      85	        "env_file": ".env",
      86	    }
      87	
      88	    # ---------------------- Validators ----------------------
      89	    @field_validator("DB_PATH", mode="before")
      90	    @classmethod
      91	    def _validate_db_path(cls, v: str | Path) -> Path:
      92	        path = Path(v)
      93	        parent = path.parent
      94	        if not parent.exists():
      95	            raise ValueError(f"DB_PATH directory does not exist: {parent}")
      96	        return path
      97	
      98	    @field_validator("LOG_FILE_PATH", mode="before")
      99	    @classmethod
     100	    def _validate_log_file_path(cls, v: str | Path) -> Path:
     101	        path = Path(v)
     102	        parent = path.parent
     103	        if not parent.exists():
     104	            raise ValueError(f"LOG_FILE_PATH directory does not exist: {parent}")
     105	        return path
     106	
     107	    @field_validator("INTERNAL_HOST", mode="before")
     108	    @classmethod
     109	    def _validate_internal_host(cls, v: str) -> str:
     110	        try:
     111	            ipaddress.ip_address(v)
     112	        except ValueError:
     113	            raise ValueError(f"INTERNAL_HOST must be a valid IP address: {v}")
     114	        return v
     115	
     116	    @field_validator("PREFIX", mode="before")
     117	    @classmethod
     118	    def _validate_prefix(cls, v: str) -> str:
     119	        if not v or v.strip() == "":
     120	            raise ValueError("PREFIX cannot be empty")
     121	        return v
     122	
     123	    @field_validator("CALLBACK_PATH", mode="before")
     124	    @classmethod
     125	    def _validate_callback_path(cls, v: str) -> str:
     126	        if not v.startswith("/"):
     127	            raise ValueError("CALLBACK_PATH must start with '/'")
     128	        return v
     129	
     130	    @field_validator("ACTION_MAP", mode="before")
     131	    @classmethod
     132	    def _validate_action_map(cls, v: Dict[str, str]) -> Dict[str, str]:
     133	        if not isinstance(v, dict) or not v:
     134	            raise ValueError("ACTION_MAP must be a non-empty dict")
     135	        return v
     136	
     137	    @field_validator("RELOAD", mode="before")
     138	    @classmethod
     139	    def _parse_reload_flag(cls, v: bool | str) -> bool:
     140	        if isinstance(v, str):
     141	            val = v.lower()
     142	            if val in ("true", "1", "yes"):
     143	                return True
     144	            if val in ("false", "0", "no"):
     145	                return False
     146	            raise ValueError("RELOAD must be a boolean value")
     147	        return bool(v)
     148	
     149	
     150	LOGGING_CONFIG: dict = {

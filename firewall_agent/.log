     129	
     130	
     131	@app.delete("/aliases/{alias_id}")
     132	def delete_alias(
     133	    alias_id: str,
     134	    backend=Depends(get_backend),
     135	    db: Session = Depends(get_db),
     136	):
     137	    """
     138	    Delete an existing service-alias:
     139	      1) attempt to delete it on the firewall backend,
     140	      2) remove it from the local DB.
     141	    """
     142	    alias = db.get(AliasDB, alias_id)
     143	    if not alias:
     144	        raise HTTPException(404, "alias not found")
     145	
     146	    # try to remove it on the external firewall
     147	    try:
     148	        if hasattr(backend, "delete_alias"):
     149	            backend.delete_alias(alias_id)
     150	        else:
     151	            # if your backend has a different delete method, call it here
     152	            pass
     153	    except Exception as exc:
     154	        logging.warning("Failed to delete alias on firewall: %s", exc)
     155	
     156	    # remove from local database
     157	    db.delete(alias)
     158	    db.commit()
     159	    return {}

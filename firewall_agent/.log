      48	class CoreClientError(Exception):
      49	    """Generic exception for CoreClient errors."""
      50	    pass
      51	
      52	
      53	class CoreClient:
      54	    def __init__(
      55	        self,
      56	        base_url: str,
      57	        admin_token: Optional[str] = None,
      58	        actor_token: Optional[str] = None,
      59	        timeout: int = 10,
      60	    ):
      61	        """
      62	        :param base_url: URL of Core service (e.g. http://localhost:8001)
      63	        :param admin_token: Bearer token for admin operations
      64	        :param actor_token: Bearer token for actor operations (firewall/proxy/discovery)
      65	        :param timeout: HTTP request timeout in seconds
      66	        """
      67	        self.base_url = base_url.rstrip('/')
      68	        self._admin_token = admin_token
      69	        self._actor_token = actor_token
      70	        self.timeout = timeout
      71	
      72	    def set_actor_token(self, token: str) -> None:
      73	        """Set token for actor (firewall/proxy/discovery) calls."""
      74	        self._actor_token = token
      75	
      76	    def _build_headers(self, admin: bool = False) -> Dict[str, str]:
      77	        headers: Dict[str, str] = {}
      78	        if admin:
      79	            if not self._admin_token:
      80	                raise CoreClientError(
      81	                    "Admin token is required for this operation")
      82	            headers['Authorization'] = f"Bearer {self._admin_token}"
      83	        else:
      84	            if not self._actor_token:
      85	                raise CoreClientError(
      86	                    "Actor token is required for this operation")
      87	            headers['Authorization'] = f"Bearer {self._actor_token}"
      88	        return headers
      89	
      90	    def _request(
      91	        self,
      92	        method: str,
      93	        path: str,
      94	        json: Optional[Dict[str, Any]] = None,
      95	        admin: bool = False,
      96	        auth: bool = True,
      97	    ) -> Any:
      98	        """
      99	        Internal helper to send HTTP requests to Core.
     100	
     101	        :param method: HTTP method
     102	        :param path: API path (prefixed with base_url)
     103	        :param json: JSON body
     104	        :param admin: whether to use admin token
     105	        :param auth: whether to include Authorization header
     106	        """
     107	        url = f"{self.base_url}{path}"
     108	        headers = self._build_headers(admin=admin) if auth else {}
     109	        resp = requests.request(
     110	            method, url, json=json, headers=headers, timeout=self.timeout
     111	        )
     112	        try:
     113	            resp.raise_for_status()
     114	        except Exception as exc:
     115	            logging.error(f"HTTP {method} {url} failed: {exc}, {resp.text}")
     116	            raise CoreClientError(f"{method} {url} failed: {resp.text}")
     117	        if resp.text:
     118	            return resp.json()
     119	        return None
     120	
     121	    # -----------------------------------------------------------------
     122	    # Registration (pending queue) – public endpoints, no auth required
     123	    # -----------------------------------------------------------------
     124	    def register_firewall(self, name: str, api_url: str) -> PendingRequest:
     125	        """Enqueue a firewall registration (returns request_id and secret). No token needed."""
     126	        data = self._request(
     127	            'POST',
     128	            '/firewall',
     129	            json={'name': name, 'api_url': api_url},
     130	            admin=False,
     131	            auth=False,
     132	        )
     133	        return PendingRequest(**data)
     134	
     135	    def register_reverse_proxy(
     136	        self, name: str, ip: str, ports: List[int], api_url: str
     137	    ) -> PendingRequest:
     138	        """Enqueue a reverse-proxy registration. No token needed."""
     139	        data = self._request(
     140	            'POST',
     141	            '/reverse_proxy',
     142	            json={'name': name, 'ip': ip, 'ports': ports, 'api_url': api_url},
     143	            admin=False,
     144	            auth=False,
     145	        )
     146	        return PendingRequest(**data)
     147	
     148	    def register_service_discovery(
     149	        self, name: str, bind_reverse_proxy_id: int, api_url: str
     150	    ) -> PendingRequest:
     151	        """Enqueue a service-discovery registration. No token needed."""
     152	        data = self._request(
     153	            'POST',
     154	            '/service_discovery',
     155	            json={
     156	                'name': name,
     157	                'bind_reverse_proxy_id': bind_reverse_proxy_id,
     158	                'api_url': api_url,
     159	            },
     160	            admin=False,
     161	            auth=False,
     162	        )
     163	        return PendingRequest(**data)
     164	
     165	    # -----------------------------------------------------------------
     166	    # Admin: pending operations
     167	    # -----------------------------------------------------------------
     168	    def list_pending(self) -> List[PendingItem]:
     169	        """List all pending registration requests (admin only)."""
     170	        items = self._request('GET', '/pending_registrations', admin=True)
     171	        return [PendingItem(**i) for i in items]
     172	
     173	    def approve_pending(self, request_id: int) -> PendingApprove:
     174	        """Approve a pending request by ID (admin only)."""
     175	        data = self._request(
     176	            'PATCH',
     177	            f'/pending_registrations/{request_id}',
     178	            json={'action': 'approve'},
     179	            admin=True,
     180	        )
     181	        return PendingApprove(**data)
     182	
     183	    def reject_pending(self, request_id: int) -> PendingApprove:
     184	        """Reject a pending request by ID (admin only)."""
     185	        data = self._request(
     186	            'PATCH',
     187	            f'/pending_registrations/{request_id}',
     188	            json={'action': 'reject'},
     189	            admin=True,
     190	        )
     191	        return PendingApprove(**data)
     192	
     193	    # -----------------------------------------------------------------
     194	    # Admin: delete approved entities
     195	    # -----------------------------------------------------------------
     196	    def delete_firewall(self, fw_id: int) -> None:
     197	        """Delete a registered firewall (admin only)."""
     198	        self._request('DELETE', f'/firewall/{fw_id}', admin=True)
     199	
     200	    def delete_reverse_proxy(self, rp_id: int) -> None:

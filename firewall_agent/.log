     251	# monitor_firewall and __main__ entrypoint
     252	def test_monitor_firewall_runs(monkeypatch):
     253	    calls = []
     254	    monkeypatch.setattr(firewall_agent, "sync_firewall_rules", lambda: calls.append(1))
     255	    stop_event = threading.Event()
     256	    t = threading.Thread(target=monitor_firewall, kwargs={"interval": 0.01, "stop_event": stop_event})
     257	    t.start()
     258	    time.sleep(0.05)
     259	    stop_event.set()
     260	    t.join()
     261	    assert len(calls) >= 2


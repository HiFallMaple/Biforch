      72	        ).raise_for_status()
      73	
      74	
      75	def create_policy():
      76	    url = f"{REMOTE_URL}/api/v2/cmdb/firewall/policy"
      77	    payload = {
      78	        "name":     POLICY_NAME,
      79	        "srcintf":  [{"name": INTERFACE}],
      80	        "dstintf":  [{"name": INTERFACE}],
      81	        "action":   "accept",
      82	        "srcaddr":  [{"name": SRC_ADDR_NAME}],
      83	        "dstaddr":  [{"name": DST_GROUP_NAME}],
      84	        "schedule": "always",
      85	        "service":  [{"name": "ALL"}],
      86	        "nat":      "enable"  # ← 字串 enable
      87	    }
      88	
      89	    print("📤 發送 Payload:")
      90	    print(json.dumps(payload, indent=2))
      91	
      92	    resp = requests.post(
      93	        url, headers=headers, params=params,
      94	        json=payload, verify=False
      95	    )
      96	    if resp.status_code == 200:
      97	        print(f"✅ 防火牆規則建立成功: {POLICY_NAME}")
      98	    else:
      99	        print(f"❌ 建立失敗 {resp.status_code}: {resp.text}")
     100	
     101	
     102	if __name__ == "__main__":
     103	    try:

      80	# Reverse-Proxy API CRUD and validation
      81	def test_reverse_proxy_crud_and_validation(client):
      82	    rp_uuid = fake_uuid("rp")
      83	    valid_payload = {
      84	        "uuid": rp_uuid,
      85	        "name": "rp1",
      86	        "ip": "1.2.3.4",
      87	        "ports": [80, 443],
      88	        "allowed_ips": ["0.0.0.0/0"],
      89	    }
      90	
      91	    resp = client.post("/reverse_proxies", json=valid_payload)
      92	    assert resp.status_code == 200
      93	
      94	    resp = client.post("/reverse_proxies", json=valid_payload)
      95	    assert resp.status_code == 400
      96	
      97	    invalid_cases = [
      98	        {"name": None},
      99	        {"ip": "bad"},
     100	        {"ports": []},
     101	        {"allowed_ips": []},
     102	    ]
     103	    for override in invalid_cases:
     104	        payload = {**valid_payload, "uuid": fake_uuid("rp"), **override}
     105	        r = client.post("/reverse_proxies", json=payload)
     106	        assert r.status_code == 422
     107	
     108	    assert client.put("/reverse_proxies/notfound", json=valid_payload).status_code == 404
     109	
     110	    updated_payload = {**valid_payload, "name": "rp2", "ip": "2.2.2.2", "ports": [8080], "allowed_ips": ["10.0.0.0/8"]}
     111	    r = client.put(f"/reverse_proxies/{rp_uuid}", json=updated_payload)
     112	    assert r.status_code == 200
     113	    rp = client.get("/reverse_proxies").json()[0]
     114	    assert rp["name"] == "rp2"
     115	
     116	    assert client.delete("/reverse_proxies/none").status_code == 404
     117	
     118	    assert client.delete(f"/reverse_proxies/{rp_uuid}").status_code == 200
     119	    assert client.get("/reverse_proxies").json() == []

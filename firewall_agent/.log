       1	"""OPNsense backend – wraps REST API calls used by the agent."""
       2	from __future__ import annotations
       3	
       4	from typing import Any
       5	
       6	import requests
       7	from requests import Response
       8	from sqlalchemy.orm import Session
       9	
      10	from ..config import logging, settings
      11	from .base import FirewallBackend
      12	from .types import Action, RuleInfo
      13	
      14	
      15	class OPNsenseBackend(FirewallBackend):
      16	    """Concrete implementation for the OPNsense firewall engine."""
      17	
      18	    def __init__(self) -> None:
      19	        # Normalise trailing slash to avoid duplicate // when joining paths
      20	        self.base: str = str(settings.REMOTE_URL).rstrip("/")
      21	        self.auth: tuple[str, str] = (
      22	            settings.OPNSENSE_API_KEY,
      23	            settings.OPNSENSE_API_SECRET,
      24	        )
      25	        self.timeout: int = settings.TIMEOUT
      26	
      27	    # ---------------------------------------------------------------------
      28	    # Internal helpers
      29	    # ---------------------------------------------------------------------
      30	    def _req(self, method: str, path: str, **kw: Any) -> Response:
      31	        """Thin wrapper around *requests* with built‑in defaults & HTTP check."""
      32	        url = f"{self.base}{path}"
      33	        kw.setdefault("auth", self.auth)
      34	        kw.setdefault("timeout", self.timeout)
      35	        # A large share of on‑prem OPNsense boxes are self‑signed; be pragmatic
      36	        kw.setdefault("verify", False)
      37	
      38	        resp = requests.request(method.upper(), url, **kw)
      39	        if resp.status_code not in (200, 201):
      40	            logging.error("OPNsense API error %s %s: %s", method.upper(), url, resp.text)
      41	            resp.raise_for_status()
      42	        return resp
      43	
      44	    @staticmethod
      45	    def _assert_success(data: dict[str, Any], *, op: str) -> None:
      46	        """Raise *RuntimeError* if the JSON body does not represent success."""
      47	        if data.get("result") != "saved":
      48	            raise RuntimeError(f"OPNsense {op} failed – payload: {data}")
      49	
      50	    # ------------------------------------------------------------------ Alias
      51	    def create_alias(self, name: str) -> str:
      52	        """Create an address alias and return its UUID (or raise)."""
      53	        payload = {
      54	            "alias": {
      55	                "enabled": "1",
      56	                "name": name,
      57	                "type": "host",
      58	            }
      59	        }
      60	        data = self._req("post", "/api/firewall/alias/add_item", json=payload).json()
      61	        self._assert_success(data, op="create_alias")
      62	
      63	        uuid = data.get("uuid") or data.get("alias", {}).get("uuid")
      64	        if not uuid:
      65	            raise RuntimeError(f"OPNsense create_alias did not return UUID – payload: {data}")
      66	
      67	        logging.info("[opnsense] alias created – name=%s uuid=%s", name, uuid)
      68	        return uuid
      69	
      70	    def delete_alias(self, alias_id: str) -> None:
      71	        """Delete an existing alias by UUID."""
      72	        data = self._req("post", f"/api/firewall/alias/del_item/{alias_id}").json()
      73	        self._assert_success(data, op="delete_alias")
      74	        logging.info("[opnsense] alias deleted – alias_id=%s", alias_id)
      75	
      76	    # ------------------------------------------------------------------ Rules
      77	    def list_rules(self) -> dict[str, RuleInfo]:
      78	        """Return the table obtained from */firewall/filter/search_rule*."""
      79	        data = self._req("get", "/api/firewall/filter/search_rule").json()
      80	        rows: list[dict[str, Any]] = data.get("rows", [])
      81	        rules: dict[str, RuleInfo] = dict()
      82	        for r in rows:
      83	            if r["enabled"] != "1":
      84	                logging.debug(f"rule_id: {r['uuid']} is disabled, skipping")
      85	                continue
      86	            rule: RuleInfo = self.rule_details(r["uuid"])
      87	            if rule is not None:
      88	                rules[r["uuid"]] = rule
      89	        logging.debug(f"[opnsense] list_rules → {len(rules)} rows")
      90	        return rules
      91	
      92	    def rule_details(self, rule_id: str) -> RuleInfo | None:
      93	        """Fetch details of a single rule identified by *rule_id*."""
      94	        data = self._req("get", f"/api/firewall/filter/get_rule/{rule_id}").json()
      95	        rule: dict[str, Any] = data.get("rule", {})
      96	        if not rule:
      97	            raise RuntimeError(f"OPNsense rule_details – no rule for rule_id {rule_id}: {data}")
      98	        if rule["enabled"] != "1":
      99	            logging.debug(f"rule_id: {rule_id} is disabled, skipping")
     100	            return None  # Rule is disabled, return None
     101	        if not rule["destination_net"].startswith(settings.PREFIX):
     102	            logging.debug(f"destination_net %s does not start with PREFIX {settings.PREFIX}, skipping")
     103	            return None  #destination_net is not start with PREFIX, return None
     104	        
     105	        action: Action = next(k for k, v in rule["action"].items() if v["selected"])
     106	        return RuleInfo(
     107	            uuid=rule_id,
     108	            action=action,
     109	            src_ip=rule["source_net"],
     110	            service_name=rule["destination_net"][len(settings.PREFIX):],
     111	        )
     112	
     113	    def webhooks_rules(
     114	        self,
     115	        db: Session,
     116	        payload: dict,
     117	    ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
     118	        """
     119	        Not implemented for OPNsense backend.
     120	
     121	        Raises:
     122	            NotImplementedError: always.
     123	        """
     124	        raise NotImplementedError(
     125	            "webhooks_rules() is not implemented for OPNsense backend"
     126	        )


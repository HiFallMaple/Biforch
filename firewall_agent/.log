       4	"""
       5	Command-line interface for Biforch Firewall Agent.
       6	Provides commands to enqueue registration with Biforch Core
       7	and to start the API server.
       8	After registration, stores received UUID and token in local database.
       9	"""
      10	import logging
      11	import threading
      12	
      13	import typer
      14	import uvicorn
      15	from fastapi import FastAPI, HTTPException
      16	from pydantic import BaseModel
      17	from typing import Dict, Literal, Optional
      18	
      19	from .config import settings
      20	from .clients.core import CoreClient
      21	from .database import SessionLocal  # This is where the session is created
      22	from .models import AgentCredentials
      23	
      24	app = typer.Typer(help="Biforch Firewall Agent CLI")
      25	
      26	
      27	class RegistrationCallback(BaseModel):
      28	    """
      29	    Model for Core's callback payload.
      30	    Core will POST {"secret": "...", "action": "approve|reject", "uuid": "...", "token": "..."}.
      31	    """
      32	    secret: str
      33	    action: Literal["approve", "reject"]
      34	    uuid: Optional[str]
      35	    token: Optional[str]
      36	
      37	
      38	@app.command()
      39	def init():
      40	    """
      41	    1) If already registered, report existing credentials and exit.
      42	    2) Launch temporary FastAPI server to receive Core's callback.
      43	    3) Enqueue a firewall registration request to Core (using settings.CORE_URL).
      44	    4) Block until Core calls back, then store credentials & exit.
      45	    """
      46	    db = SessionLocal()  # This is where we manually create the session
      47	    try:
      48	        # Check for existing credentials
      49	        existing = db.query(AgentCredentials).first()
      50	        if existing:
      51	            logging.info(f"🔒 Already registered:")
      52	            logging.info(f"\tUUID: {existing.uuid}")
      53	            logging.info(f"\tToken: {existing.token}")
      54	            return
      55	
      56	        callback_data: Dict[str, str] = {}
      57	        event = threading.Event()
      58	
      59	        # Build temporary FastAPI app for callback
      60	        server_app = FastAPI()
      61	
      62	        @server_app.post(settings.CALLBACK_PATH)
      63	        async def receive_callback(body: RegistrationCallback):
      64	            # Validate secret
      65	            if body.secret != callback_data.get("secret"):
      66	                raise HTTPException(400, "Invalid secret")
      67	            callback_data["action"] = body.action
      68	            # On approval, capture uuid and token
      69	            if body.action == "approve":
      70	                callback_data["uuid"] = body.uuid or ""
      71	                callback_data["token"] = body.token or ""
      72	            # Signal shutdown and notifying main thread
      73	            server.should_exit = True
      74	            event.set()
      75	            return {"status": "received"}
      76	
      77	        # Start Uvicorn server in background
      78	        config = uvicorn.Config(
      79	            server_app,
      80	            host=settings.INTERNAL_HOST,
      81	            port=settings.INTERNAL_PORT,
      82	            log_level="info",
      83	            lifespan="on"
      84	        )
      85	        server = uvicorn.Server(config)
      86	        thread = threading.Thread(target=server.run, daemon=True)
      87	        thread.start()
      88	        logging.info(
      89	            f"🔄 Waiting for Core callback at http://{settings.INTERNAL_HOST}:{settings.INTERNAL_PORT}{settings.CALLBACK_PATH} …"
      90	        )
      91	
      92	        # Enqueue registration with Core
      93	        client = CoreClient(base_url=str(settings.CORE_URL))
      94	        pending = client.register_firewall(
      95	            name=settings.AGENT_NAME,
      96	            api_url=str(settings.AGENT_URL),
      97	        )
      98	        callback_data["secret"] = pending.secret
      99	        logging.info(
     100	            f"📨 Sent registration → request_id={pending.request_id}, secret={pending.secret}"
     101	        )
     102	
     103	        # Block until callback arrives
     104	        event.wait()
     105	
     106	        # Shutdown server thread
     107	        thread.join(timeout=1)
     108	
     109	        # Report and store result
     110	        action = callback_data.get("action")
     111	        if action == "approve":
     112	            uuid_str = callback_data.get("uuid", "")
     113	            token_str = callback_data.get("token", "")
     114	            # Persist credentials in DB
     115	            db.add(AgentCredentials(uuid=uuid_str, token=token_str))
     116	            db.commit()
     117	            logging.info(f"✅ Registration approved!")
     118	            logging.info(f"\tUUID: {uuid_str}")
     119	            logging.info(f"\tToken: {token_str}")
     120	        else:
     121	            logging.error("❌ Registration was rejected by Core")
     122	    finally:
     123	        db.close()  # Close the session after usage
     124	
     125	
     126	@app.command()
     127	def serve():
     128	    """
     129	    Start the Biforch Firewall Agent API server
     130	    (which runs background syncs, etc.).
     131	    """
     132	    uvicorn.run(
     133	        f"{__package__}.api:app",
     134	        host=settings.INTERNAL_HOST,
     135	        port=settings.INTERNAL_PORT,
     136	        reload=settings.RELOAD,
     137	    )
     138	
     139	
     140	if __name__ == "__main__":
     141	    app()


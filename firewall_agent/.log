------------------------------ firewall_agent/services/sync.py ------------------------------
       1	"""Business logic – reconcile remote firewall rules with local database and Core."""
       2	from __future__ import annotations
       3	
       4	from sqlalchemy.orm import Session
       5	
       6	from ..backends import backend, RuleInfo
       7	from ..clients.core import CoreClient
       8	from ..clients.factory import get_core_client
       9	from ..config import logging
      10	from ..models import AliasDB, RuleDB
      11	
      12	
      13	def _collect_remote(db: Session) -> tuple[list[RuleInfo], list[str]]:
      14	    """Collect remote firewall rule diffs without modifying the database.
      15	
      16	    This function queries the firewall backend for all rules, then determines
      17	    which rules are newly enabled, which are disabled, and which existing rules
      18	    have changed. It does NOT write to the local database.
      19	
      20	    Args:
      21	        db (Session): SQLAlchemy database session.
      22	
      23	    Returns:
      24	        (list[dict], list[dict]): A pair of lists:
      25	        - new_rules: dicts with keys
      26	            'firewall_rule_id', 'action', 'ip', 'service'
      27	        - removed_rules: dicts with key 'firewall_rule_id'
      28	    """
      29	    new_rules: list[dict] = []
      30	    removed_rules: list[dict] = []
      31	
      32	    enabled_rules: dict[str, RuleInfo] = backend.list_rules()
      33	    # Map remote rules by id
      34	    enabled_ids: set[str] = set(enabled_rules.keys())
      35	    # Map local rules by id
      36	    local_rules = {r.firewall_rule_id: r for r in db.query(RuleDB).all()}
      37	    local_ids: set[str] = set(local_rules.keys())
      38	
      39	    # Added rules
      40	    for rule_id in enabled_ids - local_ids:
      41	        info = enabled_rules[rule_id]
      42	        new_rules.append(info)
      43	
      44	    # Removed rules
      45	    for rule_id in local_ids - enabled_ids:
      46	        removed_rules.append(rule_id)
      47	
      48	    # Modified rules: present in both but with changed attributes
      49	    for rule_id in enabled_ids & local_ids:
      50	        info = enabled_rules[rule_id]
      51	        local = local_rules[rule_id]
      52	        alias = db.query(AliasDB).get(local.dest_alias_id)
      53	        local_service = alias.service_name if alias else None
      54	        if (
      55	            info["action"] != local.action or
      56	            info["src_ip"] != local.src_ip or
      57	            info["service_name"] != local_service
      58	        ):
      59	            # treat modification as removal then addition
      60	            removed_rules.append(rule_id)
      61	            new_rules.append(info)
      62	
      63	    return new_rules, removed_rules
      64	
      65	
      66	def process_rules_change(
      67	    db: Session,
      68	    core: CoreClient,
      69	    new_rules: list[RuleInfo],
      70	    removed_rules: list[str],
      71	) -> None:
      72	    """Apply rule changes to the DB and notify Biforch Core.
      73	
      74	    This function writes all new rules into the local database, deletes all
      75	    removed rules, commits the transaction, and then calls the Core API to
      76	    reflect these changes.
      77	
      78	    Args:
      79	        db (Session): SQLAlchemy database session.
      80	        core (CoreClient): Core client instance for rule notifications.
      81	        new_rules (list[RuleInfo]): List of new rules to add.
      82	        removed_rules (list[str]): List of rule IDs to remove.
      83	    """
      84	    # 1) Update local database
      85	    # delete first, then insert new ones
      86	    # This ensures we don't have duplicates if the same rule is edited
      87	    for rule in removed_rules:
      88	        db.query(RuleDB).filter_by(
      89	            firewall_rule_id=rule
      90	        ).delete()
      91	
      92	    for rule in new_rules:
      93	        alias = db.query(AliasDB).filter_by(
      94	            service_name=rule["service_name"]
      95	        ).first()
      96	        db.add(RuleDB(
      97	            firewall_rule_id=rule["firewall_rule_id"],
      98	            action=rule["action"],
      99	            src_ip=rule["ip"],
     100	            dest_alias_id=alias.id,
     101	        ))
     102	
     103	    db.commit()
     104	    logging.info(
     105	        "Processed DB changes: +%d / -%d",
     106	        len(new_rules),
     107	        len(removed_rules),
     108	    )
     109	
     110	    # 2) Notify Core service
     111	    # delete first, then insert new ones
     112	    # This ensures we don't have duplicates if the same rule is edited
     113	    for rule in removed_rules:
     114	        try:
     115	            core.delete_rule(rule)
     116	        except Exception as exc:
     117	            logging.warning("Core delete_rule failed: %s", exc)
     118	
     119	    for rule in new_rules:
     120	        try:
     121	            core.create_rule(**rule)
     122	        except Exception as exc:
     123	            logging.warning("Core create_rule failed: %s", exc)
     124	
     125	
     126	def sync_firewall(db: Session) -> None:
     127	    """High-level sync: collect diffs then process changes.
     128	
     129	    This function is the entry point for both periodic sync and webhook-driven
     130	    sync. It fetches rule diffs via `_collect_remote` and then delegates
     131	    to `process_rules_change`.
     132	
     133	    Args:
     134	        db (Session): SQLAlchemy database session.
     135	    """
     136	    core = get_core_client(db)
     137	
     138	    try:
     139	        new_rules, removed_rules = _collect_remote(db)
     140	        if new_rules or removed_rules:
     141	            process_rules_change(db, core, new_rules, removed_rules)
     142	    except Exception as exc:
     143	        logging.error("Firewall sync failed: %s", exc)
     144	    finally:
     145	        db.close()


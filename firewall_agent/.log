     100	
     101	@app.delete("/aliases/{alias_id}")
     102	def delete_alias(
     103	    alias_id: str,
     104	    backend=Depends(get_backend),
     105	    db: Session = Depends(get_db),
     106	):
     107	    """
     108	    Delete an existing service-alias:
     109	      1) attempt to delete it on the firewall backend,
     110	      2) remove it from the local DB.
     111	    """
     112	    alias = db.get(AliasDB, alias_id)
     113	    if not alias:
     114	        raise HTTPException(404, "alias not found")
     115	
     116	    # try to remove it on the external firewall
     117	    try:
     118	        if hasattr(backend, "delete_alias"):
     119	            backend.delete_alias(alias_id)
     120	        else:
     121	            # if your backend has a different delete method, call it here
     122	            pass
     123	    except Exception as exc:
     124	        logging.warning("Failed to delete alias on firewall: %s", exc)
     125	
     126	    # remove from local database
     127	    db.delete(alias)
     128	    db.commit()
     129	    return {}
     130	
     131	
     132	# ------------------------------------------------------------------- Rules
     133	
     134	@app.get("/rules", response_model=List[RuleOut])
     135	def list_rules(db: Session = Depends(get_db)) -> List[RuleOut]:
     136	    rows = db.query(RuleDB).all()
     137	    res: List[RuleOut] = []
     138	    for r in rows:
     139	        alias = db.get(AliasDB, r.dest_alias_id)
     140	        res.append(
     141	            RuleOut(
     142	                id=r.id,
     143	                action=r.action,
     144	                src_ip=r.src_ip,
     145	                service_name=alias.service_name if alias else None,
     146	            )
     147	        )
     148	    return res

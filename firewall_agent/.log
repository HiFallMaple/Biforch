      44	# ---------------------------------------------------------------------
      45	# Client implementation
      46	# ---------------------------------------------------------------------
      47	
      48	
      49	class CoreClientError(Exception):
      50	    """Generic exception for CoreClient errors."""
      51	    pass
      52	
      53	
      54	class CoreClient:
      55	    def __init__(
      56	        self,
      57	        base_url: str,
      58	        admin_token: str | None = None,
      59	        actor_token: str | None = None,
      60	        timeout: int = 10,
      61	    ):
      62	        """
      63	        :param base_url: URL of Core service (e.g. http://localhost:8001)
      64	        :param admin_token: Bearer token for admin operations
      65	        :param actor_token: Bearer token for actor operations (firewall/proxy/discovery)
      66	        :param timeout: HTTP request timeout in seconds
      67	        """
      68	        self.base_url = base_url.rstrip('/')
      69	        self._admin_token = admin_token
      70	        self._actor_token = actor_token
      71	        self.timeout = timeout
      72	
      73	    def set_actor_token(self, token: str) -> None:
      74	        """Set token for actor (firewall/proxy/discovery) calls."""
      75	        self._actor_token = token
      76	
      77	    def _build_headers(self, admin: bool = False) -> dict[str, str]:
      78	        headers: dict[str, str] = {}
      79	        if admin:
      80	            if not self._admin_token:
      81	                raise CoreClientError(
      82	                    "Admin token is required for this operation")
      83	            headers['Authorization'] = f"Bearer {self._admin_token}"
      84	        else:
      85	            if not self._actor_token:
      86	                raise CoreClientError(
      87	                    "Actor token is required for this operation")
      88	            headers['Authorization'] = f"Bearer {self._actor_token}"
      89	        return headers
      90	
      91	    def _request(
      92	        self,
      93	        method: str,
      94	        path: str,
      95	        json: dict[str, Any] | None = None,
      96	        admin: bool = False,
      97	        auth: bool = True,
      98	    ) -> Any:
      99	        """
     100	        Internal helper to send HTTP requests to Core.
     101	
     102	        :param method: HTTP method
     103	        :param path: API path (prefixed with base_url)
     104	        :param json: JSON body
     105	        :param admin: whether to use admin token
     106	        :param auth: whether to include Authorization header
     107	        """
     108	        url = f"{self.base_url}{path}"
     109	        headers = self._build_headers(admin=admin) if auth else {}
     110	        resp = requests.request(
     111	            method, url, json=json, headers=headers, timeout=self.timeout
     112	        )
     113	        try:
     114	            resp.raise_for_status()
     115	        except Exception as exc:
     116	            logging.error(f"HTTP {method} {url} failed: {exc}, {resp.text}")
     117	            raise CoreClientError(f"{method} {url} failed: {resp.text}")
     118	        if resp.text:
     119	            return resp.json()
     120	        return None
     121	
     122	    # -----------------------------------------------------------------
     123	    # Registration (pending queue) – public endpoints, no auth required
     124	    # -----------------------------------------------------------------
     125	    def register_firewall(self, name: str, api_url: str) -> PendingRequest:
     126	        """Enqueue a firewall registration (returns request_id and secret). No token needed."""
     127	        data = self._request(
     128	            'POST',
     129	            '/firewall',
     130	            json={'name': name, 'api_url': api_url},
     131	            admin=False,
     132	            auth=False,
     133	        )
     134	        return PendingRequest(**data)
     135	
     136	    def register_reverse_proxy(
     137	        self, name: str, ip: str, ports: list[int], api_url: str
     138	    ) -> PendingRequest:
     139	        """Enqueue a reverse-proxy registration. No token needed."""
     140	        data = self._request(
     141	            'POST',
     142	            '/reverse_proxy',
     143	            json={'name': name, 'ip': ip, 'ports': ports, 'api_url': api_url},
     144	            admin=False,
     145	            auth=False,
     146	        )
     147	        return PendingRequest(**data)
     148	
     149	    def register_service_discovery(
     150	        self, name: str, bind_reverse_proxy_id: int, api_url: str
     151	    ) -> PendingRequest:
     152	        """Enqueue a service-discovery registration. No token needed."""
     153	        data = self._request(
     154	            'POST',
     155	            '/service_discovery',
     156	            json={
     157	                'name': name,
     158	                'bind_reverse_proxy_id': bind_reverse_proxy_id,
     159	                'api_url': api_url,
     160	            },
     161	            admin=False,
     162	            auth=False,
     163	        )
     164	        return PendingRequest(**data)
     165	
     166	    # -----------------------------------------------------------------
     167	    # Admin: pending operations
     168	    # -----------------------------------------------------------------
     169	    def list_pending(self) -> list[PendingItem]:
     170	        """List all pending registration requests (admin only)."""
     171	        items = self._request('GET', '/pending_registrations', admin=True)
     172	        return [PendingItem(**i) for i in items]
     173	
     174	    def approve_pending(self, request_id: int) -> PendingApprove:
     175	        """Approve a pending request by ID (admin only)."""
     176	        data = self._request(
     177	            'PATCH',
     178	            f'/pending_registrations/{request_id}',
     179	            json={'action': 'approve'},
     180	            admin=True,
     181	        )
     182	        return PendingApprove(**data)
     183	
     184	    def reject_pending(self, request_id: int) -> PendingApprove:
     185	        """Reject a pending request by ID (admin only)."""
     186	        data = self._request(
     187	            'PATCH',
     188	            f'/pending_registrations/{request_id}',
     189	            json={'action': 'reject'},
     190	            admin=True,
     191	        )
     192	        return PendingApprove(**data)
     193	
     194	    # -----------------------------------------------------------------
     195	    # Admin: delete approved entities
     196	    # -----------------------------------------------------------------
     197	    def delete_firewall(self, fw_id: int) -> None:
     198	        """Delete a registered firewall (admin only)."""
     199	        self._request('DELETE', f'/firewall/{fw_id}', admin=True)
     200	
     201	    def delete_reverse_proxy(self, rp_id: int) -> None:
     202	        """Delete a registered reverse proxy (admin only)."""
     203	        self._request('DELETE', f'/reverse_proxy/{rp_id}', admin=True)
     204	
     205	    def delete_service_discovery(self, sd_id: int) -> None:
     206	        """Delete a registered service discovery (admin only)."""
     207	        self._request('DELETE', f'/service_discovery/{sd_id}', admin=True)
     208	
     209	    # -----------------------------------------------------------------
     210	    # Actor: manage services
     211	    # -----------------------------------------------------------------
     212	    def create_service(self, service: str, reverse_proxy_uuid: str) -> Service:
     213	        """Create a new service (actor token required)."""
     214	        data = self._request(
     215	            'POST',
     216	            '/service',
     217	            json={'service': service, 'reverse_proxy_uuid': reverse_proxy_uuid},
     218	            admin=False,
     219	        )
     220	        return Service(**data)
     221	
     222	    def delete_service(self, service_id: int) -> None:
     223	        """Delete an existing service (actor token required)."""
     224	        self._request('DELETE', f'/service/{service_id}', admin=False)
     225	
     226	    # -----------------------------------------------------------------
     227	    # Actor: manage rules (firewall actor)
     228	    # -----------------------------------------------------------------
     229	    def create_rule(
     230	        self, firewall_rule_id: str, action: str, ip: str, service: str
     231	    ) -> Rule:
     232	        """Create a new firewall rule (firewall actor token required)."""
     233	        data = self._request(
     234	            'POST',
     235	            '/rules',
     236	            json={
     237	                'firewall_rule_id': firewall_rule_id,
     238	                'action': action,
     239	                'ip': ip,
     240	                'service': service,
     241	            },
     242	            admin=False,
     243	        )
     244	        return Rule(**data)
     245	
     246	    def delete_rule(self, firewall_rule_id: str) -> None:
     247	        """Delete a firewall rule (firewall actor token required)."""
     248	        self._request('DELETE', f'/rules/{firewall_rule_id}', admin=False)


       1	from fastapi import HTTPException
       2	from sqlalchemy.orm import Session
       3	
       4	from ..config import settings
       5	from ..models import AgentCredentials
       6	from .core import CoreClient
       7	
       8	# module-level caches for singletons
       9	_core_client: CoreClient = None
      10	
      11	
      12	def get_core_client(db: Session) -> CoreClient:
      13	    """
      14	    Create a CoreClient using the stored actor token from the database.
      15	    Raises HTTPException if no token is available.
      16	
      17	    Args:
      18	        db (Session): The SQLAlchemy session to retrieve credentials.
      19	
      20	    Returns:
      21	        CoreClient: The CoreClient instance initialized with the actor token.
      22	
      23	    Raises:
      24	        HTTPException: If no token is found for the agent in the database.
      25	    """
      26	
      27	    # Retrieve the agent's credentials from the local database
      28	    cred: AgentCredentials | None = db.query(AgentCredentials).first()
      29	    token: str | None = cred.token if cred else None
      30	    global _core_client
      31	
      32	    if not token:
      33	        raise HTTPException(
      34	            status_code=500, detail="Missing actor token: please register the agent first.")
      35	    
      36	    if _core_client is None:
      37	        _core_client = CoreClient(base_url=str(settings.CORE_URL), actor_token=token)
      38	
      39	    return _core_client

------------------------------ firewall_agent/cli.py ------------------------------
       1	#!/usr/bin/env python3
       2	# firewall_agent/cli.py
       3	
       4	"""
       5	Command-line interface for Biforch Firewall Agent.
       6	Provides commands to enqueue registration with Biforch Core
       7	and to start the API server.
       8	After registration, stores received UUID and token in local database.
       9	"""
      10	import threading
      11	from typing import Literal
      12	
      13	import typer
      14	import uvicorn
      15	from fastapi import FastAPI, HTTPException
      16	from pydantic import BaseModel
      17	
      18	from .clients.core import CoreClient
      19	from .config import logging, settings
      20	from .database import SessionLocal  # This is where the session is created
      21	from .models import AgentCredentials
      22	
      23	app = typer.Typer(help="Biforch Firewall Agent CLI")
      24	
      25	
      26	class RegistrationCallback(BaseModel):
      27	    """
      28	    Model for Core's callback payload.
      29	    Core will POST {"secret": "...", "action": "approve|reject", "uuid": "...", "token": "..."}.
      30	    """
      31	    secret: str
      32	    action: Literal["approve", "reject"]
      33	    uuid: str | None
      34	    token: str | None
      35	
      36	
      37	@app.command()
      38	def init():
      39	    """
      40	    1) If already registered, report existing credentials and exit.
      41	    2) Launch temporary FastAPI server to receive Core's callback.
      42	    3) Enqueue a firewall registration request to Core (using settings.CORE_URL).
      43	    4) Block until Core calls back, then store credentials & exit.
      44	    """
      45	    db = SessionLocal()  # This is where we manually create the session
      46	    try:
      47	        # Check for existing credentials
      48	        existing = db.query(AgentCredentials).first()
      49	        if existing:
      50	            logging.info("🔒 Already registered:")
      51	            logging.info(f"\tUUID: {existing.uuid}")
      52	            logging.info(f"\tToken: {existing.token}")
      53	            return
      54	
      55	        callback_data: dict[str, str] = {}
      56	        event = threading.Event()
      57	
      58	        # Build temporary FastAPI app for callback
      59	        server_app = FastAPI()
      60	
      61	        @server_app.post("/registrations")
      62	        async def receive_callback(body: RegistrationCallback):
      63	            # Validate secret
      64	            if body.secret != callback_data.get("secret"):
      65	                raise HTTPException(400, "Invalid secret")
      66	            callback_data["action"] = body.action
      67	            # On approval, capture uuid and token
      68	            if body.action == "approve":
      69	                callback_data["uuid"] = body.uuid or ""
      70	                callback_data["token"] = body.token or ""
      71	            # Signal shutdown and notifying main thread
      72	            server.should_exit = True
      73	            event.set()
      74	            return {"status": "received"}
      75	
      76	        # Start Uvicorn server in background
      77	        config = uvicorn.Config(
      78	            server_app,
      79	            host=settings.INTERNAL_HOST,
      80	            port=settings.INTERNAL_PORT,
      81	            log_level="info",
      82	            lifespan="on"
      83	        )
      84	        server = uvicorn.Server(config)
      85	        thread = threading.Thread(target=server.run, daemon=True)
      86	        thread.start()
      87	        logging.info(
      88	            f"🔄 Waiting for Core callback at http://{settings.INTERNAL_HOST}:{settings.INTERNAL_PORT}/registrations …"
      89	        )
      90	
      91	        # Enqueue registration with Core
      92	        client = CoreClient(base_url=str(settings.CORE_URL))
      93	        pending = client.register_firewall(
      94	            name=settings.AGENT_NAME,
      95	            api_url=str(settings.AGENT_URL),
      96	        )
      97	        callback_data["secret"] = pending.secret
      98	        logging.info(
      99	            f"📨 Sent registration → request_id={pending.request_id}, secret={pending.secret}"
     100	        )
     101	
     102	        # Block until callback arrives
     103	        event.wait()
     104	
     105	        # Shutdown server thread
     106	        thread.join(timeout=1)
     107	
     108	        # Report and store result
     109	        action = callback_data.get("action")
     110	        if action == "approve":
     111	            uuid_str = callback_data.get("uuid", "")
     112	            token_str = callback_data.get("token", "")
     113	            # Persist credentials in DB
     114	            db.add(AgentCredentials(uuid=uuid_str, token=token_str))
     115	            db.commit()
     116	            logging.info("✅ Registration approved!")
     117	            logging.info(f"\tUUID: {uuid_str}")
     118	            logging.info(f"\tToken: {token_str}")
     119	        else:
     120	            logging.error("❌ Registration was rejected by Core")
     121	    finally:
     122	        db.close()  # Close the session after usage
     123	
     124	
     125	@app.command()
     126	def serve():
     127	    """
     128	    Start the Biforch Firewall Agent API server
     129	    (which runs background syncs, etc.).
     130	    """
     131	    uvicorn.run(
     132	        f"{__package__}.api:app",
     133	        host=settings.INTERNAL_HOST,
     134	        port=settings.INTERNAL_PORT,
     135	        reload=settings.RELOAD,
     136	    )
     137	    
     138	
     139	@app.command("start")
     140	def start():
     141	    init()
     142	    serve()
     143	
     144	
     145	if __name__ == "__main__":
     146	    app()


     234	@app.delete(
     235	    "/firewall/{fw_id}",
     236	    dependencies=[Depends(verify_admin)],
     237	)
     238	def delete_firewall(fw_id: int, db: Session = Depends(get_db)):
     239	    fw = db.get(FirewallDB, fw_id)
     240	    if not fw:

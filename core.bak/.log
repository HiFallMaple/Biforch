     360	# ---------------------------------------------------------------------------
     361	# Agent auth (token from reverse-proxy or service-discovery)
     362	# ---------------------------------------------------------------------------
     363	security_agent = HTTPBearer()
     364	
     365	
     366	def auth_agent(
     367	    creds: HTTPAuthorizationCredentials = Depends(security_agent),
     368	    db: Session = Depends(get_db),
     369	) -> Union[ReverseProxyDB, ServiceDiscoveryDB]:
     370	    token = creds.credentials
     371	    agent = (
     372	        db.query(ReverseProxyDB).filter_by(token=token).first()
     373	        or db.query(ServiceDiscoveryDB).filter_by(token=token).first()
     374	    )
     375	    if not agent:
     376	        raise HTTPException(401, "Invalid agent token")
     377	    return agent

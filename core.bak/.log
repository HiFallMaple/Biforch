     247	# ---------------------------------------------------------------------------
     248	# Reverse-Proxy endpoints (admin only)
     249	# ---------------------------------------------------------------------------
     250	@app.post(
     251	    "/reverse_proxy",
     252	    response_model=ReverseProxyOut,
     253	    dependencies=[Depends(verify_admin)],
     254	)
     255	def create_reverse_proxy(body: ReverseProxyIn, db: Session = Depends(get_db)):
     256	    if db.query(ReverseProxyDB).filter_by(name=body.name).first():
     257	        raise HTTPException(400, "duplicate reverse-proxy name")
     258	
     259	    firewall = db.scalar(select(FirewallDB).limit(1))
     260	    if not firewall:
     261	        raise HTTPException(400, "No firewall registered yet")
     262	
     263	    rp_uuid = str(uuid.uuid4())
     264	    try:
     265	        resp = requests.post(
     266	            firewall.api_url.rstrip("/") + "/reverse_proxies",
     267	            json={
     268	                "uuid": rp_uuid,
     269	                "name": body.name,
     270	                "ip": body.ip,
     271	                "ports": body.ports,
     272	                "allowed_ips": ["0.0.0.0/0"],
     273	            },
     274	            timeout=TIMEOUT,
     275	        )
     276	        if resp.status_code != 200:
     277	            raise RuntimeError(f"firewall responded {resp.status_code}: {resp.text}")
     278	    except Exception as exc:
     279	        raise HTTPException(502, f"Failed to register with firewall: {exc}")
     280	
     281	    rp = ReverseProxyDB(
     282	        uuid=rp_uuid,
     283	        name=body.name,
     284	        ip=body.ip,
     285	        ports=",".join(map(str, body.ports)),
     286	        api_url=body.api_url,
     287	        token=gen_token(),
     288	    )
     289	    db.add(rp)
     290	    db.commit()
     291	    db.refresh(rp)
     292	    return ReverseProxyOut(id=rp.id, uuid=rp.uuid, token=rp.token)
     293	

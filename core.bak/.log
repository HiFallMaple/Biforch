     456	@app.post("/rules", response_model=RuleOut)
     457	def create_rule(body: RuleIn, db: Session = Depends(get_db)):
     458	    svc = db.query(ServiceDB).filter_by(name=body.service).first()
     459	    if not svc:
     460	        raise HTTPException(404, "service not registered")
     461	
     462	    rule = RuleDB(
     463	        firewall_rule_uuid=body.firewall_rule_uuid,
     464	        action=body.action,
     465	        ip=body.ip,
     466	        service_id=svc.id,
     467	    )
     468	    db.add(rule)
     469	    db.commit()
     470	    db.refresh(rule)
     471	
     472	    rp = svc.reverse_proxy
     473	    try:
     474	        requests.post(
     475	            f"{rp.api_url.rstrip('/')}/rules/{svc.id}",
     476	            json={"action": body.action, "ip": body.ip},
     477	            headers={"Authorization": f"Bearer {rp.token}"},
     478	            timeout=TIMEOUT,
     479	        ).raise_for_status()
     480	    except Exception as exc:
     481	        logging.warning("Failed to forward rule to proxy: %s", exc)
     482	
     483	    return RuleOut(firewall_rule_uuid=body.firewall_rule_uuid)

     216	# ---------------------------------------------------------------------------
     217	# Firewall endpoints (admin only)
     218	# ---------------------------------------------------------------------------
     219	@app.post(
     220	    "/firewall",
     221	    response_model=FirewallOut,
     222	    dependencies=[Depends(verify_admin)],
     223	)
     224	def create_firewall(body: FirewallIn, db: Session = Depends(get_db)):
     225	    if db.scalar(select(func.count()).select_from(FirewallDB)) > 0:
     226	        raise HTTPException(400, "Only one firewall can be registered")
     227	    fw = FirewallDB(name=body.name, api_url=body.api_url, token=gen_token())
     228	    db.add(fw)
     229	    db.commit()
     230	    db.refresh(fw)
     231	    return FirewallOut(id=fw.id, token=fw.token)
     232	

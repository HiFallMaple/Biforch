       8	def get_env_str(name: str) -> str:
       9	    """
      10	    Retrieve an environment variable or raise an error if missing.
      11	    """
      12	    value = os.getenv(name)
      13	    if not value:
      14	        raise RuntimeError(f"Environment variable '{name}' must be set")
      15	    return value
      16	
      17	
      18	def get_env_int(name: str) -> int:
      19	    """
      20	    Retrieve an environment variable as int or raise error if missing/invalid.
      21	    """
      22	    val_str = get_env_str(name)
      23	    try:
      24	        return int(val_str)
      25	    except ValueError:
      26	        raise RuntimeError(f"Environment variable '{name}' must be an integer, got '{val_str}'")
      27	
      28	# Required configuration variables
      29	DB_PATH = get_env_str("DB_PATH")
      30	TIMEOUT = get_env_int("TIMEOUT")
      31	ADMIN_TOKEN = get_env_str("ADMIN_TOKEN")


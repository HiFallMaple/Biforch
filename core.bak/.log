     383	@app.post("/service", response_model=ServiceOut)
     384	def create_service(
     385	    body: ServiceIn,
     386	    caller: Union[ReverseProxyDB, ServiceDiscoveryDB] = Depends(auth_agent),
     387	    db: Session = Depends(get_db),
     388	):
     389	    rp = db.query(ReverseProxyDB).filter_by(uuid=body.reverse_proxy_uuid).first()
     390	    if not rp:
     391	        raise HTTPException(404, "reverse-proxy not found")
     392	
     393	    if db.query(ServiceDB).filter_by(name=body.service).first():
     394	        raise HTTPException(400, "service already exists")
     395	
     396	    svc = ServiceDB(name=body.service, reverse_proxy_uuid=body.reverse_proxy_uuid)
     397	    db.add(svc)
     398	    db.commit()
     399	    db.refresh(svc)
     400	
     401	    firewall = db.scalar(select(FirewallDB).limit(1))
     402	    if not firewall:
     403	        db.delete(svc)
     404	        db.commit()
     405	        raise HTTPException(400, "No firewall registered yet")
     406	
     407	    try:
     408	        requests.post(
     409	            f"{firewall.api_url.rstrip('/')}/aliases",
     410	            json={
     411	                "service_name": body.service,
     412	                "reverse_proxy_id": body.reverse_proxy_uuid,
     413	            },
     414	            timeout=TIMEOUT,
     415	        ).raise_for_status()
     416	    except Exception as exc:
     417	        db.delete(svc)
     418	        db.commit()
     419	        raise HTTPException(502, f"Failed to register alias on firewall: {exc}")
     420	
     421	    return ServiceOut(id=svc.id)
     422	
     423	@app.delete("/service/{service_id}")
     424	def delete_service(
     425	    service_id: int,
     426	    caller: ReverseProxyDB = Depends(auth_agent),
     427	    db: Session = Depends(get_db),
     428	):
     429	    # Ensure only reverse-proxy agents can delete their own services
     430	    if not isinstance(caller, ReverseProxyDB):
     431	        raise HTTPException(403, "Only reverse-proxy agents can delete services")
     432	
     433	    svc = db.get(ServiceDB, service_id)
     434	    if not svc:
     435	        raise HTTPException(404, "Service not found")
     436	
     437	    if svc.reverse_proxy_uuid != caller.uuid:
     438	        raise HTTPException(403, "Not authorized to delete this service")
     439	
     440	    # Remove service from database
     441	    db.delete(svc)
     442	    db.commit()
     443	
     444	    # Notify firewall-agent to delete the corresponding alias
     445	    try:
     446	        requests.delete(
     447	            f"{caller.api_url.rstrip('/')}/aliases/{svc.name}",
     448	            headers={"Authorization": f"Bearer {caller.token}"},
     449	            timeout=TIMEOUT,
     450	        ).raise_for_status()
     451	    except Exception as exc:
     452	        logging.warning("Failed to notify firewall-agent to delete alias: %s", exc)
     453	
     454	    return {}
